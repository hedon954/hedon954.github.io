"code","code-0",{"className":"$undefined","children":"ep_poll_callback"}]," 将该 FD 对应的 ",["$","code","code-1",{"className":"$undefined","children":"epitem"}]," 引用添加到 ",["$","code","code-2",{"className":"$undefined","children":"eventpoll"}]," 的 ",["$","strong","strong-0",{"children":"就绪链表"}]," 尾部。"]}],"\n",["$","li","li-1",{"children":["同时，唤醒正在 ",["$","code","code-0",{"className":"$undefined","children":"epoll_wait"}]," 中阻塞的进程。"]}],"\n"]}],"\n"]}],"\n",["$","li","li-5",{"children":[["$","strong","strong-0",{"children":"返回用户态"}],":\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":["进程被唤醒，",["$","code","code-0",{"className":"$undefined","children":"epoll_wait"}]," 将就绪链表中的事件复制到用户态内存，函数返回。"]}],"\n"]}],"\n"]}],"\n"]}]
