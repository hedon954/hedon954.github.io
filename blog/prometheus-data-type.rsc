73:["$","$L76",null,{"headings":[{"depth":2,"text":"前言","id":"前言"},{"depth":2,"text":"结论先行：Prometheus 四大数据类型速览","id":"结论先行prometheus-四大数据类型速览"},{"depth":2,"text":"一、Prometheus 核心数据类型详解","id":"一prometheus-核心数据类型详解"},{"depth":3,"text":"1. Counter（计数器）：持续增长的累积值","id":"1-counter计数器持续增长的累积值"},{"depth":3,"text":"2. Gauge（仪表盘）：可变的瞬时值","id":"2-gauge仪表盘可变的瞬时值"},{"depth":3,"text":"3. Histogram（直方图）：观测值分布的分桶统计","id":"3-histogram直方图观测值分布的分桶统计"},{"depth":3,"text":"4. Summary（摘要）：客户端计算的分位数统计","id":"4-summary摘要客户端计算的分位数统计"},{"depth":2,"text":"二、PromQL 查询语言精通","id":"二promql-查询语言精通"},{"depth":3,"text":"1. 基础查询与标签选择","id":"1-基础查询与标签选择"},{"depth":3,"text":"2. 操作符与函数","id":"2-操作符与函数"},{"depth":3,"text":"3. 复杂查询模式","id":"3-复杂查询模式"},{"depth":2,"text":"三、实战应用场景","id":"三实战应用场景"},{"depth":3,"text":"1. 服务健康度监控","id":"1-服务健康度监控"},{"depth":3,"text":"2. 性能瓶颈分析","id":"2-性能瓶颈分析"},{"depth":3,"text":"3. 容量规划与告警","id":"3-容量规划与告警"},{"depth":2,"text":"四、最佳实践与性能优化","id":"四最佳实践与性能优化"},{"depth":3,"text":"1. 指标命名与标签设计","id":"1-指标命名与标签设计"},{"depth":3,"text":"2. 客户端性能优化","id":"2-客户端性能优化"},{"depth":3,"text":"3. 查询优化","id":"3-查询优化"},{"depth":2,"text":"五、常见陷阱与解决方案","id":"五常见陷阱与解决方案"},{"depth":3,"text":"1. 高基数问题","id":"1-高基数问题"},{"depth":3,"text":"2. 数据类型选择误区","id":"2-数据类型选择误区"},{"depth":3,"text":"3. 查询性能问题","id":"3-查询性能问题"},{"depth":2,"text":"总结与展望","id":"总结与展望"}]}]
