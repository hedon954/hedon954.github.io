n":[["$","span","span-0",{"className":"hljs-built_in","children":"export"}]," KAFKA_CLUSTER_ID=XiMRcbJ-QEO694L7sfDdBQ\n"]}]}],"\n"]}],"\n",["$","li","li-3",{"children":["\n",["$","p","p-0",{"children":["备份配置文件，注意这里的配置文件是 ",["$","code","code-0",{"className":"$undefined","children":"config/kraft/server.properties"}],"，在 ",["$","code","code-1",{"className":"$undefined","children":"config"}]," 目录下的 ",["$","code","code-2",{"className":"$undefined","children":"kraft"}]," 目录中："]}],"\n",["$","pre","pre-0",{"data-language":"SH","children":["$","code","code-0",{"className":"hljs language-sh","children":[["$","span","span-0",{"className":"hljs-built_in","children":"cp"}]," /opt/kafka-3.6.0/config/kraft/server.properties /opt/kafka-3.6.0/config/kraft/server.properties.bak\n"]}]}],"\n"]}],"\n",["$","li","li-4",{"children":["\n",["$","p","p-0",{"children":"修改配置"}],"\n",["$","pre","pre-0",{"data-language":"SH","children":["$","code","code-0",{"className":"hljs language-sh","children":"vim /opt/kafka-3.6.0/config/kraft/server.properties\n"}]}],"\n",["$","p","p-1",{"children":"主要修改内容如下："}],"\n",["$","pre","pre-1",{"data-language":"PROPERTIES","children":["$","code","code-0",{"className":"hljs language-properties","children":"# 节点 ID，分别为 1，2，3\nnode.id=1\n# 日志目录\nlog.dirs=/opt/kafka-3.6.0/kafka-combined-logs\n# 可以成为控制器的节点和它们的端口\ncontroller.quorum.voters=1@kafka1.com:9093,2@kafka2.com:9093,3@kafka3.com:9093\n# 定义 Kafka Broker 如何向外部公布它的地址。\n# 这是 Kafka Broker 通知 Producer 和 Consumer 如何连接到自己的方式。\n# 例如，如果你设置 advertised.listeners=PLAINTEXT://my.public.ip:9092，\n# 那么 Kafka Broker 将告诉 Producer 和 Consumer 它的公共 IP 地址是 my.public.ip，并且它在 9092 端口上监听连接。\n# 这里我们需要在 3 个节点分别设置对应的地址\nadvertised.listeners=PLAINTEXT://kafka1.com:9092\n"}]}],"\n"]}],"\n",["$","li","li-5",{"children":["\n",["$","p","p-0",{"children":"格式化日志目录"}],"\n",["$","pre","pre-0",{"data-language":"SH","children":["$","code","code-0",{"className":"hljs language-sh","children":["/opt/kafka-3.6.0/bin/kafka-storage.sh format -t ",["$","span","span-0",{"className":"hljs-variable","children":"$$KAFKA_CLUSTER_ID"}]," -c /opt/kafka-3.6.0/config/kraft/server.properties\n"]}]}],"\n",["$","p","p-1",{"children":"输出："}],"\n",["$","pre","pre-1",{"data-language":"SH","children":["$","code","code-0",{"className":"hljs language-sh","children":"Formatting /opt/kafka-3.6.0/kraft-combined-logs with metadata.version 3.6-IV2.\n"}]}],"\n"]}],"\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n"]}]
