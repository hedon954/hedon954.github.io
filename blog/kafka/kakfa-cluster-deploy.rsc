29:["$","ol","ol-10",{"children":["\n",["$","li","li-0",{"children":["\n",["$","p","p-0",{"children":"下载并解压 Kafka"}],"\n",["$","pre","pre-0",{"data-language":"SH","children":["$","code","code-0",{"className":"hljs language-sh","children":"wget https://archive.apache.org/dist/kafka/2.7.0/kafka_2.13-2.7.0.tgz\ntar -zxvf kafka_2.13-2.7.0.tgz\n"}]}],"\n"]}],"\n",["$","li","li-1",{"children":["\n",["$","p","p-0",{"children":["将解压缩后的文件夹移动到 ",["$","code","code-0",{"className":"$undefined","children":"/opt"}]," 目录中："]}],"\n",["$","pre","pre-0",{"data-language":"SH","children":["$","code","code-0",{"className":"hljs language-sh","children":[["$","span","span-0",{"className":"hljs-built_in","children":"sudo"}]," ",["$","span","span-1",{"className":"hljs-built_in","children":"mv"}]," kafka_2.13-2.7.0 /opt/kafka-2.7.0\n"]}]}],"\n"]}],"\n",["$","li","li-2",{"children":["\n",["$","p","p-0",{"children":"创建日志目录"}],"\n",["$","pre","pre-0",{"data-language":"SH","children":["$","code","code-0",{"className":"hljs language-sh","children":[["$","span","span-0",{"className":"hljs-built_in","children":"sudo"}]," ",["$","span","span-1",{"className":"hljs-built_in","children":"mkdir"}]," /opt/kafka-2.7.0/kafka-logs\n"]}]}],"\n"]}],"\n",["$","li","li-3",{"children":["\n",["$","p","p-0",{"children":"备份 Kafka 默认配置"}],"\n",["$","pre","pre-0",{"data-language":"SH","children":["$","code","code-0",{"className":"hljs language-sh","children":[["$","span","span-0",{"className":"hljs-built_in","children":"sudo"}]," ",["$","span","span-1",{"className":"hljs-built_in","children":"cp"}]," /opt/kafka-2.7.0/config/server.properties /opt/kafka-2.7.0/config/server.properties.bak\n"]}]}],"\n"]}],"\n",["$","li","li-4",{"children":["\n",["$","p","p-0",{"children":"修改 Kafka 配置"}],"\n",["$","pre","pre-0",{"data-language":"SH","children":["$","code","code-0",{"className":"hljs language-sh","children":[["$","span","span-0",{"className":"hljs-built_in","children":"sudo"}]," vim /opt/kafka-2.7.0/config/server.properties\n"]}]}],"\n",["$","p","p-1",{"children":"主要是修改下面几个配置："}],"\n",["$","pre","pre-1",{"data-language":"PROPERTIES","children":["$","code","code-0",{"className":"hljs language-properties","children":"# 集群中每个 broker 的 id 必须唯一，这里分别为 1，2，3\nbroker.id=1\n# 日志目录\nlog.dirs=/opt/kafka-2.7.0/kafka-logs\n# 配置 Zookeeper\nzookeeper.connect=kafka1.com:2181,kafka2.com:2181,kafka3.com:2181\n# 定义 Kafka Broker 在哪些网络地址上监听连接，下面配置表示在所有的 IP 地址上监听 9092 端口\nlisteners=PLAINTEXT://:9092\n# 定义 Kafka Broker 如何向外部公布它的地址。这是 Kafka Broker 通知 Producer 和 Consumer 如何连接到自己的方式。例如，如果你设置 advertised.listeners=PLAINTEXT://my.public.ip:9092，那么 Kafka Broker 将告诉 Producer 和 Consumer 它的公共 IP 地址是 my.public.ip，并且它在 9092 端口上监听连接。\nadvertised.listeners=PLAINTEXT://kafka1.com:9092\n"}]}],"\n"]}],"\n",["$","li","li-5",{"children":["\n",["$","p","p-0",{"children":"三个节点都启动 Kafka"}],"\n",["$","pre","pre-0",{"data-language":"SH","children":["$","code","code-0",{"className":"hljs language-sh","children":"/opt/kafka-2.7.0/bin/kafka-server-start.sh -daemon /opt/kafka-2.7.0/config/server.properties\n"}]}],"\n"]}],"\n",["$","li","li-6",{"children":["\n",["$","p","p-0",{"children":"选择任意一个节点创建一个新 topic"}],"\n",["$","pre","pre-0",{"data-language":"SH","children":["$","code","code-0",{"className":"hljs language-sh","children":["/opt/kafka-2.7.0/bin/kafka-topics.sh --bootstrap-server localhost:9092 --create --topic ",["$","span","span-0",{"className":"hljs-built_in","children":"test"}]," --replication-factor 1 --partitions=2\n"]}]}],"\n",["$","p","p-1",{"children":"输出："}],"\n",["$","pre","pre-1",{"data-language":"SH","children":["$","code","code-0",{"className":"hljs language-sh","children":["Created topic ",["$","span","span-0",{"className":"hljs-built_in","children":"test"}],".\n"]}]}],"\n"]}],"\n",["$","li","li-7",{"children":["\n",["$","p","p-0",{"children":["在其他节点获取 ",["$","code","code-0",{"className":"$undefined","children":"test"}]," 这个 ",["$","code","code-1",{"className":"$undefined","children":"topic"}]," 的信息"]}],"\n",["$","pre","pre-0",{"data-language":"SH","children":["$","code","code-0",{"className":"hljs language-sh","children":["/opt/kafka-2.7.0/bin/kafka-topics.sh --bootstrap-server localhost:9092 --describe --topic ",["$","span","span-0",{"className":"hljs-built_in","children":"test"}],"\n"]}]}],"\n",["$","p","p-1",{"children":["可以看到关于 ",["$","code","code-0",{"className":"$undefined","children":"test"}]," 这个 ","$L34"," 的信息是可以获取到的，说明集群之前信息是互通的，集群搭建完毕。"]}],"\n","$L35","\n"]}],"\n"]}]
