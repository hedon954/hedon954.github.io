1:["$","main",null,{"className":"reading-page post-reading-page","children":["$","article",null,{"className":"post-article h-entry","children":[["$","$L7",null,{"className":"u-url sr-only","href":"/blog/kafka/kafka-ordered-msg","children":["Kafka 顺序消息实现"," 永久链接"]}],["$","a",null,{"className":"p-author h-card sr-only","href":"https://github.com/hedon954","rel":"author","children":"Hedon"}],["$","figure",null,{"className":"article-hero article-cover","children":["$","img",null,{"className":"u-photo","src":"https://hedon.top/hedonspace/banner/kafka-ordered-msg.jpg","alt":"Kafka 顺序消息实现 的文章封面"}]}],["$","header",null,{"className":"article-header article-summary-row","children":[["$","p",null,{"className":"eyebrow","children":"Kafka"}],["$","h1",null,{"className":"p-name","children":"Kafka 顺序消息实现"}],["$","p",null,{"className":"article-deck p-summary","children":"本文详细介绍了如何实现 Kafka 的顺序消息，同时给出了消息队列顺序消息的通用实现思路，并简单介绍了 RabbitMQ、RocketMQ 和 Pulsar 在顺序消息方面的实现思路。"}],["$","div",null,{"className":"article-meta","children":[["$","time",null,{"className":"dt-published","dateTime":"2023-11-23T23:42:34.000Z","children":["发布于 ","2023/11/23"]}],"$undefined",["$","span",null,{"children":"$undefined"}],["$","span",null,{"children":["约 ","5,146"," 字"]}]]}]]}],["$","div",null,{"className":"article-reading-layout","children":[["$","div",null,{"className":"article-reading-column","children":[["$","div",null,{"className":"e-content","children":["$","div",null,{"className":"markdown-body","children":[["$","h2","h2-0",{"id":"版本说明","children":["$","a","a-0",{"href":"#版本说明","node":{"type":"element","tagName":"a","properties":{"href":"#版本说明"},"children":[{"type":"text","value":"版本说明","position":{"start":{"line":1,"column":4,"offset":3},"end":{"line":1,"column":8,"offset":7}}}]},"children":"版本说明"}]}],"\n",["$","p","p-0",{"children":"本文所有的讨论均在如下版本进行，其他版本可能会有所不同。"}],"\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":"Kafka: 3.6.0"}],"\n",["$","li","li-1",{"children":"Pulsar: 2.9.0"}],"\n",["$","li","li-2",{"children":"RabbitMQ 3.7.8"}],"\n",["$","li","li-3",{"children":"RocketMQ 5.0"}],"\n",["$","li","li-4",{"children":"Go1.21"}],"\n",["$","li","li-5",{"children":"github.com/segmentio/kafka-go v0.4.45"}],"\n"]}],"\n",["$","h2","h2-1",{"id":"结论先行","children":["$","a","a-0",{"href":"#结论先行","node":{"type":"element","tagName":"a","properties":{"href":"#结论先行"},"children":[{"type":"text","value":"结论先行","position":{"start":{"line":12,"column":4,"offset":155},"end":{"line":12,"column":8,"offset":159}}}]},"children":"结论先行"}]}],"\n",["$","p","p-1",{"children":"Kafka 只能保证单一分区内的顺序消息，无法保证多分区间的顺序消息。具体来说，要在 Kafka 完全实现顺序消息，至少需要保证以下几个条件："}],"\n",["$","ol","ol-0",{"children":["\n",["$","li","li-0",{"children":"同一生产者生产消息；"}],"\n",["$","li","li-1",{"children":"同步发送消息到 Kafka broker；"}],"\n",["$","li","li-2",{"children":"所有消息发布到同一个分区；"}],"\n",["$","li","li-3",{"children":"同一消费者同步按照顺序消费消息。"}],"\n"]}],"\n",["$","p","p-2",{"children":"而要满足第 3 点，常用的有 2 种思路："}],"\n",["$","ol","ol-1",{"children":["\n",["$","li","li-0",{"children":["固定消息的 key，生产端采用 ",["$","code","code-0",{"className":"$undefined","children":"key hash"}]," 的方式写入 broker；"]}],"\n",["$","li","li-1",{"children":"自定义分区策略，要保证顺序的消息都写入到指定的分区。"}],"\n"]}],"\n",["$","h2","h2-2",{"id":"消息队列中的顺序消息如何实现","children":["$","a","a-0",{"href":"#消息队列中的顺序消息如何实现","node":{"type":"element","tagName":"a","properties":{"href":"#消息队列中的顺序消息如何实现"},"children":[{"type":"text","value":"消息队列中的顺序消息如何实现","position":{"start":{"line":26,"column":4,"offset":412},"end":{"line":26,"column":18,"offset":426}}}]},"children":"消息队列中的顺序消息如何实现"}]}],"\n",["$","h3","h3-0",{"id":"顺序消息定义","children":["$","a","a-0",{"href":"#顺序消息定义","node":{"type":"element","tagName":"a","properties":{"href":"#顺序消息定义"},"children":[{"type":"text","value":"顺序消息定义","position":{"start":{"line":28,"column":5,"offset":432},"end":{"line":28,"column":11,"offset":438}}}]},"children":"顺序消息定义"}]}],"\n",["$","p","p-3",{"children":"生产端发送出来的消息的顺序和消费端接收到消息的顺序是一样的。"}],"\n",["$","h3","h3-1",{"id":"消息存储结构","children":["$","a","a-0",{"href":"#消息存储结构","node":{"type":"element","tagName":"a","properties":{"href":"#消息存储结构"},"children":[{"type":"text","value":"消息存储结构","position":{"start":{"line":32,"column":5,"offset":476},"end":{"line":32,"column":11,"offset":482}}}]},"children":"消息存储结构"}]}],"\n",["$","p","p-4",{"children":["一般来说，消息队列都是基于",["$","strong","strong-0",{"children":"顺序存储结构"}],"来存储数据的，不需要 B 树、B+ 树等复杂数据结构，利用文件的顺序读写，性能也很高。所以理想情况下，生产者按顺序发送消息，broker 会按顺序存储消息，消费者再按顺序消费消息，那么天然就实现了我们要的",["$","strong","strong-1",{"children":"顺序消息"}],"了，如下："]}],"\n",["$","p","p-5",{"children":["$","$L8","img-0",{"src":"https://hedonspace.oss-cn-beijing.aliyuncs.com/img/image-20231124235214392.png","alt":"消息队列顺序存储结构","node":{"type":"element","tagName":"img","properties":{"src":"https://hedonspace.oss-cn-beijing.aliyuncs.com/img/image-20231124235214392.png","alt":"消息队列顺序存储结构"},"children":[],"position":{"start":{"line":36,"column":1,"offset":624},"end":{"line":36,"column":94,"offset":717}}}}]}],"\n","$L9","\n","$La","\n","$Lb","\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c","\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27","\n","$L28","\n","$L29","\n","$L2a","\n","$L2b","\n","$L2c","\n","$L2d","\n","$L2e","\n","$L2f","\n","$L30","\n","$L31","\n","$L32","\n","$L33","\n","$L34","\n","$L35","\n","$L36","\n","$L37","\n","$L38","\n","$L39","\n","$L3a","\n","$L3b","\n","$L3c","\n","$L3d","\n","$L3e","\n","$L3f","\n","$L40","\n","$L41","\n","$L42","\n","$L43","\n","$L44","\n","$L45","\n","$L46","\n","$L47","\n","$L48","\n","$L49","\n","$L4a","\n","$L4b","\n","$L4c","\n","$L4d","\n","$L4e","\n","$L4f","\n","$L50","\n","$L51","\n","$L52","\n","$L53","\n","$L54","\n","$L55","\n","$L56","\n","$L57","\n","$L58","\n","$L59","\n","$L5a","\n","$L5b"]}]}],"$L5c","$L5d","$L5e"]}],"$L5f"]}]]}]}]
