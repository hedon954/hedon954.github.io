124:["$","pre","pre-36",{"data-language":"C","children":["$","code","code-0",{"className":"hljs language-c","children":[["$","span","span-0",{"className":"hljs-comment","children":"/* Consumer group. */"}],"\n",["$","span","span-1",{"className":"hljs-keyword","children":"typedef"}]," ",["$","span","span-2",{"className":"hljs-class","children":[["$","span","span-0",{"className":"hljs-keyword","children":"struct"}]," ",["$","span","span-1",{"className":"hljs-title","children":"streamCG"}]," {"]}],"\n    streamID last_id;       ",["$","span","span-3",{"className":"hljs-comment","children":"/* 该消费组最后一次交付（但未确认）的消息 ID。\n                               当消费者请求“新消息”时，Redis 会提供大于此 ID 的消息。 */"}],"\n\n    ",["$","span","span-4",{"className":"hljs-type","children":"long"}]," ",["$","span","span-5",{"className":"hljs-type","children":"long"}]," entries_read; ",["$","span","span-6",{"className":"hljs-comment","children":"/* 统计信息：该组读取的消息总数 */"}],"\n\n    rax *pel;               ",["$","span","span-7",{"className":"hljs-comment","children":"/* Pending Entries List (待处理列表)。\n                               这是一个 Radix Tree。\n                               Key: 消息 ID (64位大端序)\n                               Value: streamNACK 结构 (记录了投递次数、最后投递时间等)\n                               作用: 记录所有已发给消费者但尚未 ACK 的消息。 */"}],"\n\n    rax *pel_by_time;       ",["$","span","span-8",{"className":"hljs-comment","children":"/* 辅助索引：按“投递时间”排序的 PEL。\n                               Key: pelTimeKey (包含 delivery_time + stream ID)\n                               Value: NULL (所有信息都在 Key 里)\n                               作用: 加速超时消息的查询 (如 XPENDING ... IDLE <time>)。 */"}],"\n\n    rax *consumers;         ",["$","span","span-9",{"className":"hljs-comment","children":"/* 消费者字典。\n                               Key: 消费者名称\n                               Value: streamConsumer 结构 */"}],"\n} streamCG;\n"]}]}]
