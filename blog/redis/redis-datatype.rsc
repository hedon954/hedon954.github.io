d1:["$","pre","pre-26",{"data-language":"BASH","children":["$","code","code-0",{"className":"hljs language-bash","children":[["$","span","span-0",{"className":"hljs-comment","children":"# 基础操作"}],"\nGEOADD key longitude latitude member [longitude latitude member ...]  ",["$","span","span-1",{"className":"hljs-comment","children":"# 添加地理位置"}],"\nGEOPOS key member1 member2 ...     ",["$","span","span-2",{"className":"hljs-comment","children":"# 获取指定位置的坐标"}],"\nGEODIST key member1 member2 [unit]  ",["$","span","span-3",{"className":"hljs-comment","children":"# 计算两个位置之间的距离"}],"\n\n",["$","span","span-4",{"className":"hljs-comment","children":"# 单位参数：m(米)、km(千米)、mi(英里)、ft(英尺)"}],"\nGEODIST cities beijing shanghai km  ",["$","span","span-5",{"className":"hljs-comment","children":"# 计算北京到上海的公里距离"}],"\n\n",["$","span","span-6",{"className":"hljs-comment","children":"# 范围查询（重要）"}],"\nGEORADIUS key longitude latitude radius m|km|ft|mi [WITHCOORD] [WITHDIST] [WITHHASH] [COUNT count] [ASC|DESC] [STORE key] [STOREDIST key]\nGEORADIUSBYMEMBER key member radius m|km|ft|mi [WITHCOORD] [WITHDIST] [WITHHASH] [COUNT count] [ASC|DESC] [STORE key] [STOREDIST key]\n\n",["$","span","span-7",{"className":"hljs-comment","children":"# 查询选项说明："}],"\n",["$","span","span-8",{"className":"hljs-comment","children":"# WITHCOORD: 返回坐标"}],"\n",["$","span","span-9",{"className":"hljs-comment","children":"# WITHDIST: 返回距离"}],"\n",["$","span","span-10",{"className":"hljs-comment","children":"# WITHHASH: 返回geohash值"}],"\n",["$","span","span-11",{"className":"hljs-comment","children":"# COUNT: 限制返回数量"}],"\n",["$","span","span-12",{"className":"hljs-comment","children":"# ASC|DESC: 按距离排序"}],"\n",["$","span","span-13",{"className":"hljs-comment","children":"# STORE: 存储结果到有序集合"}],"\n",["$","span","span-14",{"className":"hljs-comment","children":"# STOREDIST: 存储距离到有序集合"}],"\n\n",["$","span","span-15",{"className":"hljs-comment","children":"# 搜索示例"}],"\nGEORADIUS restaurants 116.397128 39.916527 5 km WITHDIST WITHCOORD COUNT 10\nGEORADIUSBYMEMBER restaurants starbucks 2 km WITHDIST\n\n",["$","span","span-16",{"className":"hljs-comment","children":"# 哈希操作"}],"\nGEOHASH key member1 member2 ...  ",["$","span","span-17",{"className":"hljs-comment","children":"# 获取位置的 geohash 字符串"}],"\n\n",["$","span","span-18",{"className":"hljs-comment","children":"# 有序集合操作（底层是zset）"}],"\nZSCORE key member               ",["$","span","span-19",{"className":"hljs-comment","children":"# 获取位置的geohash分数"}],"\nZRANGE key start stop WITHSCORES  ",["$","span","span-20",{"className":"hljs-comment","children":"# 获取范围位置和分数"}],"\nZREM key member1 member2         ",["$","span","span-21",{"className":"hljs-comment","children":"# 删除位置"}],"\nZCARD key                       ",["$","span","span-22",{"className":"hljs-comment","children":"# 获取位置数量"}],"\n\n",["$","span","span-23",{"className":"hljs-comment","children":"# 批量操作（Redis 6.2+）"}],"\nGEOSEARCH key [FROMMEMBER member | FROMLONLAT longitude latitude] [BYRADIUS radius m|km|ft|mi | BYBOX width height m|km|ft|mi] [WITHCOORD] [WITHDIST] [WITHHASH] [COUNT count] [ASC|DESC]\n"]}]}]
