"\nXINFO [STREAM key] [FULL]                              ",["$","span","span-16",{"className":"hljs-comment","children":"# 查看流详细信息"}],"\n\n",["$","span","span-17",{"className":"hljs-comment","children":"# 消费者读取"}],"\nXREADGROUP GROUP group consumer [COUNT count] [BLOCK milliseconds] [NOACK] STREAMS key1 key2 ... ID1 ID2 ...\n",["$","span","span-18",{"className":"hljs-comment","children":"# ID选项：>（新消息）、0（所有未处理消息）、具体ID"}],"\n\n",["$","span","span-19",{"className":"hljs-comment","children":"# 消息确认"}],"\nXACK key group ID [ID ...]                            ",["$","span","span-20",{"className":"hljs-comment","children":"# 确认消息已处理"}],"\nXPENDING key group [start end count consumer]         ",["$","span","span-21",{"className":"hljs-comment","children":"# 查看待处理消息"}],"\nXCLAIM key group consumer min_idle_time ID [ID ...] [IDLE ms] [TIME ms] [RETRYCOUNT count] [FORCE] [JUSTID] [LASTID ",["$","span","span-22",{"className":"hljs-built_in","children":"id"}],"]\nXDEL key ID [ID ...]                                  ",["$","span","span-23",{"className":"hljs-comment","children":"# 删除消息"}],"\n\n",["$","span","span-24",{"className":"hljs-comment","children":"# 修剪操作"}],"\nXTRIM key MAXLEN len [~]                              ",["$","span","span-25",{"className":"hljs-comment","children":"# 修剪流到指定长度"}],"\nXTRIM key MINID threshold [~]                         ",["$","span","span-26",{"className":"hljs-comment","children":"# 删除小于指定ID的消息"}],"\n\n",["$","span","span-27",{"className":"hljs-comment","children":"# 实用示例"}],"\n",["$","span","span-28",{"className":"hljs-comment","children":"# 创建流并添加消息"}],"\nXADD mystream * name ",["$","span","span-29",{"className":"hljs-string","children":"\"张三\""}]," age 25\nXADD mystream * name ",["$","span","span-30",{"className":"hljs-string","children":"\"李四\""}]," age 30\n\n",["$","span","span-31",{"className":"hljs-comment","children":"# 读取消息"}],"\nXREAD COUNT 2 STREAMS mystream 0-0\n\n",["$","span","span-32",{"className":"hljs-comment","children":"# 