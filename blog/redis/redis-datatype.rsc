10c:["$","blockquote","blockquote-9",{"children":["\n",["$","p","p-0",{"children":"这并非标准的 Radix Tree 的实现，标准的 Radix Tree 一个节点只有一个字符，当然这对于 Stream 这个场景依旧是极大的浪费，所以一个改进方案就是将多个相同前缀的字符合并在一个作为一个共享节点。"}],"\n",["$","p","p-1",{"children":["事实上 Go 的 Gin 框架的路由树也是采取的这种策略，具体可参考：",["$","a","a-0",{"href":"https://hedon.top/2025/06/30/go/go-gin/","node":{"type":"element","tagName":"a","properties":{"href":"https://hedon.top/2025/06/30/go/go-gin/"},"children":[{"type":"text","value":"Go 底层原理丨深度剖析 Gin 框架核心机制：从 HTTP 请求生命周期到高性能设计哲学","position":{"start":{"line":1497,"column":39,"offset":52540},"end":{"line":1497,"column":84,"offset":52585}}}],"position":{"start":{"line":1497,"column":38,"offset":52539},"end":{"line":1497,"column":126,"offset":52627}}},"target":"_blank","rel":"noopener noreferrer","children":"Go 底层原理丨深度剖析 Gin 框架核心机制：从 HTTP 请求生命周期到高性能设计哲学"}],"。"]}],"\n"]}]
