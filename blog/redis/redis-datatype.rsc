eb:["$","pre","pre-29",{"data-language":"C","children":["$","code","code-0",{"className":"hljs language-c","children":[["$","span","span-0",{"className":"hljs-comment","children":"/* src/server.h */"}],"\n",["$","span","span-1",{"className":"hljs-class","children":[["$","span","span-0",{"className":"hljs-keyword","children":"struct"}]," ",["$","span","span-1",{"className":"hljs-title","children":"redisServer"}]," {"]}],"\n  kvstore *pubsub_channels;  ",["$","span","span-2",{"className":"hljs-comment","children":"/* Map channels to list of subscribed clients */"}],"\n  dict *pubsub_patterns;  ",["$","span","span-3",{"className":"hljs-comment","children":"/* A dict of pubsub_patterns */"}],"\n  ",["$","span","span-4",{"className":"hljs-type","children":"int"}]," notify_keyspace_events; ",["$","span","span-5",{"className":"hljs-comment","children":"/* Events to propagate via Pub/Sub. This is an\n                                 xor of NOTIFY_... flags. */"}],"\n  kvstore *pubsubshard_channels;  ",["$","span","span-6",{"className":"hljs-comment","children":"/* Map shard channels in every slot to list of subscribed clients */"}],"\n  ",["$","span","span-7",{"className":"hljs-type","children":"unsigned"}]," ",["$","span","span-8",{"className":"hljs-type","children":"int"}]," pubsub_clients; ",["$","span","span-9",{"className":"hljs-comment","children":"/* # of clients in Pub/Sub mode */"}],"\n}\n"]}]}]
