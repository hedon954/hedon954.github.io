64:["$","ol","ol-0",{"children":["\n",["$","li","li-0",{"children":["发送方调用 ",["$","code","code-0",{"className":"$undefined","children":"ikcp_send"}]," 将发送数据，这个时候会创建报文段实例，并放入 ",["$","code","code-1",{"className":"$undefined","children":"snd_queue"}]," 发送队列中。"]}],"\n",["$","li","li-1",{"children":["KCP 会定时调用 ",["$","code","code-0",{"className":"$undefined","children":"ikcp_update"}]," 判断是否要调用 ",["$","code","code-1",{"className":"$undefined","children":"ikcp_flush"}],"。"]}],"\n",["$","li","li-2",{"children":["调用 ",["$","code","code-0",{"className":"$undefined","children":"ikcp_flush"}]," 时会将合适的报文段放入 ",["$","code","code-1",{"className":"$undefined","children":"snd_buf"}]," 缓冲区中，具体包括：\n",["$","ol","ol-0",{"children":["\n",["$","li","li-0",{"children":"发送 ACK 列表中所有 ACK；"}],"\n",["$","li","li-1",{"children":"根据是否需要发送窗口探测和通知报文，需要则发；"}],"\n",["$","li","li-2",{"children":["根据发送窗口大小，将适量的报文段从 ",["$","code","code-0",{"className":"$undefined","children":"snd_queue"}]," 移入 ",["$","code","code-1",{"className":"$undefined","children":"snd_buf"}]," 中；"]}],"\n",["$","li","li-3",{"children":["发送 ",["$","code","code-0",{"className":"$undefined","children":"snd_buf"}]," 中的报文，包括",["$","strong","strong-0",{"children":"新加入的"}],"、",["$","strong","strong-1",{"children":"RTO 内未收到 ACK"}]," 的和",["$","strong","strong-2",{"children":"ACK 失序若干次"}],"的；"]}],"\n",["$","li","li-4",{"children":["根据丢包情况计算 ",["$","code","code-0",{"className":"$undefined","children":"ssthresh"}]," 和 ",["$","code","code-1",{"className":"$undefined","children":"cwnd"}],"。"]}],"\n"]}],"\n"]}],"\n",["$","li","li-3",{"children":["发送的时候会调用由 ",["$","code","code-0",{"className":"$undefined","children":"ikcp_setoutput"}]," 设置的回调函数，将数据发送到对端。"]}],"\n",["$","li","li-4",{"children":["接收方收到数据后，会调用 ",["$","code","code-0",{"className":"$undefined","children":"ikcp_input"}],"，将数据放入 ",["$","code","code-1",{"className":"$undefined","children":"rcv_buf"}]," 缓冲区，具体包括：\n",["$","ol","ol-0",{"children":["\n",["$","li","li-0",{"children":"根据所有报文的 una 将相应的报文标记为已送达；"}],"\n",["$","li","li-1",{"children":"如果是 ACK，就将相应的报文标记为已送达；"}],"\n",["$","li","li-2",{"children":["如果是数据报文，就将它放入 ",["$","code","code-0",{"className":"$undefined","children":"rcv_buf"}],"，然后将 ",["$","code","code-1",{"className":"$undefined","children":"rcv_buf"}]," 中顺序正确的报文移入 ",["$","code","code-2",{"className":"$undefined","children":"rcv_queue"}]," 接收队列中，接着将相关信息插入 ACK 列表，在稍后的 ",["$","code","code-3",{"className":"$undefined","children":"ikcp_flush"}]," 中会发送相应的 ACK；"]}],"\n",["$","li","li-3",{"children":["如果是窗口探测报文，就标记“需要发送窗口通知”，在稍后的 ",["$","code","code-0",{"className":"$undefined","children":"ikcp_flush"}]," 中会发送窗口通知报文；"]}],"\n",["$","li","li-4",{"children":"包括窗口通知报文在内的所有报文都有 wnd 字段，据此更新 rmt_wnd；"}],"\n",["$","li","li-5",{"children":"根据 ACK 失序情况决定是否进行快速重传；"}],"\n",["$","li","li-6",{"children":"计算 cwnd。"}],"\n"]}],"\n"]}],"\n",["$","li","li-5",{"children":["调用 ",["$","code","code-0",{"className":"$undefined","children":"ikcp_recv"}]," 从 ",["$","code","code-1",{"className":"$undefined","children":"rcv_queue"}]," 中接收数据。"]}],"\n"]}]
