6b:["$","ol","ol-1",{"children":["\n",["$","li","li-0",{"children":[["$","code","code-0",{"className":"$undefined","children":"ikcp_flush"}]," 时，会从 ",["$","code","code-1",{"className":"$undefined","children":"snd_queue"}]," 中取出报文插入到 ",["$","code","code-2",{"className":"$undefined","children":"snd_nxt"}]," 的位置上；"]}],"\n",["$","li","li-1",{"children":["如果 ",["$","code","code-0",{"className":"$undefined","children":"snd_nxt - snd_una >= cwnd"}],"，则不允许新的报文插入；"]}],"\n",["$","li","li-2",{"children":["当 ",["$","code","code-0",{"className":"$undefined","children":"snd_una"}]," 的 ACK 报文到达时，",["$","code","code-1",{"className":"$undefined","children":"snd_una"}]," 就会右移到第一个没有收到 ACK 报文的位置；"]}],"\n"]}]
