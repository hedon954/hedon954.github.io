":"#版本"},"children":[{"type":"text","value":"版本","position":{"start":{"line":3,"column":4,"offset":183},"end":{"line":3,"column":6,"offset":185}}}]},"children":"版本"}]}],"\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":[["$","code","code-0",{"className":"$undefined","children":"chrono"}],": 0.4.38"]}],"\n"]}],"\n",["$","h2","h2-1",{"id":"结论先行","children":["$","a","a-0",{"href":"#结论先行","node":{"type":"element","tagName":"a","properties":{"href":"#结论先行"},"children":[{"type":"text","value":"结论先行","position":{"start":{"line":7,"column":4,"offset":210},"end":{"line":7,"column":8,"offset":214}}}]},"children":"结论先行"}]}],"\n",["$","p","p-1",{"children":["$","$L8","img-0",{"src":"https://hedonspace.oss-cn-beijing.aliyuncs.com/img/image-20240512010241356.png","alt":"chrono 各种时间类型转换图","node":{"type":"element","tagName":"img","properties":{"src":"https://hedonspace.oss-cn-beijing.aliyuncs.com/img/image-20240512010241356.png","alt":"chrono 各种时间类型转换图"},"children":[],"position":{"start":{"line":9,"column":1,"offset":216},"end":{"line":9,"column":100,"offset":315}}}}]}],"\n",["$","h2","h2-2",{"id":"时间相关概念","children":["$","a","a-0",{"href":"#时间相关概念","node":{"type":"element","tagName":"a","properties":{"href":"#时间相关概念"},"children":[{"type":"text","value":"时间相关概念","position":{"start":{"line":11,"column":4,"offset":320},"end":{"line":11,"column":10,"offset":326}}}]},"children":"时间相关概念"}]}],"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",["$","table","table-0",{"children":[["$","thead","thead-0",{"children":["$","tr","tr-0",{"children":[["$","th","th-0",{"children":"概念"}],["$","th","th-1",{"children":"理解"}]]}]}],["$","tbody","tbody-0",{"children":[["$","tr","tr-0",{"children":[["$","td","td-0",{"children":"UNIX 时间戳（UNIX Timestamp）"}],["$","td","td-1",{"children":"也称为 POSIX 时间或 Epoch 时间，是自 1970 年 1 月 1 日（UTC 时区）以来经过的秒数，不计入闰秒。这是一种非常通用的时间表示方法，在编程中广泛使用，因为它可以简化时间差的计算。"}]]}],["$","tr","tr-1",{"children":[["$","td","td-0",{"children":"UTC（协调世界时）"}],["$","td","td-1",{"children":"全称为协调世界时（Coordinated Universal Time），是目前国际上广泛采用的时间标准。它基本上与格林威治平均时（GMT）相同，但在技术上更加精确，因为它使用原子钟来保持时间准确。世界各地的时间都是以 UTC 为基础，加上或减去一定的小时数来定义的。"}]]}],["$","tr","tr-2",{"children":[["$","td","td-0",{"children":"时区（Time Zone）"}],["$","td","td-1",{"children":"时区是地球上划分的标准时间区域。由于地球自西向东旋转，每向东移动一定角度，当地的太阳时间就会相应地提前。世界被分成了 24 个时区，每个时区通常相差一小时。时区允许地区内的人们能在大致相同的时间内，经历类似的日夜更替模式。"}]]}],["$","tr","tr-3",{"children":[["$","td","td-0",{"children":"UTC+8"}],["$","td","td-1",{"children":"UTC+8 是 UTC 时间加上 8 小时的时间区。中国大陆就是位于这个时区。例如，当 UTC 时间为 00:00 时，UTC+8 的时间就是 08:00。"}]]}]]}]]}],"\n",["$","h2","h2-3",{"id":"chrono-关键类型","children":["$","a","a-0",{"href":"#chrono-关键类型","node":{"type":"element","tagName":"a","properties":{"href":"#chrono-关键类型"},"children":[{"type":"text","value":"chrono 关键类型","position":{"start":{"line":20,"column":4,"offset":1620},"end":{"line":20,"column":15,"offset":1631}}}]},"children":"chrono 关键类型"}]}],"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n","$L9","\n","$La","\n","$Lb","\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c","\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27","\n","$L28"]}]}],"$L29","$L2a","$L2b"]}],"$L2c"]}]]}]}]
