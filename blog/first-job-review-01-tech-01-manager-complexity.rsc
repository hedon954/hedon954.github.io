1c7:["$","p","p-251",{"children":["AI 系统的依赖变得极其复杂。它不再只是代码依赖，还包括",["$","strong","strong-0",{"children":"数据依赖"}],"、",["$","strong","strong-1",{"children":"模型依赖"}],"、",["$","strong","strong-2",{"children":"环境依赖"}],"。"]}]
