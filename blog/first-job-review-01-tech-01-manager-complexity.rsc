186:["$","p","p-208",{"children":["$","strong","strong-0",{"children":"1. 它是分布式系统的交互可视化工具"}]}]
187:["$","p","p-209",{"children":["在模块化的架构中，系统是一个分布式黑盒。任何一个请求都可能跨越几十个模块（服务）。单个模块（已通过单元测试）是正确的，但它们组合运行时的交互可能导致",["$","strong","strong-0",{"children":"性能瓶颈"}],"、",["$","strong","strong-1",{"children":"级联失败"}],"或",["$","strong","strong-2",{"children":"数据不一致"}],"。"]}]
188:["$","p","p-210",{"children":[["$","strong","strong-0",{"children":"分布式追踪 (Tracing)"}]," 提供了请求级的可视化。它能精确地描绘出一个请求从 ",["$","code","code-0",{"className":"$undefined","children":"Service-A"}]," 到 ",["$","code","code-1",{"className":"$undefined","children":"Service-B"}]," 再到 ",["$","code","code-2",{"className":"$undefined","children":"Service-C"}]," 的实际路径和耗时分布。它将黑盒的动态交互复杂度，降维为一张清晰的瀑布图或依赖拓扑图，使工程师能",["$","strong","strong-1",{"children":"定位"}],"涌现出的性能瓶颈或错误路径。"]}]
