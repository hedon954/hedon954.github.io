181:["$","table","table-0",{"children":[["$","thead","thead-0",{"children":["$","tr","tr-0",{"children":[["$","th","th-0",{"children":"组件"}],["$","th","th-1",{"children":"核心"}],["$","th","th-2",{"children":"说明"}]]}]}],["$","tbody","tbody-0",{"children":[["$","tr","tr-0",{"children":[["$","td","td-0",{"children":"metrics"}],["$","td","td-1",{"children":"帮助你判断是否有问题"}],["$","td","td-2",{"children":"统计埋点，包括系统监控、服务监控、业务监控。"}]]}],["$","tr","tr-1",{"children":[["$","td","td-0",{"children":"trace"}],["$","td","td-1",{"children":"告诉你问题在哪里"}],["$","td","td-2",{"children":"实现链路追踪，展示系统拓扑图，梳理服务调用链路，洞察性能瓶颈点。"}]]}],["$","tr","tr-2",{"children":[["$","td","td-0",{"children":"logs"}],["$","td","td-1",{"children":"帮助你定位到问题根源"}],["$","td","td-2",{"children":"制定日志规范，将规范灌输到日常开发的认知习惯中，尝试将部分规范集成到日志组件中，打更有意义的日志， 提高问题排查效率。"}]]}]]}]]}]
