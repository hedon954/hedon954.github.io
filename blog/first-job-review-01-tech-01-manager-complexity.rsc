","children":"2"}]}]]}]}]}]}]}]]}]]}]}]]}]," 复杂度的雏形。"]}],"\n"]}],"\n"]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"治 (Conquer)："}]," 我们将这个大问题分解。\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":[["$","code","code-0",{"className":"$undefined","children":"PayrollCalculator"}]," （只因 A 而变）"]}],"\n",["$","li","li-1",{"children":[["$","code","code-0",{"className":"$undefined","children":"EmployeeRepository"}]," （只因 B 而变）"]}],"\n",["$","li","li-2",{"children":[["$","code","code-0",{"className":"$undefined","children":"EmployeeReporter"}]," （只因 C 而变）"]}],"\n"]}],"\n"]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"合 (Combine)："}]," 通过清晰的接口将它们组合起来，完成完整的业务。"]}],"\n"]}]
