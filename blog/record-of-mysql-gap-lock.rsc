SERT"}]," 语句（目标 ",["$","code","code-1",{"className":"$undefined","children":"id=664"}],"）被长时间阻塞，最后在 Go 应用层报错 ",["$","code","code-2",{"className":"$undefined","children":"invalid connection"}],"。"]}],"\n",["$","pre","pre-0",{"data-language":"SQL","children":["$","code","code-0",{"className":"hljs language-sql","children":[["$","span","span-0",{"className":"hljs-keyword","children":"INSERT INTO"}]," `chip_info`(`info`,`display_order`,`id`)\n",["$","span","span-1",{"className":"hljs-keyword","children":"VALUES"}]," (",["$","span","span-2",{"className":"hljs-string","children":"'{...}'"}],", ",["$","span","span-3",{"className":"hljs-number","children":"519"}],", ",["$","span","span-4",{"className":"hljs-number","children":"664"}],")\n",["$","span","span-5",{"className":"hljs-keyword","children":"ON"}]," DUPLICATE KEY ",["$","span","span-6",{"className":"hljs-keyword","children":"UPDATE"}]," `info`",["$","span","span-7",{"className":"hljs-operator","children":"="}],["$","span","span-8",{"className":"hljs-keyword","children":"VALUES"}],"(`info`), `display_order`",["$","span","span-9",{"className":"hljs-operator","children":"="}],["$","span","span-10",{"className":"hljs-keyword","children":"VALUES"}],"(`display_order`);\n"]}]}],"\n",["$","p","p-1",{"children":"最终排查定位，阻塞的根源是 MySQL 的 Gap 锁（间隙锁）。通过终止持有该锁的悬挂事务，操作立即恢复正常。"}],"\n",["$","h2","h2-1",{"id":"gap-锁与-next-key-锁的定义","children":["$","a","a-0",{"href":"#gap-锁与-next-key-锁的定义","node":{"type":"element","tagName":"a","properties":{"href":"#gap-锁与-next-key-锁的定义"},"children":[{"type":"text","value":"Gap 锁与 Next-Key 锁的定义","position":{"start":{"line":13,"column":4,"offset":330},"end":{"line":13,"column":24,"offset":350}}}]},"children":"Gap 锁与 Next-Key 锁的定义"}]}],"\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"Gap 锁 (Gap Lock)"}],"：这是一种锁机制，它锁定的不是具体的某一行记录，而是索引记录之间的\"间隙\"。其唯一目的是防止其他事务在这个间隙中执行 ",["$","code","code-0",{"className":"$undefined","children":"INSERT"}]," 操作。"]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"Next-Key 锁 (Next-Key Lock)"}],"：这是 InnoDB 在 ",["$","code","code-0",{"className":"$undefined","children":"REPEATABLE READ"}]," 隔离级别下的默认锁策略。它本质上是",["$","strong","strong-1",{"children":"行锁 (Record Lock)"}]," 与该行记录之前",["$","strong","strong-2",{"children":"间隙的 Gap 锁"}],"的组合。Next-Key 锁是解决幻读问题的核心机制。"]}],"\n"]}],"\n",["$","h2","h2-2",{"id":"第一性原理为什么需要-gap-锁","children":["$","a","a-0",{"href":"#第一性原理为什么需要-gap-锁","node":{"type":"element","tagName":"a","properties":{"href":"#第一性原理为什么需要-gap-锁"},"children":[{"type":"text","value":"第一性原理：为什么需要 Gap 锁？","position":{"start":{"line":18,"column":4,"offset":599},"end":{"line":18,"column":22,"offset":617}}}]},"children":"第一性原理：为什么需要 Gap 锁？"}]}],"\n","$L8","\n","$L9","\n","$La","\n","$Lb","\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c","\n","$L1d","\n","$L1e"]}]}],"$L1f","$L20","$L21"]}],"$L22"]}]]}]}]
