68:["$","ol","ol-15",{"children":["\n",["$","li","li-0",{"children":"大模型打分：通过 LLM 对 RAG 的输出进行自动评分。效率高，但是准确性一般。"}],"\n",["$","li","li-1",{"children":"人工打分：手工针对 RAG 的输出进行逐一打分。更精确、细致的反馈，成本高。"}],"\n"]}]
