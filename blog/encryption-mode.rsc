13:["$","h3","h3-3",{"id":"总结与展望","children":["$","a","a-0",{"href":"#总结与展望","node":{"type":"element","tagName":"a","properties":{"href":"#总结与展望"},"children":[{"type":"text","value":"总结与展望","position":{"start":{"line":59,"column":5,"offset":1422},"end":{"line":59,"column":10,"offset":1427}}}]},"children":"总结与展望"}]}]
14:["$","p","p-15",{"children":"从 ECB 的简单但危险，到 CBC 的安全但串行，再到 GCM 的安全、高性能和认证，我们可以清晰地看到加密模式的演进。"}]
