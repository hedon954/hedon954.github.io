c2:["$","pre","pre-23",{"data-language":"PYTHON","children":["$","code","code-0",{"className":"hljs language-python","children":[["$","span","span-0",{"className":"hljs-comment","children":"# diagonal=1 表示不包含主对角线，只包含上三角部分"}],"\nmask = torch.triu(torch.ones(context_length, context_length), diagonal=",["$","span","span-1",{"className":"hljs-number","children":"1"}],")\n",["$","span","span-2",{"className":"hljs-built_in","children":"print"}],"(mask)\n",["$","span","span-3",{"className":"hljs-comment","children":"# masked_fill() 用指定值填充掩码为True的位置"}],"\nmasked = attn_scores.masked_fill(mask.",["$","span","span-4",{"className":"hljs-built_in","children":"bool"}],"(), -torch.inf)\n",["$","span","span-5",{"className":"hljs-built_in","children":"print"}],"(masked)\n",["$","span","span-6",{"className":"hljs-comment","children":"# masked / keys.shape[-1]**0.5 进行缩放，torch.softmax 进行归一化"}],"\nattn_weights = torch.softmax(masked / keys.shape[-",["$","span","span-7",{"className":"hljs-number","children":"1"}],"]**",["$","span","span-8",{"className":"hljs-number","children":"0.5"}],", dim=",["$","span","span-9",{"className":"hljs-number","children":"1"}],")\n",["$","span","span-10",{"className":"hljs-built_in","children":"print"}],"(attn_weights)\n"]}]}]
