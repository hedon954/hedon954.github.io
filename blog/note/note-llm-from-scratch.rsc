d5:["$","p","p-125",{"children":"书中还提到了一种更高效的实现方式：与其创建多组独立的权重矩阵，不如创建一个更大的权重矩阵，一次性完成对所有头的查询、键、值向量的计算，然后通过重塑（reshape）和转置（transpose）操作将结果分割成多个头 。这种方法在数学上是等价的，但利用了现代硬件进行大规模矩阵运算的优势，计算效率更高。"}]
d6:["$","pre","pre-29",{"data-language":"PYTHON","children":["$","code","code-0",{"className":"hljs language-python","children":[["$","span","span-0",{"className":"hljs-string","children":"\"\"\"\n输入: [2, 6, 3]\n    ↓\nQ,K,V: [2, 6, 2]\n    ↓\n重塑: [2, 6, 2, 1] (2个头，每个头1维)\n    ↓\n转置: [2, 2, 6, 1] (2个头并行计算)\n    ↓\n注意力: [2, 2, 6, 6] (每个头有自己的注意力矩阵)\n    ↓\n上下文: [2, 2, 6, 1] (每个头的结果)\n    ↓\n合并: [2, 6, 2] (所有头的结果合并)\n    ↓\n输出投影: [2, 6, 2]\n\"\"\""}],"\n",["$","span","span-1",{"className":"hljs-keyword","children":"class"}]," ",["$","span","span-2",{"className":"hljs-title class_","children":"MultiHeadAttention"}],"(nn.Module):\n    ",["$","span","span-3",{"className":"hljs-string","children":"\"\"\"一个高效的多头注意力类\"\"\""}],"\n    ",["$","span","span-4",{"className":"hljs-keyword","children":"def"}]," ",["$","span","span-5",{"className":"hljs-title function_","children":"__init__"}],"(",["$","span","span-6",{"className":"hljs-params","children":["self, d_in: ",["$","span","span-0",{"className":"hljs-built_in","children":"int"}],", d_out: ",["$","span","span-1",{"className":"hljs-built_in","children":"int"}],",\n                context_length: ",["$","span","span-2",{"className":"hljs-built_in","children":"int"}],", dropout: ",["$","span","span-3",{"className":"hljs-built_in","children":"float"}],", num_heads: ",["$","span","span-4",{"className":"hljs-built_in","children":"int"}],", qkv_bias=",["$","span","span-5",{"className":"hljs-literal","children":"False"}]]}],"):\n        ",["$","span","span-7",{"className":"hljs-built_in","children":"super"}],"().__init__()\n        ",["$","span","span-8",{"className":"hljs-keyword","children":"assert"}]," (d_out % num_heads == ",["$","span","span-9",{"className":"hljs-number","children":"0"}],"), ",["$","span","span-10",{"className":"hljs-string","children":"\"d_out must be divisible by num_heads\""}],"\n\n        ",["$","span","span-11",{"className":"hljs-variable language_","children":"self"}],".d_out = d_out  ",["$","span","span-12",{"className":"hljs-comment","children":"# 输出维度"}],"\n        ",["$","span","span-13",{"className":"hljs-variable language_","children":"self"}],".num_heads = num_heads ",["$","span","span-14",{"className":"hljs-comment","children":"# 头数量"}],"\n        ",["$","span","span-15",{"className":"hljs-variable language_","children":"self"}],".head_dim = d_out // num_heads ",["$","span","span-16",{"className":"hljs-comment","children":"# 每个头的维度"}],"\n\n        ",["$","span","span-17",{"className":"hljs-comment","children":"# 初始化可训练的权重矩阵，分别代表查询向量、键向量、值向量"}],"\n        ",["$","span","span-18",{"className":"hljs-variable language_","children":"self"}],".W_query = nn.Linear(d_in, d_out, bias=qkv_bias)\n        ",["$","span","span-19",{"className":"hljs-variable language_","children":"self"}],".W_key = nn.Linear(d_in, d_out, bias=qkv_bias)\n        ",["$","span","span-20",{"className":"hljs-variable language_","children":"self"}],".W_value = nn.Linear(d_in, d_out, bias=qkv_bias)\n\n        ",["$","span","span-21",{"className":"hljs-comment","children":"# 使用一个线性层来组合头的输出"}],"\n        ",["$","span","span-22",{"className":"hljs-variable language_","children":"self"}],".out_proj = nn.Linear(d_out, d_out)\n\n        ",["$","span","span-23",{"className":"hljs-comment","children":"# 掩码 + dropout"}],"\n        ",["$","span","span-24",{"className":"hljs-variable language_","children":"self"}],".dropout = nn.Dropout(dropout)\n        ",["$","span","span-25",{"className":"hljs-variable language_","children":"self"}],".register_buffer(\n            ",["$","span","span-26",{"className":"hljs-string","children":"\"mask\""}],",\n            torch.triu(torch.ones(context_length, context_length), diagonal=",["$","span","span-27",{"className":"hljs-number","children":"1"}],")\n        )\n\n    ",["$","span","span-28",{"className":"hljs-keyword","children":"def"}]," ",["$","span","span-29",{"className":"hljs-title function_","children":"forward"}],"(",["$","span","span-30",{"className":"hljs-params","children":"self, x"}],"):\n        ",["$","span","span-31",{"className":"hljs-comment","children":"# [batch_size, sequence_length, embedding_dim]"}],"\n        b, num_tokens, d_in = x.shape\n\n        ","$L247","\n        keys: Tensor = ","$L248",".W_key(x)\n        queries: Tensor = ","$L249",".W_query(x)\n        values: Tensor = ","$L24a",".W_value(x)\n\n        ","$L24b","\n        ","$L24c","\n        ","$L24d","\n        keys = keys.view(b, num_tokens, ","$L24e",".num_heads, ","$L24f",".head_dim)\n        values = values.view(b, num_tokens, ","$L250",".num_heads, ","$L251",".head_dim)\n        queries = queries.view(b, num_tokens, ","$L252",".num_heads, ","$L253",".head_dim)\n\n        ","$L254","\n        ","$L255","\n        ","$L256","\n        keys = keys.transpose(","$L257",", ","$L258",")\n        values = values.transpose(","$L259",", ","$L25a",")\n        queries = queries.transpose(","$L25b",", ","$L25c",")\n\n        ","$L25d","\n        attn_scores = queries @ keys.transpose(","$L25e",", ","$L25f",") ","$L260","\n        mask_bool: Tensor = ","$L261",".mask.","$L262","()[:num_tokens, :num_tokens]\n\n        ","$L263","\n        attn_scores.masked_fill_(mask_bool, -torch.inf)\n\n        ","$L264","\n        attn_weights = torch.softmax(attn_scores / keys.shape[-","$L265","]**","$L266",", dim=-","$L267",") ","$L268","\n\n        ","$L269","\n        attn_weights = ","$L26a",".dropout(attn_weights) ","$L26b","\n\n        ","$L26c","\n        context_vec: Tensor = (attn_weights @ values).transpose(","$L26d",", ","$L26e",") ","$L26f","\n        ","$L270","\n        context_vec = context_vec.contiguous().view(b, num_tokens, ","$L271",".d_out)\n        ","$L272","\n        context_vec = ","$L273",".out_proj(context_vec)\n        ","$L274"," context_vec\n"]}]}]
d7:["$","p","p-126",{"children":["第二个版本 ",["$","code","code-0",{"className":"$undefined","children":"MultiHeadAttention"}]," 之所以更好，根本原因在于它",["$","strong","strong-0",{"children":"将多次小规模的独立计算，整合为一次大规模的并行计算"}],"，从而最大化地利用了现代硬件（尤其是 GPU）的并行处理能力。"]}]
d8:["$","p","p-127",{"children":["第一个版本 ",["$","code","code-0",{"className":"$undefined","children":"MultiHeadAttentionWrapper"}]," 的根本问题是",["$","strong","strong-0",{"children":"计算被拆散了"}],"。对于一个有 12 个头的模型，这意味着要执行",["$","strong","strong-1",{"children":"12 组"}],"独立的 Q, K, V 矩阵乘法。在 GPU 上，每次独立的矩阵乘法都需要一次内核启动（kernel launch），这个启动本身是有开销的。执行 12 次小规模的计算，其总开销远大于执行 1 次等效的大规模计算。这就像让一个工人去搬 12 次箱子，每次只搬一个，远不如让他用推车一次性搬完 12 个箱子来得快。"]}]
d9:["$","p","p-128",{"children":"这里面的向量变化可能有一些复杂，感兴趣的读者可以参考下图进行辅助理解。"}]
da:["$","p","p-129",{"children":["$","$L8","img-0",{"src":"https://hedonspace.oss-cn-beijing.aliyuncs.com/img/image-20250830235453791.png","alt":"多头注意力完整流程可视化","node":{"type":"element","tagName":"img","properties":{"src":"https://hedonspace.oss-cn-beijing.aliyuncs.com/img/image-20250830235453791.png","alt":"多头注意力完整流程可视化"},"children":[],"position":{"start":{"line":1161,"column":1,"offset":41973},"end":{"line":1161,"column":96,"offset":42068}}}}]}]
db:["$","blockquote","blockquote-6",{"children":["\n",["$","p","p-0",{"children":["$","span","span-0",{"className":"garden-callout-marker garden-callout-marker--warning","aria-hidden":"true"}]}],"\n",["$","p","p-1",{"children":["到此为止，我们已经走完了一条从最简陋到最完备的注意力机制演进之路。我们从一个不带任何可训练参数的简单点积模型出发，理解了\"看-权衡-融合\"的核心思想；接着，通过引入可学习的 QKV 矩阵，赋予了模型",["$","strong","strong-0",{"children":"学会如何去关注"}],"的能力；随后，我们用因果掩码为模型戴上了眼罩，强制它遵守时间顺序，只能回顾过去；最后，通过多头机制和高效的并行化实现，我们构建出了 GPT 模型真正的",["$","strong","strong-1",{"children":"认知核心"}],"——",["$","code","code-0",{"className":"$undefined","children":"MultiHeadAttention"}]," 模块。"]}],"\n",["$","p","p-2",{"children":"这个模块是 Transformer 架构的灵魂。它为模型提供了一个动态的、可学习的机制，使其能够在处理每一个词元时，都能审视全局（或全局的过去），并精确地计算出上下文中每一个其他词元对当前词元的重要性，最终生成一个富含深度上下文信息的新表示。"}],"\n"]}]
dc:["$","p","p-130",{"children":["然而，一个强大的引擎（",["$","code","code-0",{"className":"$undefined","children":"MultiHeadAttention"}],"）本身还不足以构成一辆性能优越的赛车（",["$","code","code-1",{"className":"$undefined","children":"TransformerBlock"}],"）。我们还需要稳定系统、传动装置和进一步的加工环节。这就引出了我们接下来的问题："]}]
dd:["$","ul","ul-14",{"children":["\n",["$","li","li-0",{"children":["模型在通过注意力机制",["$","strong","strong-0",{"children":"融合"}],"了上下文信息之后，如何对这些新信息进行进一步的",["$","strong","strong-1",{"children":"加工和思考"}],"？"]}],"\n",["$","li","li-1",{"children":"当我们把 12 个这样强大的计算层堆叠在一起时，如何保证训练过程的稳定，防止梯度消失或爆炸？"}],"\n",["$","li","li-2",{"children":"在经过如此复杂的变换后，如何确保原始的、未经处理的信息不会在层层传递中丢失？"}],"\n"]}]
