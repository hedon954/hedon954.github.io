b8:["$","pre","pre-22",{"data-language":"PYTHON","children":["$","code","code-0",{"className":"hljs language-python","children":[["$","span","span-0",{"className":"hljs-keyword","children":"import"}]," torch\n",["$","span","span-1",{"className":"hljs-keyword","children":"import"}]," torch.nn ",["$","span","span-2",{"className":"hljs-keyword","children":"as"}]," nn\n\n",["$","span","span-3",{"className":"hljs-keyword","children":"class"}]," ",["$","span","span-4",{"className":"hljs-title class_","children":"SelfAttention_v2"}],"(nn.Module):\n    ",["$","span","span-5",{"className":"hljs-keyword","children":"def"}]," ",["$","span","span-6",{"className":"hljs-title function_","children":"__init__"}],"(",["$","span","span-7",{"className":"hljs-params","children":["self, d_in, d_out, qkv_bias=",["$","span","span-0",{"className":"hljs-literal","children":"False"}]]}],"):\n        ",["$","span","span-8",{"className":"hljs-string","children":"\"\"\"\n        d_in (int): 输入向量的维度。\n        d_out (int): 查询(Query)、键(Key)和值(Value)向量的输出维度。\n        qkv_bias (bool): 是否为Q, K, V线性层添加偏置项。\n        \"\"\""}],"\n        ",["$","span","span-9",{"className":"hljs-built_in","children":"super"}],"().__init__()\n        ",["$","span","span-10",{"className":"hljs-comment","children":"# 使用 nn.Linear 层来定义 Q, K, V 的线性变换。"}],"\n        ",["$","span","span-11",{"className":"hljs-comment","children":"# 相比手动创建 nn.Parameter，nn.Linear 提供了更优的权重初始化，并可选择性地包含偏置项，"}],"\n        ",["$","span","span-12",{"className":"hljs-comment","children":"# 是 PyTorch 中实现线性变换的标准做法。"}],"\n        ",["$","span","span-13",{"className":"hljs-variable language_","children":"self"}],".W_query = nn.Linear(d_in, d_out, bias=qkv_bias)\n        ",["$","span","span-14",{"className":"hljs-variable language_","children":"self"}],".W_key = nn.Linear(d_in, d_out, bias=qkv_bias)\n        ",["$","span","span-15",{"className":"hljs-variable language_","children":"self"}],".W_value = nn.Linear(d_in, d_out, bias=qkv_bias)\n\n    ",["$","span","span-16",{"className":"hljs-keyword","children":"def"}]," ",["$","span","span-17",{"className":"hljs-title function_","children":"forward"}],"(",["$","span","span-18",{"className":"hljs-params","children":"self, x"}],"):\n        ",["$","span","span-19",{"className":"hljs-string","children":"\"\"\"\n        x (torch.Tensor): 输入张量，形状为 [批量大小, 序列长度, d_in]。\n        \"\"\""}],"\n\n        ",["$","span","span-20",{"className":"hljs-comment","children":"# 1. 线性投影：将输入 x 转换为 Q, K, V 表示"}],"\n        ",["$","span","span-21",{"className":"hljs-comment","children":"# 每个输入词元的向量都会通过独立的线性层，生成其在查询、键、值三个空间中的新表示。"}],"\n        keys = ",["$","span","span-22",{"className":"hljs-variable language_","children":"self"}],".W_key(x)      ",["$","span","span-23",{"className":"hljs-comment","children":"# 形状: [批量大小, 序列长度, d_out]"}],"\n        queries = ",["$","span","span-24",{"className":"hljs-variable language_","children":"self"}],".W_query(x)  ",["$","span","span-25",{"className":"hljs-comment","children":"# 形状: [批量大小, 序列长度, d_out]"}],"\n        values = ",["$","span","span-26",{"className":"hljs-variable language_","children":"self"}],".W_value(x)    ",["$","span","span-27",{"className":"hljs-comment","children":"# 形状: [批量大小, 序列长度, d_out]"}],"\n\n        ",["$","span","span-28",{"className":"hljs-comment","children":"# 2. 计算注意力分数：通过点积衡量 Query 和 Key 的相似度"}],"\n        ",["$","span","span-29",{"className":"hljs-comment","children":"# queries 与 keys 的转置 (.T) 进行矩阵相乘，得到一个注意力分数矩阵。"}],"\n        ",["$","span","span-30",{"className":"hljs-comment","children":"# 矩阵中的每个元素 attn_scores[i, j] 代表第 i 个查询与第 j 个键之间的原始相关性。"}],"\n        attn_scores = queries @ keys.T\n\n        ",["$","span","span-31",{"className":"hljs-comment","children":"# 3. 缩放与归一化：将分数转换为最终的注意力权重"}],"\n        ",["$","span","span-32",{"className":"hljs-comment","children":"# a. 缩放(Scaling): 将分数除以 key 向量维度的平方根。这一步对于稳定训练至关重要，"}],"\n        ",["$","span","span-33",{"className":"hljs-comment","children":"#    可以防止在维度过高时，点积结果过大导致 softmax 梯度消失。"}],"\n        ",["$","span","span-34",{"className":"hljs-comment","children":"# b. 归一化(Normalization): 使用 softmax 函数将缩放后的分数转换为概率分布，"}],"\n        ","$L1bf","\n        attn_weights = torch.softmax(\n            attn_scores / keys.shape[-","$L1c0","] ** ","$L1c1",", dim=-","$L1c2",",\n        )\n\n        ","$L1c3","\n        ","$L1c4","\n        ","$L1c5","\n        ","$L1c6","\n        context_vec = attn_weights @ values\n        ","$L1c7"," context_vec\n"]}]}]
