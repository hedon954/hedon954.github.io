       ",["$","span","span-20",{"className":"hljs-keyword","children":"return"}]," ",["$","span","span-21",{"className":"hljs-variable language_","children":"self"}],".scale * norm_x + ",["$","span","span-22",{"className":"hljs-variable language_","children":"self"}],".shift\n"]}]}]
eb:["$","p","p-139",{"children":["让我们从第一性原理出发，来根本性地解释 ",["$","code","code-0",{"className":"$undefined","children":"LayerNorm"}]," 的这份代码实现。它的每一行都服务于一个核心目的：",["$","strong","strong-0",{"children":"在保持模型表达能力的同时，稳定深度网络的训练过程"}],"。我们可以将这个实现拆解为两个核心部分来理解：",["$","strong","strong-1",{"children":"强制标准化"}]," 和",["$","strong","strong-2",{"children":"可学习的自适应调整"}],"。"]}]
