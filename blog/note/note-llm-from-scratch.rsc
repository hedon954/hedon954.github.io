188:["$","pre","pre-44",{"data-language":"PYTHON","children":["$","code","code-0",{"className":"hljs language-python","children":[["$","span","span-0",{"className":"hljs-keyword","children":"def"}]," ",["$","span","span-1",{"className":"hljs-title function_","children":"generate"}],"(",["$","span","span-2",{"className":"hljs-params","children":["model, idx, max_new_tokens, context_length,\n        temperature=",["$","span","span-0",{"className":"hljs-number","children":"0.0"}],", top_k=",["$","span","span-1",{"className":"hljs-literal","children":"None"}],", eos_id=",["$","span","span-2",{"className":"hljs-literal","children":"None"}]]}],"):\n    ",["$","span","span-3",{"className":"hljs-string","children":"\"\"\"带温度缩放、top_k 筛选的文本生成策略\"\"\""}],"\n    ",["$","span","span-4",{"className":"hljs-keyword","children":"for"}]," _ ",["$","span","span-5",{"className":"hljs-keyword","children":"in"}]," ",["$","span","span-6",{"className":"hljs-built_in","children":"range"}],"(max_new_tokens):\n        idx_cond = idx[:, -context_length:]\n        ",["$","span","span-7",{"className":"hljs-keyword","children":"with"}]," torch.no_grad():\n            logits = model(idx_cond)\n        logits = logits[:, -",["$","span","span-8",{"className":"hljs-number","children":"1"}],", :]\n\n        ",["$","span","span-9",{"className":"hljs-comment","children":"# 使用 top_k 采样筛选 logits"}],"\n        ",["$","span","span-10",{"className":"hljs-keyword","children":"if"}]," top_k ",["$","span","span-11",{"className":"hljs-keyword","children":"is"}]," ",["$","span","span-12",{"className":"hljs-keyword","children":"not"}]," ",["$","span","span-13",{"className":"hljs-literal","children":"None"}],":\n            top_logits, _ = torch.topk(logits, top_k)\n            min_val = top_logits[:, -",["$","span","span-14",{"className":"hljs-number","children":"1"}],"]\n            logits = torch.where(\n                logits < min_val,\n                torch.tensor(",["$","span","span-15",{"className":"hljs-built_in","children":"float"}],"(",["$","span","span-16",{"className":"hljs-string","children":"'-inf'"}],")).to(logits.device),\n                logits,\n            )\n\n        ",["$","span","span-17",{"className":"hljs-keyword","children":"if"}]," temperature > ",["$","span","span-18",{"className":"hljs-number","children":"0.0"}],":\n            ",["$","span","span-19",{"className":"hljs-comment","children":"# 使用温度缩放"}],"\n            logits = logits / temperature\n            probs = torch.softmax(logits, dim=-",["$","span","span-20",{"className":"hljs-number","children":"1"}],")\n            idx_next = torch.multinomial(probs, num_samples=",["$","span","span-21",{"className":"hljs-number","children":"1"}],")\n        ",["$","span","span-22",{"className":"hljs-keyword","children":"else"}],":\n            ",["$","span","span-23",{"className":"hljs-comment","children":"# 当不使用温度缩放时，执行贪心解码，选取下一个词元"}],"\n            idx_next = torch.argmax(logits, dim=-",["$","span","span-24",{"className":"hljs-number","children":"1"}],", keepdim=",["$","span","span-25",{"className":"hljs-literal","children":"True"}],")\n\n        ",["$","span","span-26",{"className":"hljs-comment","children":"# 如果遇到序列结束词元，则提前停止生成"}],"\n        ",["$","span","span-27",{"className":"hljs-keyword","children":"if"}]," idx_next == eos_id:\n            ",["$","span","span-28",{"className":"hljs-keyword","children":"break"}],"\n        idx = torch.cat((idx, idx_next), dim=",["$","span","span-29",{"className":"hljs-number","children":"1"}],")\n    ",["$","span","span-30",{"className":"hljs-keyword","children":"return"}]," idx\n"]}]}]
189:["$","h3","h3-14",{"id":"44-其他思路","children":["$","a","a-0",{"href":"#44-其他思路","node":{"type":"element","tagName":"a","properties":{"href":"#44-其他思路"},"children":[{"type":"text","value":"4.4 其他思路","position":{"start":{"line":1869,"column":5,"offset":69029},"end":{"line":1869,"column":13,"offset":69037}}}]},"children":"4.4 其他思路"}]}]
18a:["$","p","p-233",{"children":"除了常见的温度采样和 top-k/top-p 采样，还有多种技术可以用来控制模型的文本生成策略，每种技术都有其独特的优缺点和适用场景。"}]
18b:["$","p","p-234",{"children":["$","strong","strong-0",{"children":"1. Beam Search (集束搜索)"}]}]
18c:["$","p","p-235",{"children":"这是一种基于搜索的启发式算法，旨在找到一个整体概率最高的序列，而不是仅仅关注每一步的最优选择。"}]
18d:["$","ul","ul-28",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"工作原理"}],"：在生成的每一步，它会保留 ",["$","code","code-0",{"className":"$undefined","children":"k"}]," 个（",["$","code","code-1",{"className":"$undefined","children":"k"}]," 在这里被称为集束宽度或 beam width）最可能的候选序列。在下一步，它会从这 ",["$","code","code-2",{"className":"$undefined","children":"k"}]," 个序列出发，生成所有可能的下一个词，并计算新序列的总概率，然后再次只保留总概率最高的 ",["$","code","code-3",{"className":"$undefined","children":"k"}]," 个序列。这个过程会一直持续到生成结束。"]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"优势"}],"：通过探索多种可能性，它通常能生成比贪婪搜索（Greedy Search，即每步都选概率最高的词）更流畅、更全局最优的序列。"]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"劣势"}],"：它倾向于生成高频、安全的文本，可能会缺乏多样性和创造性。同时，计算开销比简单的采样方法要大。"]}],"\n"]}]
18e:["$","p","p-236",{"children":["$","strong","strong-0",{"children":"2. Contrastive Search (对比搜索)"}]}]
18f:["$","p","p-237",{"children":"这是一种较新的解码方法，旨在通过结合模型的概率和词元间的相似性来提升生成文本的连贯性和多样性，有效减少重复。"}]
190:["$","ul","ul-29",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"工作原理"}],"：在每一步选择下一个词元时，它会同时考虑两个因素：\n",["$","ol","ol-0",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"模型置信度"}],"：下一个词元的概率要高。"]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"多样性/惩罚"}],"：下一个词元不应该和前文已经生成的词元过于相似。它通过计算候选词元与上文的相似性得分，并从模型概率中减去这个相似性得分作为惩罚项。"]}],"\n"]}],"\n"]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"优势"}],"：在许多评测中，对比搜索被证明可以在不需要对模型进行任何额外训练的情况下，显著优于传统的解码方法，尤其在减少文本重复和提升连贯性方面表现突出。"]}],"\n"]}]
191:["$","p","p-238",{"children":["$","strong","strong-0",{"children":"3. Mirostat 采样"}]}]
192:["$","p","p-239",{"children":"这是一种自适应的采样算法，它的目标是让生成文本的\"惊奇度\"（Perplexity，一种衡量不确定性的指标）维持在一个预设的目标值附近。"}]
193:["$","ul","ul-30",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"工作原理"}],"：Mirostat 会在生成过程中持续监控输出文本的困惑度（Perplexity）。如果当前文本的困惑度低于目标值（意味着文本过于平淡、可预测），算法就会动态调整采样策略（如调整 ",["$","code","code-0",{"className":"$undefined","children":"top-k"}]," 的 ",["$","code","code-1",{"className":"$undefined","children":"k"}]," 值）来增加随机性。反之，如果困惑度太高（文本可能不连贯），它就会降低随机性。"]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"优势"}],"：它通过一个反馈循环来直接控制生成文本的统计特性，可以有效避免陷入无聊陷阱（过度重复）和困惑陷阱（内容不连贯）。"]}],"\n"]}]
194:["$","p","p-240",{"children":["$","strong","strong-0",{"children":"总结"}]}]
195:["$","table","table-0",{"children":[["$","thead","thead-0",{"children":["$","tr","tr-0",{"children":[["$","th","th-0",{"children":"解码策略"}],["$","th","th-1",{"children":"核心思想"}],["$","th","th-2",{"children":"优点"}],["$","th","th-3",{"children":"缺点"}]]}]}],["$","tbody","tbody-0",{"children":[["$","tr","tr-0",{"children":[["$","td","td-0",{"children":["$","strong","strong-0",{"children":"Beam Search"}]}],["$","td","td-1",{"children":["保留 ",["$","code","code-0",{"className":"$undefined","children":"k"}]," 个最可能的序列，追求全局最优。"]}],["$","td","td-2",{"children":"连贯性好，适合翻译、摘要等任务。"}],["$","td","td-3",{"children":"多样性差，计算成本较高。"}]]}],["$","tr","tr-1",{"children":[["$","td","td-0",{"children":["$","strong","strong-0",{"children":"Contrastive Search"}]}],["$","td","td-1",{"children":"结合模型概率和与上文的相异度来选择。"}],["$","td","td-2",{"children":"显著减少重复，提升连贯性。"}],["$","td","td-3",{"children":"算法相对复杂。"}]]}],["$","tr","tr-2",{"children":[["$","td","td-0",{"children":["$","strong","strong-0",{"children":"Mirostat"}]}],["$","td","td-1",{"children":"动态调整采样，使文本的困惑度维持在目标水平。"}],["$","td","td-2",{"children":"直接控制文本的统计特性，避免重复和不连贯。"}],["$","td","td-3",{"children":"需要设定一个合适的目标困惑度值。"}]]}]]}]]}]
196:["$","h2","h2-4",{"id":"总结","children":["$","a","a-0",{"href":"#总结","node":{"type":"element","tagName":"a","properties":{"href":"#总结"},"children":[{"type":"text","value":"总结","position":{"start":{"line":1905,"column":4,"offset":70710},"end":{"line":1905,"column":6,"offset":70712}}}]},"children":"总结"}]}]
197:["$","p","p-241",{"children":"至此，我们 500 行代码的旅程也接近了尾声。本文完整记录了从零开始构建一个 GPT 风格语言模型的全过程，旨在将一个复杂的系统拆解为一系列清晰、可执行的步骤。"}]
198:["$","p","p-242",{"children":"首先，从数据处理入手，阐述了如何将原始文本语料通过词元化、滑动窗口采样等方法，构建成模型训练所需的、包含输入-目标对的批量化张量（batched tensors）。"}]
199:["$","p","p-243",{"children":["接着，深入剖析了 ",["$","strong","strong-0",{"children":"Transformer 模型的核心架构"}],"。从输入层的词元与位置嵌入，到作为核心处理单元的 TransformerBlock 堆叠。在此过程中，详细解释了多头因果自注意力机制、前馈网络、层归一化和残差连接等关键组件的原理与作用，展示了它们如何协同工作以融合上下文信息并稳定深度网络的训练。"]}]
19a:["$","p","p-244",{"children":["在模型结构之后，文章介绍了完整的",["$","strong","strong-0",{"children":"训练循环"}],"。这包括前向传播、交叉熵损失计算、反向传播和优化器更新参数的完整流程，并展示了如何通过验证集监控训练状态，以评估模型的学习效果和泛化能力。"]}]
19b:["$","p","p-245",{"children":["最后，文章探讨了",["$","strong","strong-0",{"children":"文本生成阶段的解码策略"}],"，分析了从基础的贪婪解码到更高级的温度采样、Top-k 和 Top-p 等方法的原理，以及它们如何被用于控制生成文本的多样性与连贯性。"]}]
19c:["$","p","p-246",{"children":"本文的核心主线是展示一个复杂的大语言模型系统，实际上可以被拆解为一系列目标明确、逻辑清晰的子问题和对应的工程实现。通过逐一解决从数据表示、上下文融合、深度网络训练稳定性到高质量文本生成等一系列挑战，我们最终将这些独立的模块化解决方案组合成一个功能完备的系统。"}]
19d:["$","p","p-247",{"children":"通过这种从零开始的构建过程，我们不仅能理解各个技术点的作用，更能把握它们之间如何相互关联、协同工作，从而对整个大语言模型的工作原理形成一个结构化、系统性的认知。希望本文的拆解与实现，能为每一位对大模型内部工作原理感到好奇、并希望从实践中构建体系化认知的开发者，提供一条清晰可循的路径和切实的帮助。"}]
19e:["$","div",null,{"className":"article-tags","children":[["$","span","读书笔记",{"className":"p-category","children":["#","读书笔记"]}],["$","span","大模型",{"className":"p-category","children":["#","大模型"]}]]}]
