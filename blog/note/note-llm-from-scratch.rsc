cd:["$","pre","pre-27",{"data-language":"PYTHON","children":["$","code","code-0",{"className":"hljs language-python","children":[["$","span","span-0",{"className":"hljs-keyword","children":"import"}]," torch\n",["$","span","span-1",{"className":"hljs-keyword","children":"import"}]," torch.nn ",["$","span","span-2",{"className":"hljs-keyword","children":"as"}]," nn\n\n",["$","span","span-3",{"className":"hljs-keyword","children":"class"}]," ",["$","span","span-4",{"className":"hljs-title class_","children":"CausalAttention"}],"(nn.Module):\n    ",["$","span","span-5",{"className":"hljs-string","children":"\"\"\"\n    一个实现了因果自注意力（Causal Self-Attention）的模块。\n\n    因果特性确保在处理序列中的任何一个词元（token）时，\n    注意力机制只能关注到当前位置及之前位置的词元，而不能看到未来的词元。\n    这对于自回归（auto-regressive）的文本生成任务至关重要。\n    \"\"\""}],"\n    ",["$","span","span-6",{"className":"hljs-keyword","children":"def"}]," ",["$","span","span-7",{"className":"hljs-title function_","children":"__init__"}],"(",["$","span","span-8",{"className":"hljs-params","children":["self, d_in, d_out, context_length, dropout, qkv_bias=",["$","span","span-0",{"className":"hljs-literal","children":"False"}]]}],"):\n        ",["$","span","span-9",{"className":"hljs-string","children":"\"\"\"\n        初始化方法。\n\n        参数:\n        d_in (int): 输入嵌入向量的维度。\n        d_out (int): 查询(Query)、键(Key)和值(Value)向量的输出维度。\n        context_length (int): 模型的最大序列长度，用于创建因果掩码。\n        dropout (float): 应用于注意力权重矩阵的 dropout 比率。\n        qkv_bias (bool): 是否为 Q, K, V 的线性层添加偏置项。\n        \"\"\""}],"\n        ",["$","span","span-10",{"className":"hljs-built_in","children":"super"}],"().__init__()\n        ",["$","span","span-11",{"className":"hljs-variable language_","children":"self"}],".d_out = d_out\n        ",["$","span","span-12",{"className":"hljs-comment","children":"# 定义用于生成 Query, Key, Value 的线性变换层"}],"\n        ",["$","span","span-13",{"className":"hljs-variable language_","children":"self"}],".W_query = nn.Linear(d_in, d_out, bias=qkv_bias)\n        ",["$","span","span-14",{"className":"hljs-variable language_","children":"self"}],".W_key   = nn.Linear(d_in, d_out, bias=qkv_bias)\n        ",["$","span","span-15",{"className":"hljs-variable language_","children":"self"}],".W_value = nn.Linear(d_in, d_out, bias=qkv_bias)\n        ",["$","span","span-16",{"className":"hljs-comment","children":"# 定义 Dropout 层，用于正则化，防止过拟合"}],"\n        ",["$","span","span-17",{"className":"hljs-variable language_","children":"self"}],".dropout = nn.Dropout(dropout)\n        ",["$","span","span-18",{"className":"hljs-comment","children":"# 创建并注册因果掩码（causal mask）"}],"\n        ",["$","span","span-19",{"className":"hljs-comment","children":"# register_buffer 将一个张量注册为模块的缓冲区，它不会被视为模型参数（即不会在训练中被更新），"}],"\n        ",["$","span","span-20",{"className":"hljs-comment","children":"# 但会随着模型移动（例如，.to(device)）。"}],"\n        ",["$","span","span-21",{"className":"hljs-variable language_","children":"self"}],".register_buffer(\n            ",["$","span","span-22",{"className":"hljs-string","children":"'mask'"}],",\n            ",["$","span","span-23",{"className":"hljs-comment","children":"# torch.triu 创建一个上三角矩阵。diagonal=1 表示主对角线（及以下）的元素都为0，"}],"\n            ",["$","span","span-24",{"className":"hljs-comment","children":"# 只有主对角线上方的元素为1。这个矩阵用于屏蔽未来的位置。"}],"\n            torch.triu(torch.ones(context_length, context_length), diagonal=",["$","span","span-25",{"className":"hljs-number","children":"1"}],")\n        )\n\n    ",["$","span","span-26",{"className":"hljs-keyword","children":"def"}]," ",["$","span","span-27",{"className":"hljs-title function_","children":"forward"}],"(",["$","span","span-28",{"className":"hljs-params","children":"self, x"}],"):\n        ",["$","span","span-29",{"className":"hljs-string","children":"\"\"\"\n        执行前向传播。\n\n        参数:\n        x (torch.Tensor): 输入张量，形状为 [批量大小, 序列长度, 输入嵌入维度 d_in]。\n        \"\"\""}],"\n        ",["$","span","span-30",{"className":"hljs-comment","children":"# 获取输入的维度信息"}],"\n        b, num_tokens, d_in = x.shape\n\n        ","$L21f","\n        keys = ","$L220",".W_key(x)      ","$L221","\n        queries = ","$L222",".W_query(x) ","$L223","\n        values = ","$L224",".W_value(x)  ","$L225","\n\n        ","$L226","\n        ","$L227","\n        ","$L228","\n        ","$L229","\n        attn_scores = queries @ keys.transpose(","$L22a",", ","$L22b",")  ","$L22c","\n\n        ","$L22d","\n        ","$L22e","\n        ","$L22f","\n        ","$L230","\n        attn_scores.masked_fill_(\n            ","$L231",".mask.","$L232","()[:num_tokens, :num_tokens], -torch.inf\n        )\n\n        ","$L233","\n        ","$L234","\n        ","$L235","\n        ","$L236","\n        attn_weights = torch.softmax(\n            attn_scores / keys.shape[-","$L237","]**","$L238",", dim=-","$L239","\n        )\n\n        ","$L23a","\n        ","$L23b","\n        attn_weights = ","$L23c",".dropout(attn_weights)\n\n        ","$L23d","\n        ","$L23e","\n        context_vec = attn_weights @ values ","$L23f","\n        ","$L240"," context_vec\n"]}]}]
