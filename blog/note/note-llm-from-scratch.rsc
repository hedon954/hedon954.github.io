ader, device, eval_iter)\n                train_losses.append(train_loss)\n                val_losses.append(val_loss)\n                track_tokens_seen.append(tokens_seen)\n                ",["$","span","span-15",{"className":"hljs-built_in","children":"print"}],"(",["$","span","span-16",{"className":"hljs-string","children":["f\"Ep ",["$","span","span-0",{"className":"hljs-subst","children":["{epoch+",["$","span","span-0",{"className":"hljs-number","children":"1"}],"}"]}]," (Step ",["$","span","span-1",{"className":"hljs-subst","children":"{global_step:06d}"}],"):\""]}],"\n                    ",["$","span","span-17",{"className":"hljs-string","children":["f\"Train loss ",["$","span","span-0",{"className":"hljs-subst","children":["{train_loss:",["$","span","span-0",{"className":"hljs-number","children":".3"}],"f}"]}],", \""]}],"\n                    ",["$","span","span-18",{"className":"hljs-string","children":["f\"Val loss ",["$","span","span-0",{"className":"hljs-subst","children":["{val_loss:",["$","span","span-0",{"className":"hljs-number","children":".3"}],"f}"]}],"\""]}],")\n\n        ",["$","span","span-19",{"className":"hljs-comment","children":"# 每3个epoch生成样本"}],"\n        ",["$","span","span-20",{"className":"hljs-keyword","children":"if"}]," epoch % ",["$","span","span-21",{"className":"hljs-number","children":"3"}]," == ",["$","span","span-22",{"className":"hljs-number","children":"0"}],":\n            generate_and_print_sample(model, tokenizer, device, start_context)\n    ",["$","span","span-23",{"className":"hljs-keyword","children":"return"}]," train_losses, val_losses, track_tokens_seen\n"]}]}]
