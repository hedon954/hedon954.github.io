bb:["$","ul","ul-39",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"建立 ADR 制度："}]," 强烈建议引入 ADR 机制。"]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"使用统一的知识管理平台："}]," 将所有 ADR 存放在一个统一的、可检索的知识管理平台（如飞书文档, Wiki 或 Git）。这样，团队成员可以轻松地查阅历史决策，新成员也能快速理解系统的演进过程。"]}],"\n"]}]
