123:["$","$L134",null,{"headings":[{"depth":2,"text":"聊架构设计的时候，我们在谈什么？","id":"聊架构设计的时候我们在谈什么"},{"depth":2,"text":"Fundamentals of Software Architectrue 笔记梳理","id":"fundamentals-of-software-architectrue-笔记梳理"},{"depth":3,"text":"1. 理解商业与组织上下文","id":"1-理解商业与组织上下文"},{"depth":4,"text":"1.1 谈判技巧","id":"11-谈判技巧"},{"depth":4,"text":"1.2 业务理解","id":"12-业务理解"},{"depth":3,"text":"2. 定义架构特性与约束","id":"2-定义架构特性与约束"},{"depth":4,"text":"2.1 架构特性定义","id":"21-架构特性定义"},{"depth":4,"text":"2.2 架构特性类型","id":"22-架构特性类型"},{"depth":4,"text":"2.3 架构特性选择","id":"23-架构特性选择"},{"depth":3,"text":"3. 探索方案与决策","id":"3-探索方案与决策"},{"depth":4,"text":"3.1 架构风格","id":"31-架构风格"},{"depth":5,"text":"3.1.1 分层架构 Layered Architecture","id":"311-分层架构-layered-architecture"},{"depth":5,"text":"3.1.2 管道架构 Pipeline Architecture","id":"312-管道架构-pipeline-architecture"},{"depth":5,"text":"3.1.3 微核架构 Microkernel Architecture","id":"313-微核架构-microkernel-architecture"},{"depth":5,"text":"3.1.4 基于服务的架构 Service-Based Architecture","id":"314-基于服务的架构-service-based-architecture"},{"depth":5,"text":"3.1.5 事件驱动架构 Event-Driven Architecture","id":"315-事件驱动架构-event-driven-architecture"},{"depth":5,"text":"3.1.6 空间架构 Space-Based Architecture","id":"316-空间架构-space-based-architecture"},{"depth":5,"text":"3.1.7 面向服务架构 Orchestration-Driven Service-Oriented Architecture","id":"317-面向服务架构-orchestration-driven-service-oriented-architecture"},{"depth":5,"text":"3.1.8 微服务架构 Microservice Architecture","id":"318-微服务架构-microservice-architecture"},{"depth":4,"text":"3.2 架构选择","id":"32-架构选择"},{"depth":5,"text":"3.2.1 单体 vs 分布式","id":"321-单体-vs-分布式"},{"depth":5,"text":"3.2.2 数据存储","id":"322-数据存储"},{"depth":5,"text":"3.2.3 同步 vs 异步","id":"323-同步-vs-异步"},{"depth":4,"text":"3.3 风险评估","id":"33-风险评估"},{"depth":4,"text":"3.4 架构决策","id":"34-架构决策"},{"depth":5,"text":"3.4.1 Anti-Pattern1: Covering Your Assets","id":"341-anti-pattern1-covering-your-assets"},{"depth":5,"text":"3.4.2 Anti-Pattern2: Groundhog Day","id":"342-anti-pattern2-groundhog-day"},{"dep