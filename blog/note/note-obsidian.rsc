1:["$","main",null,{"className":"reading-page post-reading-page","children":["$","article",null,{"className":"post-article h-entry","children":[["$","$L7",null,{"className":"u-url sr-only","href":"/blog/note/note-obsidian","children":["读书笔记丨《上头Obsidian：手把手教你用AI做好知识管理》"," 永久链接"]}],["$","a",null,{"className":"p-author h-card sr-only","href":"https://github.com/hedon954","rel":"author","children":"Hedon"}],["$","figure",null,{"className":"article-hero article-cover","children":["$","img",null,{"className":"u-photo","src":"https://hedon.top/hedonspace/banner/note-obsidian.jpg","alt":"读书笔记丨《上头Obsidian：手把手教你用AI做好知识管理》 的文章封面"}]}],["$","header",null,{"className":"article-header article-summary-row","children":[["$","p",null,{"className":"eyebrow","children":"读书笔记"}],["$","h1",null,{"className":"p-name","children":"读书笔记丨《上头Obsidian：手把手教你用AI做好知识管理》"}],["$","p",null,{"className":"article-deck p-summary","children":"《上头Obsidian：手把手教你用AI做好知识管理》提出了一套以“表达”为核心的知识管理方法——GAP模型：采集（Grasp）、归类（Arrange）、表达（Present）。通过明确目标、高效采集、合理归类，最终借助Obsidian与AI工具实现高质量输出，将碎片信息转化为结构化知识系统，帮助用户从“信息焦虑”走向“知识掌控”。"}],["$","div",null,{"className":"article-meta","children":[["$","time",null,{"className":"dt-published","dateTime":"2025-10-14T17:36:00.000Z","children":["发布于 ","2025/10/14"]}],"$undefined",["$","span",null,{"children":"$undefined"}],["$","span",null,{"children":["约 ","2,258"," 字"]}]]}]]}],["$","div",null,{"className":"article-reading-layout","children":[["$","div",null,{"className":"article-reading-column","children":[["$","div",null,{"className":"e-content","children":["$","div",null,{"className":"markdown-body","children":[["$","h2","h2-0",{"id":"道","children":["$","a","a-0",{"href":"#道","node":{"type":"element","tagName":"a","properties":{"href":"#道"},"children":[{"type":"text","value":"道","position":{"start":{"line":1,"column":4,"offset":3},"end":{"line":1,"column":5,"offset":4}}}]},"children":"道"}]}],"\n",["$","p","p-0",{"children":["知识管理的最终目的是什么？—— 表达（输出）。",["$","br","br-0",{}],"\n所以知识管理的底层逻辑基本是不变的：”输入 → 关联 → 表达“。"]}],"\n",["$","p","p-1",{"children":"《上头 Obsidian》的作者提出了一种构建知识库的思路：GAP，即："}],"\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":"G（Grasp）：采集"}],"\n",["$","li","li-1",{"children":"A（Arrange）：归类"}],"\n",["$","li","li-2",{"children":"P（Present）：表达"}],"\n"]}],"\n",["$","p","p-2",{"children":"所以我们要如何做采集和归类，才能帮助我们做更好的表达呢？我们一定要围绕我们的最终目标”表达“来思考，即在采集环节，只采集那些我们需要的材料，而不是看到什么觉得好像不错、可能有用就一股脑收集起来，最后形成了一个堆满垃圾的仓库。"}],"\n",["$","p","p-3",{"children":"知识采集可以分为三步走："}],"\n",["$","ol","ol-0",{"children":["\n",["$","li","li-0",{"children":"明确目标：收集要解决的问题、想要表达的内容、需要完成的任务、对自己启发的信息。"}],"\n",["$","li","li-1",{"children":"喂养大脑：选择”不舒服、长、经典“的高质量资料源，避免无意义的信息堆积。"}],"\n",["$","li","li-2",{"children":"快速收集：配置顺手的剪藏工作与清晰的采集模板，保证灵感第一时间被捕获。"}],"\n"]}],"\n",["$","p","p-4",{"children":"如果说采集阶段是积累原料，那么归类阶段就是开始搭建结构，把零散的信息组织成可用的模块。只有经过合理归类的内容，才能成为后续输出的基石。"}],"\n",["$","p","p-5",{"children":"知识归类主要做三件事情："}],"\n",["$","ol","ol-1",{"children":["\n",["$","li","li-0",{"children":"定期整理未处理的笔记；"}],"\n",["$","li","li-1",{"children":["进行笔记关联：\n",["$","ol","ol-0",{"children":["\n",["$","li","li-0",{"children":"第一次收集该主题的相关内容，则需要新建一个归类笔记，并将当前这条采集笔记作为第一条材料添加进去。"}],"\n",["$","li","li-1",{"children":"在归类文件夹中，已经形成了对应的主题笔记，只需要将新的采集笔记链接到已有的归类笔记中即可。"}],"\n"]}],"\n"]}],"\n",["$","li","li-2",{"children":["整理归类笔记\n",["$","ol","ol-0",{"children":["\n",["$","li","li-0",{"children":"拆分归类笔记，如果一类笔记中积累了很多内容，则需要进一步进行方向拆分。"}],"\n",["$","li","li-1",{"children":"准备产出，如果某个归类笔记下的内容已经足够成熟、结构也很清晰，那就可以开始表达输出了。"}],"\n"]}],"\n"]}],"\n"]}],"\n",["$","p","p-6",{"children":"表达是最好的学习方式，可分四步走："}],"\n",["$","ol","ol-2",{"children":["\n",["$","li","li-0",{"children":"有表达需求时，立即新建表达笔记；"}],"\n",["$","li","li-1",{"children":"使用分屏、AI 等工具高效完成内容撰写；"}],"\n",["$","li","li-2",{"children":"修改状态、建立链接、融入知识网络；"}],"\n",["$","li","li-3",{"children":"将表达笔记发布到合适的平台，获取外部反馈。"}],"\n"]}],"\n",["$","h2","h2-1",{"id":"术","children":["$","a","a-0",{"href":"#术","node":{"type":"element","tagName":"a","properties":{"href":"#术"},"children":[{"type":"text","value":"术","position":{"start":{"line":39,"column":4,"offset":833},"end":{"line":39,"column":5,"offset":834}}}]},"children":"术"}]}],"\n",["$","p","p-7",{"children":"那为什么选择 Obsidian 呢？为什么 Obsidian 可以在 GAP 的各个阶段对我们形成助力呢？为什么在 AI 时代，Obsidian 的能力可以得到进一步加强呢？"}],"\n",["$","p","p-8",{"children":"核心分为两大部分："}],"\n",["$","ul","ul-1",{"children":["\n",["$","li","li-0",{"children":"知识库：有一个地方可以存储我们的材料，是能保证信息放得合理、有序、能随时被调取。"}],"\n",["$","li","li-1",{"children":"工作流：明确的处理步骤、从信息的采集、归类、加工到输出到有既定的路径依赖，降低心智负担。能提供可重复使用的内容模版，减少重复劳动，减少不一致性，提高操作效率。"}],"\n"]}],"\n","$L8","\n","$L9","\n","$La","\n","$Lb","\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b"]}]}],"$L1c","$L1d","$L1e"]}],"$L1f"]}]]}]}]
20:I["201d37663261",[],"Webmentions",1]
21:I["35e6595fba52",[],"GiscusComments",1]
22:I["47831e8e6cd4",[],"TableOfContents",1]
8:["$","p","p-9",{"children":"在这 2 个方面上，Obsidian 一些特性可以提供很好的支持："}]
9:["$","ol","ol-3",{"children":["\n",["$","li","li-0",{"children":"Obsidian 本身就是一个笔记软件，且笔记都是以 markdown 文件存储在本地的，支持 iCloud 等多种方式实现多端同步，材料的安全性、完整性和可迁移性都非常强。"}],"\n",["$","li","li-1",{"children":"Obsidian 的双链、标签、文件夹功能，可以帮助我们建立合理、有序的知识网络，更符合人脑对知识的利用逻辑。"}],"\n",["$","li","li-2",{"children":"Obsidian 支持多种插件、模板功能，方便我们建立强大的工作流，在大大减少重复劳动、提高操作效率的同时，还能帮助我们产出更具一致性、高质量的知识库。尤其是在 AI 能力的加持下，这些能力会被进一步增强。"}],"\n"]}]
a:["$","p","p-10",{"children":"具体到 GAP 每一个步骤上，Obsidian 可以提供以下的帮助。"}]
b:["$","h3","h3-0",{"id":"ggrasp采集重点是快便捷无心智负担","children":["$","a","a-0",{"href":"#ggrasp采集重点是快便捷无心智负担","node":{"type":"element","tagName":"a","properties":{"href":"#ggrasp采集重点是快便捷无心智负担"},"children":[{"type":"text","value":"G（Grasp）采集：重点是快、便捷、无心智负担","position":{"start":{"line":56,"column":5,"offset":1395},"end":{"line":56,"column":29,"offset":1419}}}]},"children":"G（Grasp）采集：重点是快、便捷、无心智负担"}]}]
c:["$","ol","ol-4",{"children":["\n",["$","li","li-0",{"children":"定义”采集笔记模版“，设立”tags、created、link“通用属性，方便利用 dataview、标签过滤和双链功能建立知识网络和过滤能力。"}],"\n",["$","li","li-1",{"children":["利用插件和 AI 快速提取材料：\n",["$","ol","ol-0",{"children":["\n",["$","li","li-0",{"children":"可以使用官方插件 Obsidian Web Clipper 采集网页内容，它支持 AI Hook，可以在存储为采集材料之前先让 AI 进行一轮总结和关键提取，进一步提高效率。"}],"\n",["$","li","li-1",{"children":"针对本地的录音、视频，可以用”通义听悟“等 AI 软件把内容转录为文字并提取重点。"}],"\n",["$","li","li-2",{"children":"针对在线视频（Youtube，Bilibili），可以使用”BilliGPT“等软件进行内容提取和总结。"}],"\n",["$","li","li-3",{"children":"可以使用 Douban 插件，快速抓取书籍、电影等材料元信息，更方便做智能归纳和整理。"}],"\n",["$","li","li-4",{"children":"可以使用 weread 插件，快速拉取微信读书的摘录、笔记和评论，再利用 AI 快速生成个性化的读书笔记。"}],"\n"]}],"\n"]}],"\n",["$","li","li-2",{"children":"可以使用 iCloud 进行多端同步，同时在 iPhone 上使用便捷指令快速采集网络上需要的材料。"}],"\n",["$","li","li-3",{"children":"支持多种插件，除了 markdown 文字之外，还可以在笔记中嵌入多中类型的材料，如图片（Image Toolkit）、视频（Convert url to preview（iframe）、PDF（PDF++）。"}],"\n"]}]
d:["$","h3","h3-1",{"id":"aarrange归类这一步大部分需要人工操作","children":["$","a","a-0",{"href":"#aarrange归类这一步大部分需要人工操作","node":{"type":"element","tagName":"a","properties":{"href":"#aarrange归类这一步大部分需要人工操作"},"children":[{"type":"text","value":"A（Arrange）归类：这一步大部分需要人工操作","position":{"start":{"line":68,"column":5,"offset":1996},"end":{"line":68,"column":30,"offset":2021}}}]},"children":"A（Arrange）归类：这一步大部分需要人工操作"}]}]
e:["$","ol","ol-5",{"children":["\n",["$","li","li-0",{"children":"定义”归类笔记模版“，设立”tags、created、link“通用属性，方便利用 dataview、标签过滤和双链功能建立知识网络和过滤能力。"}],"\n",["$","li","li-1",{"children":"可以在日记中，利用”数据库 base“能力，快速筛选出”当日新建笔记“，方面每日定时进行笔记梳理和清理，保持知识库的整洁和有序。"}],"\n",["$","li","li-2",{"children":"通过双链功能，解决了信息孤岛的问题，让不同的笔记之间产生关联关系。"}],"\n"]}]
f:["$","h3","h3-2",{"id":"ppresent表达最根本的目标","children":["$","a","a-0",{"href":"#ppresent表达最根本的目标","node":{"type":"element","tagName":"a","properties":{"href":"#ppresent表达最根本的目标"},"children":[{"type":"text","value":"P（Present）表达：最根本的目标","position":{"start":{"line":74,"column":5,"offset":2209},"end":{"line":74,"column":24,"offset":2228}}}]},"children":"P（Present）表达：最根本的目标"}]}]
10:["$","ol","ol-6",{"children":["\n",["$","li","li-0",{"children":"定义”表达笔记模版“，设立”tags、created、link“通用属性，方便利用 dataview、标签过滤和双链功能建立知识网络和过滤能力。"}],"\n",["$","li","li-1",{"children":"当前面 2 步是围绕”表达“这一目标来执行又做得足够好的时候，表达就是自然而然是事情了，因为材料已经有序整理好了，剩下的就是组织和吸收内化的部分了。"}],"\n",["$","li","li-2",{"children":"可以利用 Copilot 插件，将相链接的材料交给 AI，生成大纲或输出文章的初稿。这里一定要自己去做表达和输出，不要过度依赖 AI 的思考，只有自己的大脑不断思考和变强，知识管理才是有意义的。"}],"\n",["$","li","li-3",{"children":"当表达笔记产出完毕后，再次将其与知识库已有的归类笔记链接起来，这样它又成为了一个可复用的高质量素材，以此逐步形成复利效应。"}],"\n"]}]
11:["$","h2","h2-2",{"id":"三大场景","children":["$","a","a-0",{"href":"#三大场景","node":{"type":"element","tagName":"a","properties":{"href":"#三大场景"},"children":[{"type":"text","value":"三大场景","position":{"start":{"line":81,"column":4,"offset":2554},"end":{"line":81,"column":8,"offset":2558}}}]},"children":"三大场景"}]}]
12:["$","h3","h3-3",{"id":"日记复盘","children":["$","a","a-0",{"href":"#日记复盘","node":{"type":"element","tagName":"a","properties":{"href":"#日记复盘"},"children":[{"type":"text","value":"日记复盘","position":{"start":{"line":83,"column":5,"offset":2564},"end":{"line":83,"column":9,"offset":2568}}}]},"children":"日记复盘"}]}]
13:["$","blockquote","blockquote-0",{"children":["\n",["$","p","p-0",{"children":"Obsidian + Journals"}],"\n"]}]
14:["$","ol","ol-7",{"children":["\n",["$","li","li-0",{"children":"使用 Journals 插件，实现按日、周、月、季、年自动生成日记目标和页面。"}],"\n",["$","li","li-1",{"children":"使用 Dataview 代码、数据库 Base，打造百年日记视角，回顾每年同一天、周、月发生的事情。"}],"\n",["$","li","li-2",{"children":"借鉴”机会日记“方法，每天记录 3 个机会、3 个反思、1 个感恩，养成敏锐感知和调整的习惯。"}],"\n",["$","li","li-3",{"children":"在 Copilot 插件中设置提示词模板，让 AI 工具自动分析一周的日记，输出总结和改进建议。"}],"\n",["$","li","li-4",{"children":"用 AI 工具生成的周复盘，继续作为月复盘、年复盘的输入材料，形成连贯的复盘链条。"}],"\n"]}]
