6e:["$","ol","ol-16",{"children":["\n",["$","li","li-0",{"children":"applying mocks to unmanaged dependencies only"}],"\n",["$","li","li-1",{"children":"verifying the interactions with those dependencies at the very edges of your system"}],"\n",["$","li","li-2",{"children":"using mocks in integration tests only, not in unit test"}],"\n",["$","li","li-3",{"children":"always verifying the number of calls made to the mock"}],"\n",["$","li","li-4",{"children":"do not rely on production code when making assertions. Use a separate set of literals and constants in tests."}],"\n",["$","li","li-5",{"children":["mocking only types that you own\n",["$","ol","ol-0",{"children":["\n",["$","li","li-0",{"children":"always write your own adapters on top of third-party libraries and mock those adapters instead of the underlying types."}],"\n",["$","li","li-1",{"children":"only expose features you need from the library"}],"\n",["$","li","li-2",{"children":"do that using your project’s domain language"}],"\n",["$","li","li-3",{"children":"this guideline dose not apply to in-process dependencies. There is no need to abstract in-memory or managed dependencies. Similarly, there’s no need to abstract an ORM as long as it’s used for accessing a database that isn’t visible to external applications."}],"\n"]}],"\n"]}],"\n"]}]
