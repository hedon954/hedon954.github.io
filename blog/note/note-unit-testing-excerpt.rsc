 task."}],"\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":"They grow effortlessly, don’t require much maintenance, and can quickly adapt to their customers’ ever-changing needs."}],"\n"]}],"\n",["$","p","p-1",{"children":["The ratio between the production code and the test code could be anywhere between ",["$","code","code-0",{"className":"$undefined","children":"1:1"}]," and ",["$","code","code-1",{"className":"$undefined","children":"1:3"}],"."]}],"\n",["$","h2","h2-0",{"id":"coverage-limitations","children":["$","a","a-0",{"href":"#coverage-limitations","node":{"type":"element","tagName":"a","properties":{"href":"#coverage-limitations"},"children":[{"type":"text","value":"Coverage limitations","position":{"start":{"line":7,"column":4,"offset":639},"end":{"line":7,"column":24,"offset":659}}}]},"children":"Coverage limitations"}]}],"\n",["$","ul","ul-1",{"children":["\n",["$","li","li-0",{"children":"You can’t guarantee that the test verifies all the possible outcomes of the system under test."}],"\n",["$","li","li-1",{"children":"No coverage metric can take into account code paths in external libraries."}],"\n"]}],"\n",["$","h2","h2-1",{"id":"the-goal-of-unit-testing","children":["$","a","a-0",{"href":"#the-goal-of-unit-testing","node":{"type":"element","tagName":"a","properties":{"href":"#the-goal-of-unit-testing"},"children":[{"type":"text","value":"The goal of unit testing","position":{"start":{"line":12,"column":4,"offset":839},"end":{"line":12,"column":28,"offset":863}}}]},"children":"The goal of unit testing"}]}],"\n",["$","ol","ol-0",{"children":["\n",["$","li","li-0",{"children":"lead to a better code design"}],"\n",["$","li","li-1",{"children":"enable sustainable(可持续的) growth of the software project"}],"\n"]}],"\n",["$","p","p-2",{"children":["$","$L8","img-0",{"src":"https://hedonspace.oss-cn-beijing.aliyuncs.com/img/image.png","alt":"","node":{"type":"element","tagName":"img","properties":{"src":"https://hedonspace.oss-cn-beijing.al