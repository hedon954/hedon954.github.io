2b:["$","pre","pre-5",{"data-language":"SQL","children":["$","code","code-0",{"className":"hljs language-SQL","children":["USE order_db;\n\n",["$","span","span-0",{"className":"hljs-comment","children":"-- 模拟：给用户 10086 充值 100 块 (10000分)"}],"\n",["$","span","span-1",{"className":"hljs-keyword","children":"UPDATE"}]," user_balance ",["$","span","span-2",{"className":"hljs-keyword","children":"SET"}]," balance ",["$","span","span-3",{"className":"hljs-operator","children":"="}]," balance ",["$","span","span-4",{"className":"hljs-operator","children":"+"}]," ",["$","span","span-5",{"className":"hljs-number","children":"10000"}]," ",["$","span","span-6",{"className":"hljs-keyword","children":"WHERE"}]," uid ",["$","span","span-7",{"className":"hljs-operator","children":"="}]," ",["$","span","span-8",{"className":"hljs-number","children":"10086"}],";\n"]}]}]
