ext","value":"1. 宏观概述","position":{"start":{"line":5,"column":4,"offset":149},"end":{"line":5,"column":11,"offset":156}}}]},"children":"1. 宏观概述"}]}],"\n",["$","h3","h3-0",{"id":"11-背景与痛点","children":["$","a","a-0",{"href":"#11-背景与痛点","node":{"type":"element","tagName":"a","properties":{"href":"#11-背景与痛点"},"children":[{"type":"text","value":"1.1 背景与痛点","position":{"start":{"line":7,"column":5,"offset":162},"end":{"line":7,"column":14,"offset":171}}}]},"children":"1.1 背景与痛点"}]}],"\n",["$","p","p-2",{"children":"为什么我们需要 Online DDL？"}],"\n",["$","p","p-3",{"children":"在 MySQL 5.6 之前，大多数 DDL 操作（如添加索引、添加列）的本质是暴力重构。MySQL 会执行以下步骤："}],"\n",["$","ol","ol-0",{"children":["\n",["$","li","li-0",{"children":"创建一个新的临时表（新结构）。"}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"锁住原表"}],"（禁止写入）。"]}],"\n",["$","li","li-2",{"children":"将原表数据一行行复制到新表。"}],"\n",["$","li","li-3",{"children":"删除原表，重命名新表。"}],"\n"]}],"\n",["$","p","p-4",{"children":["这种方式被称为 ",["$","strong","strong-0",{"children":"Copy Table"}]," 方式。它的痛点极其明显：在数据量大的表中，DDL 可能运行数小时，期间业务无法写入，这对于高并发互联网应用是灾难性的。"]}],"\n",["$","p","p-5",{"children":["为了解决这个问题，MySQL 逐步引入了 ",["$","strong","strong-0",{"children":"In-Place"}]," 和",["$","strong","strong-1",{"children":"Instant"}]," 算法，统称为 Online DDL。"]}],"\n",["$","h3","h3-1",{"id":"12-从-copy-到-instant","children":["$","a","a-0",{"href":"#12-从-copy-到-instant","node":{"type":"element","tagName":"a","properties":{"href":"#12-从-copy-到-instant"},"children":[{"type":"text","value":"1.2 从 Copy 到 Instant","position":{"start":{"line":22,"column":5,"offset":482},"end":{"line":22,"column":25,"offset":502}}}]},"children":"1.2 从 Copy 到 Instant"}]}],"\n",["$","p","p-6",{"children":"理解 Online DDL 的关键在于理解三种算法的演进，这是一个由重到轻的过程："}],"\n",["$","h4","h4-0",{"id":"121-copymysql-56-之前","children":["$","a","a-0",{"href":"#121-copymysql-56-之前","node":{"type":"element","tagName":"a","properties":{"href":"#121-copymysql-56-之前"},"children":[{"type":"text","value":"1.2.1 COPY（MySQL 5.6 之前）","position":{"start":{"line":26,"column":6,"offset":552},"end":{"line":26,"column":30,"offset":576}}}]},"children":"1.2.1 COPY（MySQL 5.6 之前）"}]}],"\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"原理"}],"：在 Server 层处理，新建表 -> 导数据 -> 删旧表。"]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"代价"}],"：极高。I/O 飙升，占用双倍磁盘空间，",["$","strong","strong-1",{"children":"全程锁表"}],"（无法写入）。"]}],"\n"]}],"\n",["$","h4","h4-1",{"id":"122-inplacemysql-56-引入成熟于-57","children":["$","a","a-0",{"href":"#122-inplacemysql-56-引入成熟于-57","node":{"type":"element","tagName":"a","properties":{"href":"#122-inplacemysql-56-引入成熟于-57"},"children":[{"type":"text","value":"1.2.2 INPLACE（MySQL 5.6 引入，成熟于 5.7）","position":{"start":{"line":31,"column":6,"offset":669},"end":{"line":31,"column":41,"offset":704}}}]},"children":"1.2.2 INPLACE（MySQL 5.6 引入，成熟于 5.7）"}]}],"\n","$L8","\n","$L9","\n","$La","\n","$Lb","\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c","\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27","\n","$L28","\n","$L29","\n","$L2a","\n","$L2b","\n","$L2c","\n","$L2d","\n","$L2e","\n","$L2f","\n","$L30","\n","$L31","\n","$L32","\n","$L33","\n","$L34","\n","$L35","\n","$L36","\n","$L37","\n","$L38","\n","$L39","\n","$L3a","\n","$L3b","\n","$L3c","\n","$L3d","\n","$L3e","\n","$L3f","\n","$L40","\n","$L41","\n","$L42","\n","$L43","\n","$L44","\n","$L45","\n","$L46","\n","$L47","\n","$L48","\n","$L49","\n","$L4a","\n","$L4b","\n","$L4c","\n","$L4d","\n","$L4e","\n","$L4f","\n","$L50","\n","$L51","\n","$L52","\n","$L53","\n","$L54","\n","$L55","\n","$L56","\n","$L57","\n","$L58","\n","$L59","\n","$L5a","\n","$L5b","\n","$L5c","\n","$L5d","\n","$L5e","\n","$L5f","\n","$L60","\n","$L61","\n","$L62","\n","