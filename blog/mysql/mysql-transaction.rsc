1a:["$","blockquote","blockquote-2",{"children":["\n",["$","p","p-0",{"children":["$","span","span-0",{"className":"garden-callout-marker garden-callout-marker--danger","aria-hidden":"true"}]}],"\n",["$","p","p-1",{"children":["$","strong","strong-0",{"children":"简单来说"}]}],"\n",["$","p","p-2",{"children":["先以 Page 为单位记录日志，每个 Page 里面再采取逻辑记法（记录 Page 里面哪一行被修改了）。即",["$","strong","strong-0",{"children":"物理到页，逻辑到行"}],"。"]}],"\n"]}]
