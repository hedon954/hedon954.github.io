19:["$","$L1c",null,{"headings":[{"depth":2,"text":"1. 什么是权重共享？","id":"1-什么是权重共享"},{"depth":2,"text":"2. 为什么要这样做？","id":"2-为什么要这样做"},{"depth":3,"text":"浅层原因：参数效率","id":"浅层原因参数效率"},{"depth":3,"text":"深层原因：泛化能力与语义对称性","id":"深层原因泛化能力与语义对称性"},{"depth":2,"text":"3. 落地实践要点与启示","id":"3-落地实践要点与启示"},{"depth":2,"text":"总结","id":"总结"}]}]
