rut","style":{"height":"2.7482em"}}],["$","span","span-1",{"className":"sizing reset-size3 size1 mtight","children":["$","span","span-0",{"className":"mord mathnormal mtight","style":{"marginRight":"0.0572em"},"children":"j"}]}]]}],["$","span","span-1",{"style":{"top":"-3.1453em","marginRight":"0.0714em"},"children":[["$","span","span-0",{"className":"pstrut","style":{"height":"2.7482em"}}],["$","span","span-1",{"className":"sizing reset-size3 size1 mtight","children":["$","span","span-0",{"className":"mord mtight","children":["$","span","span-0",{"className":"mord mtight","children":[["$","span","span-0",{"className":"mord mathnormal mtight","children":"e"}],["$","span","span-1",{"className":"msupsub","children":"$L6b"}]]}]}]}]]}]]}],"$L6c"]}],"$L6d"]}]}]]}]}]}]]}],"$L6e","$L6f"]}],"$L70"]}],"$L71"]}]}],"$L72"]}]]}]]}]]}],"， (其中 ","$L73"," 是第 ","$L74"," 个类别的 Logit)。","$L75"," 就是经过 Softmax 转换后的概率分布。"]}]
48:["$","p","p-38",{"children":["$","strong","strong-0",{"children":"步骤 3：Target probabilities（目标概率）"}]}]
49:["$","p","p-39",{"children":["这一步的核心是从模型的预测中，提取出与真实答案相对应的概率值。在理论上，我们用独热编码（One-Hot Encoding）来表示真实标签，例如 ",["$","code","code-0",{"className":"$undefined","children":"[0, 1, 0, ...]"}],"。图片中的 ",["$","code","code-1",{"className":"$undefined","children":"[7.4541e-05, ...]"}]," 正是模型根据这个独热编码所指示的正确索引，给出的预测概率。这些值通常很小，因为在训练初期，模型对正确答案的预测能力还很弱。在计算交叉熵时，我们只关心真实类别对应的预测概率。"]}]
4a:["$","p","p-40",{"children":["$","strong","strong-0",{"children":"步骤 4：Log probabilities（对数概率）"}]}]
4b:["$","p","p-41",{"children":["这一步是计算每个目标概率值的自然对数，即 ",["$","span","span-0",{"className":"katex","children":[["$","span","span-0",{"className":"katex-mathml","children":["$","math","math-0",{"xmlns":"http://www.w3.org/1998/Math/MathML","children":["$","semantics","semantics-0",{"children":[["$","mrow","mrow-0",{"children":[["$","mi","mi-0",{"children":"l"}],["$","mi","mi-1",{"children":"o"}],["$","mi","mi-2",{"children":"g"}],["$","mo","mo-0",{"stretchy":"false","children":"("}],["$","msub","msub-0",{"children":[["$","mi","mi-0",{"children":"q"}],["$","mi","mi-1",{"children":"i"}]]}],["$","mo","mo-1",{"stretchy":"false","children":")"}]]}],["$","annotation","annotation-0",{"encoding":"application/x-tex","children":"log(q_i)"}]]}]}]}],["$","span","span-1",{"className":"katex-html","aria-hidden":"true","children":["$","span","span-0",{"className":"base","children":[["$","span","span-0",{"className":"strut","style":{"height":"1em","verticalAlign":"-0.25em"}}],["$","span","span-1",{"className":"mord mathnormal","style":{"marginRight":"0.0197em"},"children":"l"}],["$","span","span-2",{"className":"mord mathnormal","children":"o"}],["$","span","span-3",{"className":"mord mathnormal","style":{"marginRight":"0.0359em"},"children":"g"}],["$","span","span-4",{"className":"mopen","children":"("}],["$","span","span-5",{"className":"mord","children":[["$","span","span-0",{"className":"mord mathnormal","style":{"marginRight":"0.0359em"},"children":"q"}],["$","span","span-1",{"className":"msupsub","children":["$","span","span-0",{"className":"vlist-t vlist-t2","children":[["$","span","span-0",{"className":"vlist-r","children":[["$","span","span-0",{"className":"vlist","style":{"height":"0.3117em"},"children":["$","span","span-0",{"style":{"top":"-2.55em","marginLeft":"-0.0359em","marginRight":"0.05em"},"children":[["$","span","span-0",{"className":"pstrut","style":{"height":"2.7em"}}],["$","span","span-1",{"className":"sizing reset-size6 size3 mtight","children":["$","span","span-0",{"className":"mord mathnormal mtight","children":"i"}]}]]}]}],["$","span","span-1",{"className":"vlist-s","children":"​"}]]}],["$","span","span-1",{"className":"vlist-r","children":["$","span","span-0",{"className":"vlist","style":{"height":"0.15em"},"children":["$","span","span-0",{}]}]}]]}]}]]}],["$","span","span-6",{"className":"mclose","children":")"}]]}]}]]}],"。例如，",["$","code","code-0",{"className":"$undefined","children":"[-9.5042, -10.3796, -11.3677, ...]"}]," 就是对目标概率取自然对数的结果。"]}]
4c:["$","p","p-42",{"children":["$","strong","strong-0",{"children":"步骤 5：Average log probability（平均对数概率）"}]}]
4d:["$","p","p-43",{"children":["这一步是计算",["$","strong","strong-0",{"children":"所有对数概率的平均值"}],"。在步骤 4 中，我们已经得到了模型对每个正确答案的预测概率的对数值。这一步就是将这些值加起来，然后除以样本或序列的长度，以得到一个平均值。"]}]
4e:["$","p","p-44",{"children":["$","strong","strong-0",{"children":"步骤 6：Negative average log probability（负平均对数概率）"}]}]
4f:["$","p","p-45",{"children":[["$","strong","strong-0",{"children":"这是计算"}],"最终损失值的步骤。在步骤 5 的基础上，我们对平均对数概率取负号。这是为了",["$","strong","strong-1",{"children":"将一个衡量模型错误程度的负数，转换成一个衡量模型错误程度的正数"}],"。这个操作没有复杂的数学含义，它只是为了让损失值的符号符合我们的直觉和约定。损失值越小代表模型表现越好。在图片中，对 ",["$","code","code-0",{"className":"$undefined","children":"-10.7940"}]," 取负号后，得到的值是 ",["$","code","code-1",{"className":"$undefined","children":"10.7940"}],"。这个值就是我们最终要最小化的损失（Loss）。在模型训练中，我们通过反向传播和梯度下降来不断减小这个损失值，从而迫使模型提高对正确答案的预测概率。"]}]
50:["$","blockquote","blockquote-5",{"children":["\n",["$","p","p-0",{"children":["上面 6 个步骤，可以直接使用 pytorch 的 ",["$","code","code-0",{"className":"$undefined","children":"cross_entropy"}]," 计算，一步到位！"]}],"\n"]}]
51:["$","pre","pre-0",{"data-language":"PYTHON","children":["$","code","code-0",{"className":"hljs language-python","children":"loss = torch.nn.functional.cross_entropy(logits_flat, targets_flat)\n"}]}]
52:["$","p","p-46",{"children":"总结一下，整个计算流程可以概括为："}]
53:["$","ol","ol-0",{"children":["\n",["$","li","li-0",{"children":"模型输出原始分数（Logits）。"}],"\n",["$","li","li-1",{"children":"通过 Softmax 函数将分数转换为概率分布。"}],"\n",["$","li","li-2",{"children":"找出真实类别对应的预测概率。"}],"\n",["$","li","li-3",{"children":"对这个概率取负对数，得到损失值。"}],"\n",["$","li","li-4",{"children":"在训练时，我们会对所有样本的损失值求平均，然后进行反向传播更新模型参数。"}],"\n"]}]
54:["$","p","p-47",{"children":["这个计算方式之所以合理，正是因为它完美地结合了信息论和机器学习的目标：",["$","strong","strong-0",{"children":"通过最小化这个损失值，我们实际上是在最大化模型对正确类别的预测概率，从而让模型的预测分布越来越接近真实的分布。"}]," 这是一种非常高效且理论基础坚实的训练方法。"]}]
