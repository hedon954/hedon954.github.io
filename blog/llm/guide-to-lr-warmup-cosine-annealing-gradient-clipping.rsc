s-number","children":"1"}],"\n\n            ",["$","span","span-16",{"className":"hljs-keyword","children":"if"}]," global_step < warmup_steps:\n                lr = initial_lr + global_step * lr_increment    ",["$","span","span-17",{"className":"hljs-comment","children":"# <---- 学习率预热阶段"}],"\n            ",["$","span","span-18",{"className":"hljs-keyword","children":"else"}],":\n                progress = ((global_step - warmup_steps) /\n                                    (total_training_steps - warmup_steps))\n                lr = min_lr + (peak_lr - min_lr) * ",["$","span","span-19",{"className":"hljs-number","children":"0.5"}]," * (      ",["$","span","span-20",{"className":"hljs-comment","children":"# <---- 余弦衰减阶段"}],"\n                    ",["$","span","span-21",{"className":"hljs-number","children":"1"}]," + math.cos(math.pi * progress))\n            ",["$","span","span-22",{"className":"hljs-keyword","children":"for"}]," param_group ",["$","span","span-23",{"className":"hljs-keyword","children":"in"}]," optimizer.param_groups:  ",["$","span","span-24",{"className":"hljs-comment","children":"# 在优化器上应用计算后的学习率"}],"\n                param_group[",["$","span","span-25",{"className":"hljs-string","children":"\"lr\""}],"] = lr\n            track_lrs.append(lr)\n\n            optimizer.zero_grad()  ",["$","span","span-26",{"className":"hljs-comment","children":"# 清空旧梯度"}],"\n            loss = calc_loss_batch(input_batch, target_batch, model, device) ",["$","span","span-27",{"className":"hljs-comment","children":"# 前向传播计算交叉熵损失"}],"\n            loss.backward() ",["$","span","span-28",{"className":"hljs-comment","children":"# 反向传播计算梯度"}],"\n            ",["$","span","span-29",{"className":"hljs-keyword","children":"if"}]," global_step >= warmup_steps: ",["$","span","span-30",{"className":"hljs-comment","children":"# <--- 在预热阶段后使用梯度裁剪来避免梯度爆炸"}],"\n                torch.nn.utils.clip_grad_norm_(\n                    model.parameters(), max_norm=","$L6d","\n           