50:["$","p","p-42",{"children":["完整代码可参考：",["$","a","a-0",{"href":"https://github.com/hedon-ai-road/llm-from-scratch/blob/main/5-%E8%AE%AD%E7%BB%83%E5%A4%A7%E6%A8%A1%E5%9E%8B.ipynb","node":{"type":"element","tagName":"a","properties":{"href":"https://github.com/hedon-ai-road/llm-from-scratch/blob/main/5-%E8%AE%AD%E7%BB%83%E5%A4%A7%E6%A8%A1%E5%9E%8B.ipynb"},"children":[{"type":"text","value":"llm-from-scratch","position":{"start":{"line":273,"column":10,"offset":10265},"end":{"line":273,"column":26,"offset":10281}}}],"position":{"start":{"line":273,"column":9,"offset":10264},"end":{"line":273,"column":142,"offset":10397}}},"target":"_blank","rel":"noopener noreferrer","children":"llm-from-scratch"}]]}]
