0:{"__route":"route:/blog/llm/guide-to-lr-warmup-cosine-annealing-gradient-clipping/","__interceptionContext":null,"__layoutIds":["layout:/"],"__rootLayout":"/","page:/blog/llm/guide-to-lr-warmup-cosine-annealing-gradient-clipping/":"$L1","layout:/":[[[["$","link","css:/assets/index-BlvdgL5Z.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-BlvdgL5Z.css","data-rsc-css-href":"/assets/index-BlvdgL5Z.css"}],"$undefined"],["$","html",null,{"lang":"zh-CN","suppressHydrationWarning":true,"children":[["$","head",null,{"children":["$undefined","$undefined"]}],["$","body",null,{"className":"__variable_geist_mono_1diim1n","children":[["$","a",null,{"className":"skip-link","href":"#main-content","children":"跳到正文"}],["$","$L2",null,{"children":["$","$L3",null,{}]}]]}]]}]],null],"route:/blog/llm/guide-to-lr-warmup-cosine-annealing-gradient-clipping/":[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"模型训练核心技巧：学习率预热、余弦衰减与梯度裁剪 · Hedon Garden"}],["$","meta","1",{"name":"description","content":"本篇深入探讨了深度学习训练中的三大核心优化技巧，学习率预热解决训练初期不稳定性，余弦衰减实现精细调整和平滑收敛，梯度裁剪防止梯度爆炸。从原理到实践，全面解析如何让模型在高维损失空间中更稳定、更高效地找到最优解。"}],["$","meta","2",{"name":"author","content":"Hedon"}],["$","link","3",{"rel":"author","href":"https://github.com/hedon954"}],["$","meta","4",{"name":"robots","content":"index, follow"}],["$","meta","5",{"name":"googlebot","content":"index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}],["$","meta","6",{"property":"og:title","content":"模型训练核心技巧：学习率预热、余弦衰减与梯度裁剪"}],["$","meta","7",{"property":"og:description","content":"本篇深入探讨了深度学习训练中的三大核心优化技巧，学习率预热解决训练初期不稳定性，余弦衰减实现精细调整和平滑收敛，梯度裁剪防止梯度爆炸。从原理到实践，全面解析如何让模型在高维损失空间中更稳定、更高效地找到最优解。"}],["$","meta","8",{"property":"og:url","content":"https://hedon.top/blog/llm/guide-to-lr-warmup-cosine-annealing-gradient-clipping"}],["$","meta","9",{"property":"og:type","content":"article"}],["$","meta","10",{"property":"article:published_time","content":"2025-08-21T15:30:20.000Z"}],["$","meta","11",{"property":"og:image","content":"https://hedon.top/hedonspace/banner/guide-to-lr-warmup-cosine-annealing-gradient-clipping.jpg"}],["$","meta","12",{"property":"og:image:alt","content":"模型训练核心技巧：学习率预热、余弦衰减与梯度裁剪 的文章封面"}],["$","meta","13",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","14",{"name":"twitter:title","content":"模型训练核心技巧：学习率预热、余弦衰减与梯度裁剪"}],["$","meta","15",{"name":"twitter:description","content":"本篇深入探讨了深度学习训练中的三大核心优化技巧，学习率预热解决训练初期不稳定性，余弦衰减实现精细调整和平滑收敛，梯度裁剪防止梯度爆炸。从原理到实践，全面解析如何让模型在高维损失空间中更稳定、更高效地找到最优解。"}],["$","meta","16",{"name":"twitter:image","content":"https://hedon.top/hedonspace/banner/guide-to-lr-warmup-cosine-annealing-gradient-clipping.jpg"}],["$","link","17",{"rel":"icon","href":"https://hedon.top/favicon.svg"}],["$","link","18",{"rel":"canonical","href":"https://hedon.top/blog/llm/guide-to-lr-warmup-cosine-annealing-gradient-clipping"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L4",null,{"segmentMap":{"children":["blog","llm/guide-to-lr-warmup-cosine-annealing-gradient-clipping"]},"children":["$","$L5",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$L6",null,{"children":["$","$L4",null,{"segmentMap":{"children":[]},"children":["$","$L5",null,{"id":"page:/blog/llm/guide-to-lr-warmup-cosine-annealing-gradient-clipping/"}]}]}]}]}]],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:1url7xrgffgzg","deploymentVersion":"42ea885b-ba92-4c44-8068-a1dcfe71a16b","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}
