a:["$","tr","tr-3",{"children":[["$","td","td-0",{"children":["$","strong","strong-0",{"children":"最终产品"}]}],["$","td","td-1",{"children":["$","strong","strong-0",{"children":"网络的预测输出 (Prediction)"}]}],["$","td","td-2",{"children":"比如，给一张猫的图片，网络输出 “90% 是狗”。"}]]}]
b:["$","tr","tr-4",{"children":[["$","td","td-0",{"children":["$","strong","strong-0",{"children":"设计图纸"}]}],["$","td","td-1",{"children":["$","strong","strong-0",{"children":"真实标签 (True Label)"}]}],["$","td","td-2",{"children":"正确答案，比如 “100% 是猫”。"}]]}]
c:["$","tr","tr-5",{"children":[["$","td","td-0",{"children":["$","strong","strong-0",{"children":"产品偏差"}]}],["$","td","td-1",{"children":["$","strong","strong-0",{"children":"损失/误差 (Loss / Error)"}]}],["$","td","td-2",{"children":["预测输出和真实标签之间的差距。由",["$","strong","strong-0",{"children":"损失函数 (Loss Function)"}]," 计算得出。"]}]]}]
d:["$","tr","tr-6",{"children":[["$","td","td-0",{"children":["$","strong","strong-0",{"children":"从后往前追责分锅"}]}],["$","td","td-1",{"children":["$","strong","strong-0",{"children":"反向传播 (Backpropagation)"}]}],["$","td","td-2",{"children":"将总误差从输出层开始，一层层向输入层传播，计算出每一层权重对总误差的“贡献度”。"}]]}]
e:["$","tr","tr-7",{"children":[["$","td","td-0",{"children":["$","strong","strong-0",{"children":"调整机器参数"}]}],["$","td","td-1",{"children":["$","strong","strong-0",{"children":"权重更新 (Weight Update)"}]}],["$","td","td-2",{"children":["使用一种叫做",["$","strong","strong-0",{"children":"梯度下降 (Gradient Descent)"}]," 的方法，根据计算出的“贡献度”来微调网络中所有的权重，目的是让总误差变小。"]}]]}]
f:["$","h3","h3-2",{"id":"三核心工具微积分里的-链式法则","children":["$","a","a-0",{"href":"#三核心工具微积分里的-链式法则","node":{"type":"element","tagName":"a","properties":{"href":"#三核心工具微积分里的-链式法则"},"children":[{"type":"text","value":"三、核心工具：微积分里的 “链式法则”","position":{"start":{"line":29,"column":5,"offset":2246},"end":{"line":29,"column":24,"offset":2265}}}]},"children":"三、核心工具：微积分里的 “链式法则”"}]}]
10:["$","p","p-3",{"children":"你可能会问，每个工人是怎么精确计算出他应该背多大的“锅”呢？"}]
11:["$","p","p-4",{"children":["这里的“锅”在数学上，就是 ",["$","strong","strong-0",{"children":"梯度 (Gradient)"}],"，简单理解就是",["$","strong","strong-1",{"children":"导数"}],"。导数衡量的是 “如果我稍微动一下这个参数，最终的误差会改变多少”。"]}]
12:["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":"如果导数很大 (无论是正还是负)，说明这个参数对最终误差的影响很大，是“主要责任人”，需要大幅调整。"}],"\n",["$","li","li-1",{"children":"如果导数很小，接近 0，说明它基本没啥影响，是“吃瓜群众”，基本不用动。"}],"\n"]}]
13:["$","p","p-5",{"children":["反向传播算法的数学精髓，就是应用了微积分里的 ",["$","strong","strong-0",{"children":"链式法则 (Chain Rule)"}],"。"]}]
14:["$","p","p-6",{"children":[["$","strong","strong-0",{"children":"链式法则通俗解释"}],"：如果 C 的变化依赖于 B，而 B 的变化又依赖于 A，那么链式法则可以帮助我们计算出 A 的微小变化最终会对 C 产生多大的影响。"]}]
15:["$","p","p-7",{"children":["在神经网络里，最终的误差 (Loss) 是输出层 (Output Layer) 的函数，输出层又是前一个隐藏层 (Hidden Layer) 的函数，以此类推，直到输入层。反向传播正是利用链式法则，高效地计算出 ",["$","strong","strong-0",{"children":"总误差"}]," 相对于",["$","strong","strong-1",{"children":"网络中每一个权重"}],"的梯度 (导数)。它就像一套完美的公式，能精确地把“锅”不多不少、恰如其分地分配给每一个相关的参数。"]}]
16:["$","h3","h3-3",{"id":"四总结反向传播的完整流程","children":["$","a","a-0",{"href":"#四总结反向传播的完整流程","node":{"type":"element","tagName":"a","properties":{"href":"#四总结反向传播的完整流程"},"children":[{"type":"text","value":"四、总结：反向传播的完整流程","position":{"start":{"line":44,"column":5,"offset":2785},"end":{"line":44,"column":19,"offset":2799}}}]},"children":"四、总结：反向传播的完整流程"}]}]
17:["$","p","p-8",{"children":"所以，神经网络的学习过程（训练）可以总结为以下循环往复的步骤："}]
18:["$","ol","ol-1",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"正向传播 (Forward Pass)"}],"：\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":"给网络一个输入数据 (例如一张图片)。"}],"\n",["$","li","li-1",{"children":"数据从输入层开始，经过每一层神经元的计算 (乘以权重，加上偏置，再通过激活函数)，最后到达输出层，得到一个预测结果。"}],"\n",["$","li","li-2",{"children":"这就像把原材料放上传送带，走完整条流水线，得到最终产品。"}],"\n"]}],"\n"]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"计算损失 (Calculate Loss)"}],"：\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":"用损失函数比较网络的预测结果和真实的正确答案，计算出它们之间的差距，即总误差 (Loss)。"}],"\n",["$","li","li-1",{"children":"这就像质检员检查最终产品，看它和设计图纸差了多少。"}],"\n"]}],"\n"]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"反向传播 (Backward Pass / Backpropagation)"}],"：\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":["这是最关键的一步。从总误差出发，利用链式法则，从输出层开始，反向逐层计算出网络中 ",["$","strong","strong-0",{"children":"每一个权重"}]," 对这个总误差的“贡献度”(梯度)。"]}],"\n",["$","li","li-1",{"children":"这就像 CEO 拿着质检报告，从后往前追责，精确地给每个工序“分锅”。"}],"\n"]}],"\n"]}],"\n",["$","li","li-3",{"children":[["$","strong","strong-0",{"children":"更新权重 (Update Weights)"}],"：\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":["根据反向传播计算出的“贡献度”(梯度)，使用梯度下降等优化算法，对网络中所有的权重进行微小的调整。调整的方向是 ",["$","strong","strong-0",{"children":"让总误差变小"}]," 的方向。"]}],"\n",["$","li","li-1",{"children":"这就像每个工人接到“整改通知”后，都去微调自己的机器旋钮。"}],"\n"]}],"\n"]}],"\n"]}]
19:["$","p","p-9",{"children":"通过成千上万次地重复以上 4 个步骤，网络中的所有权重会逐渐被调整到最优状态，使得网络在接收新的输入时，能够做出非常准确的预测。"}]
1a:["$","p","p-10",{"children":["简单来说，",["$","strong","strong-0",{"children":"反向传播就是神经网络高效学习的秘诀，它通过一个巧妙的“从后往前分锅”机制，告诉网络里的每一个参数应该如何自我调整，才能让最终的预测结果越来越准。"}]]}]
