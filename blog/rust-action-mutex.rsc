35:["$","blockquote","blockquote-0",{"children":["\n",["$","p","p-0",{"children":["不过笔者在做 benchmark 后发现书中的实现性能其实更高，在 macbook m2max 机器上，书中的版本要比我的版本快 5~10% 左右，猜测大概率是 ",["$","code","code-0",{"className":"$undefined","children":"swap"}]," 的性能要比 ",["$","code","code-1",{"className":"$undefined","children":"compare_exchange"}]," 高。"]}],"\n"]}]
