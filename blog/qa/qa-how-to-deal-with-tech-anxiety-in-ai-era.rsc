0:{"__route":"route:/blog/qa/qa-how-to-deal-with-tech-anxiety-in-ai-era/","__interceptionContext":null,"__layoutIds":["layout:/"],"__rootLayout":"/","page:/blog/qa/qa-how-to-deal-with-tech-anxiety-in-ai-era/":"$L1","layout:/":[[[["$","link","css:/assets/index-BlvdgL5Z.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-BlvdgL5Z.css","data-rsc-css-href":"/assets/index-BlvdgL5Z.css"}],"$undefined"],["$","html",null,{"lang":"zh-CN","suppressHydrationWarning":true,"children":[["$","head",null,{"children":["$undefined","$undefined"]}],["$","body",null,{"className":"__variable_geist_mono_1diim1n","children":[["$","a",null,{"className":"skip-link","href":"#main-content","children":"跳到正文"}],["$","$L2",null,{"children":["$","$L3",null,{}]}]]}]]}]],null],"route:/blog/qa/qa-how-to-deal-with-tech-anxiety-in-ai-era/":[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Q&A丨在 AI 时代，如何应对技术焦虑？ · Hedon Garden"}],["$","meta","1",{"name":"description","content":"本文探讨了在 AI 时代如何应对技术焦虑的问题。通过分析底层技术学习的必要性，提出了\"原则重于工具\"的核心观点，并构建了包含 T 型知识结构、时间盒管理、即时学习等策略的系统性解决方案，帮助工程师在技术海洋中找到方向，从焦虑走向成长。"}],["$","meta","2",{"name":"author","content":"Hedon"}],["$","link","3",{"rel":"author","href":"https://github.com/hedon954"}],["$","meta","4",{"name":"robots","content":"index, follow"}],["$","meta","5",{"name":"googlebot","content":"index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}],["$","meta","6",{"property":"og:title","content":"Q&A丨在 AI 时代，如何应对技术焦虑？"}],["$","meta","7",{"property":"og:description","content":"本文探讨了在 AI 时代如何应对技术焦虑的问题。通过分析底层技术学习的必要性，提出了\"原则重于工具\"的核心观点，并构建了包含 T 型知识结构、时间盒管理、即时学习等策略的系统性解决方案，帮助工程师在技术海洋中找到方向，从焦虑走向成长。"}],["$","meta","8",{"property":"og:url","content":"https://hedon.top/blog/qa/qa-how-to-deal-with-tech-anxiety-in-ai-era"}],["$","meta","9",{"property":"og:type","content":"article"}],["$","meta","10",{"property":"article:published_time","content":"2025-06-21T03:06:00.000Z"}],["$","meta","11",{"property":"og:image","content":"https://hedon.top/hedonspace/banner/qa-how-to-deal-with-tech-anxiety-in-ai-era.jpg"}],["$","meta","12",{"property":"og:image:alt","content":"Q&A丨在 AI 时代，如何应对技术焦虑？ 的文章封面"}],["$","meta","13",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","14",{"name":"twitter:title","content":"Q&A丨在 AI 时代，如何应对技术焦虑？"}],["$","meta","15",{"name":"twitter:description","content":"本文探讨了在 AI 时代如何应对技术焦虑的问题。通过分析底层技术学习的必要性，提出了\"原则重于工具\"的核心观点，并构建了包含 T 型知识结构、时间盒管理、即时学习等策略的系统性解决方案，帮助工程师在技术海洋中找到方向，从焦虑走向成长。"}],["$","meta","16",{"name":"twitter:image","content":"https://hedon.top/hedonspace/banner/qa-how-to-deal-with-tech-anxiety-in-ai-era.jpg"}],["$","link","17",{"rel":"icon","href":"https://hedon.top/favicon.svg"}],["$","link","18",{"rel":"canonical","href":"https://hedon.top/blog/qa/qa-how-to-deal-with-tech-anxiety-in-ai-era"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L4",null,{"segmentMap":{"children":["blog","qa/qa-how-to-deal-with-tech-anxiety-in-ai-era"]},"children":["$","$L5",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$L6",null,{"children":["$","$L4",null,{"segmentMap":{"children":[]},"children":["$","$L5",null,{"id":"page:/blog/qa/qa-how-to-deal-with-tech-anxiety-in-ai-era/"}]}]}]}]}]],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:1url7xrgffgzg","deploymentVersion":"42ea885b-ba92-4c44-8068-a1dcfe71a16b","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}
