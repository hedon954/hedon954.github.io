3c:["$","ol","ol-13",{"children":["\n",["$","li","li-0",{"children":"计算机理论与编程范式：《计算机程序的构造和解释》。"}],"\n",["$","li","li-1",{"children":"编译器与语言原理：《用 go 语言自制解释器》、《用 go 语言自制编译器》。"}],"\n",["$","li","li-2",{"children":"算法与数据结构：《业务开发算法 50 讲》、《数据结构与算法之美》。"}],"\n",["$","li","li-3",{"children":"操作系统：《手写 OS》、《Writing an OS in Rust》。"}],"\n",["$","li","li-4",{"children":"软件工艺：《程序员的修炼：从优秀到卓越》。"}],"\n"]}]
