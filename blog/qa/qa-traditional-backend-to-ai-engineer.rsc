9b:["$","$L9e",null,{"headings":[{"depth":2,"text":"术","id":"术"},{"depth":3,"text":"一、AI 时代的基础架构转变","id":"一ai-时代的基础架构转变"},{"depth":4,"text":"1.1 从同步请求/响应到异步任务编排","id":"11-从同步请求响应到异步任务编排"},{"depth":5,"text":"任务队列架构","id":"任务队列架构"},{"depth":5,"text":"结果交付机制","id":"结果交付机制"},{"depth":5,"text":"异步系统中的韧性设计","id":"异步系统中的韧性设计"},{"depth":4,"text":"1.2 在分布式、对话式世界中管理状态","id":"12-在分布式对话式世界中管理状态"},{"depth":5,"text":"外部化状态存储","id":"外部化状态存储"},{"depth":5,"text":"权衡分析：粘性会话","id":"权衡分析粘性会话"},{"depth":5,"text":"对话历史摘要","id":"对话历史摘要"},{"depth":4,"text":"1.3 为概率性系统设计韧性和可观测性","id":"13-为概率性系统设计韧性和可观测性"},{"depth":5,"text":"面向 LLM 的可观测性技术栈","id":"面向-llm-的可观测性技术栈"},{"depth":5,"text":"优雅降级模式","id":"优雅降级模式"},{"depth":5,"text":"\"失败\"定义的演进","id":"失败定义的演进"},{"depth":3,"text":"二、数据层的重构：为 AI 设计存储于检索","id":"二数据层的重构为-ai-设计存储于检索"},{"depth":4,"text":"2.1 关系型数据库（MySQL/Postgres）：AI 的记忆系统","id":"21-关系型数据库mysqlpostgresai-的记忆系统"},{"depth":4,"text":"2.2 内存数据库（Redis）：AI 的工作记忆","id":"22-内存数据库redisai-的工作记忆"},{"depth":4,"text":"2.3 RAG 摄入流水线：数据密集型设计的案例研究","id":"23-rag-摄入流水线数据密集型设计的案例研究"},{"depth":3,"text":"三、神经系统：使用 Kafka 进行异步处理","id":"三神经系统使用-kafka-进行异步处理"},{"depth":4,"text":"3.1 Kafka 作为 RAG 和微调流水线的支柱","id":"31-kafka-作为-rag-和微调流水线的支柱"},{"depth":4,"text":"3.2 为 LLM 工作负载设计 Kafka","id":"32-为-llm-工作负载设计-kafka"},{"depth":4,"text":"3.3 从服务解耦到智能体编排","id":"33-从服务解耦到智能体编排"},{"depth":3,"text":"四、高性能实现：Go 与 Rust","id":"四高性能实现go-与-rust"},{"depth":4,"text":"4.1 Go：并发 AI 编排语言","id":"41-go并发-ai-编排语言"},{"depth":4,"text":"4.2 Rust：高性能推理语言","id":"42-rust高性能推理语言"},{"depth":4,"text":"4.3 Go/Rust 协同工作的多语言架构","id":"43-gorust-协同工作的多语言架构"},{"depth":3,"text":"五、高级架构范式与综合","id":"五高级架构范式与综合"},{"depth":4,"text":"5.1 驯服不确定性：生产就绪工作流的工具箱","id":"51-驯服不确定性生产就绪工作流的工具箱"},{"depth":4,"text":"5.2 智能体架构的兴起","id":"52-智能体架构的兴起"},{"depth":3,"text":"总结：现代 AI 工程师的融合技能栈","id":"总结现代-ai-工程师的融合技能栈"},{"depth":2,"text":"道","id":"道"},{"depth":3,"text":"法则一：世界观的革命 —— 从确定性到概率性","id":"法则一世界观的革命--从确定性到概率性"},{"depth":3,"text":"法则二：思维的跃迁 —— 从无状态服务到有状态推理","id":"法则二思维的跃迁--从无状态服务到有状态推理"},{"depth":3,"text":"法则三：优化的新方程 —— 从效率到价值","id":"法则三优化的新方程--从效率到价值"},{"depth":3,"text":"法则四：系统的进化 —— 从指令式编排到涌现式生态","id":"法则四系统的进化--从指令式编排到涌现式生态"},{"depth":2,"text":"结论","id":"结论"}]}]
