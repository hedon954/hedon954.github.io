":"Q&A丨AI 视角下的后端技术重塑 的文章封面"}],["$","meta","13",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","14",{"name":"twitter:title","content":"Q&A丨AI 视角下的后端技术重塑"}],["$","meta","15",{"name":"twitter:description","content":"本文跟 Gemini 探讨在 AI 时代下，传统后端工程师如何结合自身优势，转型为 AI 应用开发工程师。"}],["$","meta","16",{"name":"twitter:image","content":"https://hedon.top/hedonspace/banner/qa-traditional-backend-to-ai-engineer.jpg"}],["$","link","17",{"rel":"icon","href":"https://hedon.top/favicon.svg"}],["$","link","18",{"rel":"canonical","href":"https://hedon.top/blog/qa/qa-traditional-backend-to-ai-engineer"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L4",null,{"segmentMap":{"children":["blog","qa/qa-traditional-backend-to-ai-engineer"]},"children":["$","$L5",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$L6",null,{"children":["$","$L4",null,{"segmentMap":{"children":[]},"children":["$","$L5",null,{"id":"page:/blog/qa/qa-traditional-backend-to-ai-engineer/"}]}]}]}]}]],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:1url7xrgffgzg","deploymentVersion":"42ea885b-ba92-4c44-8068-a1dcfe71a16b","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}
