4b:["$","p","p-50",{"children":["是 ",["$","a","a-0",{"href":"https://wuu.wikipedia.org/wiki/Windows_Vista","node":{"type":"element","tagName":"a","properties":{"href":"https://wuu.wikipedia.org/wiki/Windows_Vista"},"children":[{"type":"text","value":"Vista","position":{"start":{"line":176,"column":4,"offset":7634},"end":{"line":176,"column":9,"offset":7639}}}],"position":{"start":{"line":176,"column":3,"offset":7633},"end":{"line":176,"column":56,"offset":7686}}},"target":"_blank","rel":"noopener noreferrer","children":"Vista"}]," 时代引入的新原语，它必须搭配 Critical Section 或 SWR Lock 使用。"]}]
