13:["$","p","p-7",{"children":["在 Unix 类操作系统中，比如 Linux，",["$","code","code-0",{"className":"$undefined","children":"libc"}]," 就承担了跟内核进行交互的标准接口。在 ",["$","code","code-1",{"className":"$undefined","children":"libc"}]," 的基础之前，诞生了一个标准：",["$","em","em-0",{"children":"Portable Operationg System Interface"}],"，即熟知的 ",["$","strong","strong-0",{"children":"POSIX"}],"。在 Rust 中，对应了 ",["$","a","a-0",{"href":"https://crates.io/crates/libc","node":{"type":"element","tagName":"a","properties":{"href":"https://crates.io/crates/libc"},"children":[{"type":"text","value":"libc","position":{"start":{"line":32,"column":139,"offset":1513},"end":{"line":32,"column":143,"offset":1517}}}],"position":{"start":{"line":32,"column":138,"offset":1512},"end":{"line":32,"column":175,"offset":1549}}},"target":"_blank","rel":"noopener noreferrer","children":"libc"}]," crate。"]}]
14:["$","p","p-8",{"children":["Windows 系统并不遵循 POSIX 标准，而是一系列的系统库来提供内核交互能力，比如 ",["$","a","a-0",{"href":"https://www.geoffchappell.com/studies/windows/win32/kernel32/api/index.htm","node":{"type":"element","tagName":"a","properties":{"href":"https://www.geoffchappell.com/studies/windows/win32/kernel32/api/index.htm"},"children":[{"type":"text","value":"kernel32.dll","position":{"start":{"line":34,"column":48,"offset":1605},"end":{"line":34,"column":60,"offset":1617}}}],"position":{"start":{"line":34,"column":47,"offset":1604},"end":{"line":34,"column":137,"offset":1694}}},"target":"_blank","rel":"noopener noreferrer","children":"kernel32.dll"}],"。"]}]
15:["$","p","p-9",{"children":["针对线程操作，POSIX 定义了一系列的数据类型和函数，即所谓的 ",["$","strong","strong-0",{"children":"pthreads"}],"。它提供了以下几个比较重要的并发原语，我将其归纳为一个表格，供你参考。"]}]
