19:["$","$L1c",null,{"headings":[{"depth":2,"text":"架构特性不是越多越好","id":"架构特性不是越多越好"},{"depth":2,"text":"如何识别架构特性","id":"如何识别架构特性"},{"depth":2,"text":"可扩展性 vs 弹性","id":"可扩展性-vs-弹性"}]}]
