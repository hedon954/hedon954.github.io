0:{"__route":"route:/blog/fosa/fosa-ch5/","__interceptionContext":null,"__layoutIds":["layout:/"],"__rootLayout":"/","page:/blog/fosa/fosa-ch5/":"$L1","layout:/":[[[["$","link","css:/assets/index-BlvdgL5Z.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-BlvdgL5Z.css","data-rsc-css-href":"/assets/index-BlvdgL5Z.css"}],"$undefined"],["$","html",null,{"lang":"zh-CN","suppressHydrationWarning":true,"children":[["$","head",null,{"children":["$undefined","$undefined"]}],["$","body",null,{"className":"__variable_geist_mono_1diim1n","children":[["$","a",null,{"className":"skip-link","href":"#main-content","children":"跳到正文"}],["$","$L2",null,{"children":["$","$L3",null,{}]}]]}]]}]],null],"route:/blog/fosa/fosa-ch5/":[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"FOSA丨05丨识别架构特征 · Hedon Garden"}],["$","meta","1",{"name":"description","content":"本篇通过回答《Fundamentals of Software Architecture》第五章的课后思考题，深入探讨如何识别架构特征，分析限制架构特性数量的重要性、架构特性的来源、业务驱动与架构特性的关系，以及可伸缩性与弹性等关键特性的区别，帮助理解如何从业务需求中提取和选择合适的架构特性。"}],["$","meta","2",{"name":"author","content":"Hedon"}],["$","link","3",{"rel":"author","href":"https://github.com/hedon954"}],["$","meta","4",{"name":"robots","content":"index, follow"}],["$","meta","5",{"name":"googlebot","content":"index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}],["$","meta","6",{"property":"og:title","content":"FOSA丨05丨识别架构特征"}],["$","meta","7",{"property":"og:description","content":"本篇通过回答《Fundamentals of Software Architecture》第五章的课后思考题，深入探讨如何识别架构特征，分析限制架构特性数量的重要性、架构特性的来源、业务驱动与架构特性的关系，以及可伸缩性与弹性等关键特性的区别，帮助理解如何从业务需求中提取和选择合适的架构特性。"}],["$","meta","8",{"property":"og:url","content":"https://hedon.top/blog/fosa/fosa-ch5"}],["$","meta","9",{"property":"og:type","content":"article"}],["$","meta","10",{"property":"article:published_time","content":"2025-07-04T10:24:26.000Z"}],["$","meta","11",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","12",{"name":"twitter:title","content":"FOSA丨05丨识别架构特征"}],["$","meta","13",{"name":"twitter:description","content":"本篇通过回答《Fundamentals of Software Architecture》第五章的课后思考题，深入探讨如何识别架构特征，分析限制架构特性数量的重要性、架构特性的来源、业务驱动与架构特性的关系，以及可伸缩性与弹性等关键特性的区别，帮助理解如何从业务需求中提取和选择合适的架构特性。"}],["$","meta","14",{"name":"twitter:image","content":"https://hedon.top/og.png"}],["$","link","15",{"rel":"icon","href":"https://hedon.top/favicon.svg"}],["$","link","16",{"rel":"canonical","href":"https://hedon.top/blog/fosa/fosa-ch5"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L4",null,{"segmentMap":{"children":["blog","fosa/fosa-ch5"]},"children":["$","$L5",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$L6",null,{"children":["$","$L4",null,{"segmentMap":{"children":[]},"children":["$","$L5",null,{"id":"page:/blog/fosa/fosa-ch5/"}]}]}]}]}]],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:1url7xrgffgzg","deploymentVersion":"42ea885b-ba92-4c44-8068-a1dcfe71a16b","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}
