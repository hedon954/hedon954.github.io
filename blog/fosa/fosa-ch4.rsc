ge_image"}],["$","meta","12",{"name":"twitter:title","content":"FOSA丨04丨架构特性定义"}],["$","meta","13",{"name":"twitter:description","content":"本篇通过回答《Fundamentals of Software Architecture》第四章的课后思考题，深入探讨架构特性（Architecture Characteristics）的定义与分类，分析架构特性的三个判定标准、隐性与显性特性的区别，以及操作型、结构型、交叉型特性的具体表现形式，帮助理解如何识别和选择适合系统需求的架构特性。"}],["$","meta","14",{"name":"twitter:image","content":"https://hedon.top/og.png"}],["$","link","15",{"rel":"icon","href":"https://hedon.top/favicon.svg"}],["$","link","16",{"rel":"canonical","href":"https://hedon.top/blog/fosa/fosa-ch4"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L4",null,{"segmentMap":{"children":["blog","fosa/fosa-ch4"]},"children":["$","$L5",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$L6",null,{"children":["$","$L4",null,{"segmentMap":{"children":[]},"children":["$","$L5",null,{"id":"page:/blog/fosa/fosa-ch4/"}]}]}]}]}]],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:1url7xrgffgzg","deploymentVersion":"42ea885b-ba92-4c44-8068-a1dcfe71a16b","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}
