8:["$","strong","strong-0",{"children":"分解为少数几个、逻辑独立的、可独立部署的\"服务\""}]
9:["$","strong","strong-1",{"children":"4 到 12 个"}]
a:["$","h2","h2-1",{"id":"拓扑","children":["$","a","a-0",{"href":"#拓扑","node":{"type":"element","tagName":"a","properties":{"href":"#拓扑"},"children":[{"type":"text","value":"拓扑","position":{"start":{"line":40,"column":4,"offset":1378},"end":{"line":40,"column":6,"offset":1380}}}]},"children":"拓扑"}]}]
