1:["$","main",null,{"className":"reading-page post-reading-page","children":["$","article",null,{"className":"post-article h-entry","children":[["$","$L7",null,{"className":"u-url sr-only","href":"/blog/fosa/fosa-ch2","children":["FOSA丨02丨架构思维"," 永久链接"]}],["$","a",null,{"className":"p-author h-card sr-only","href":"https://github.com/hedon954","rel":"author","children":"Hedon"}],"$undefined",["$","header",null,{"className":"article-header article-summary-row","children":[["$","p",null,{"className":"eyebrow","children":"架构设计"}],["$","h1",null,{"className":"p-name","children":"FOSA丨02丨架构思维"}],["$","p",null,{"className":"article-deck p-summary","children":"本篇通过回答《Fundamentals of Software Architecture》第二章的课后思考题，深入探讨传统架构方法的局限性、知识三角的三个层次、架构师技术广度与深度的平衡，以及架构师保持技术敏锐度的实践方法，帮助理解现代架构师应具备的思维模式。"}],["$","div",null,{"className":"article-meta","children":[["$","time",null,{"className":"dt-published","dateTime":"2025-07-01T11:00:26.000Z","children":["发布于 ","2025/07/01"]}],"$undefined",["$","span",null,{"children":"$undefined"}],["$","span",null,{"children":["约 ","2,466"," 字"]}]]}]]}],["$","div",null,{"className":"article-reading-layout","children":[["$","div",null,{"className":"article-reading-column","children":[["$","div",null,{"className":"e-content","children":["$","div",null,{"className":"markdown-body","children":[["$","p","p-0",{"children":["本系列文章通过逐章回答",["$","a","a-0",{"href":"https://fundamentalsofsoftwarearchitecture.com/","node":{"type":"element","tagName":"a","properties":{"href":"https://fundamentalsofsoftwarearchitecture.com/"},"children":[{"type":"text","value":"《Fundamentals of Software Architecture》","position":{"start":{"line":1,"column":13,"offset":12},"end":{"line":1,"column":52,"offset":51}}}],"position":{"start":{"line":1,"column":12,"offset":11},"end":{"line":1,"column":102,"offset":101}}},"target":"_blank","rel":"noopener noreferrer","children":"《Fundamentals of Software Architecture》"}],"（下文简称 FOSA）一书中的课后思考题，来深入理解书中的核心概念和理论，从而提升我们的软件架构设计能力。本篇为",["$","u","u-0",{"children":"第二章"}],"内容。"]}],"\n",["$","p","p-1",{"children":"本章的课后题是："}],"\n",["$","ol","ol-0",{"children":["\n",["$","li","li-0",{"children":["\n",["$","p","p-0",{"children":"Describe the traditional approach of architecture versus development and explain why that approach no longer works."}],"\n",["$","p","p-1",{"children":"描述传统意义上的架构与开发的方法，并解释为什么这种方法不再适用。"}],"\n"]}],"\n",["$","li","li-1",{"children":["\n",["$","p","p-0",{"children":"List the three levels of knowledge in the knowledge triangle and provide an example of each."}],"\n",["$","p","p-1",{"children":"列出知识三角中的三个层次，并为每个层次提供一个示例。"}],"\n"]}],"\n",["$","li","li-2",{"children":["\n",["$","p","p-0",{"children":"Why is it more important for an architect to focus on technical breadth rather than technical depth?"}],"\n",["$","p","p-1",{"children":"为什么对于一位架构师而言，注重技术的广度而非深度会显得更为重要呢？"}],"\n"]}],"\n",["$","li","li-3",{"children":["\n",["$","p","p-0",{"children":"What are some of the ways of maintaining your technical depth and remaining hands-on as an architect?"}],"\n",["$","p","p-1",{"children":"作为架构师，有哪些方法可以保持技术深度并保持动手能力呢？"}],"\n"]}],"\n"]}],"\n",["$","hr","hr-0",{}],"\n",["$","h2","h2-0",{"id":"1-架构与开发方法","children":["$","a","a-0",{"href":"#1-架构与开发方法","node":{"type":"element","tagName":"a","properties":{"href":"#1-架构与开发方法"},"children":[{"type":"text","value":"1. 架构与开发方法","position":{"start":{"line":23,"column":4,"offset":757},"end":{"line":23,"column":14,"offset":767}}}]},"children":"1. 架构与开发方法"}]}],"\n",["$","p","p-2",{"children":"在传统方法中，架构师与开发人员的职责是分离的，如下图所示："}],"\n",["$","p","p-3",{"children":["$","$L8","img-0",{"src":"https://hedonspace.oss-cn-beijing.aliyuncs.com/img/image-20250701102459269.png","alt":"FOSA Figure 2-1. Traditional view of architecture versus design","node":{"type":"element","tagName":"img","properties":{"src":"https://hedonspace.oss-cn-beijing.aliyuncs.com/img/image-20250701102459269.png","alt":"FOSA Figure 2-1. Traditional view of architecture versus design"},"children":[],"position":{"start":{"line":27,"column":1,"offset":800},"end":{"line":27,"column":147,"offset":946}}}}]}],"\n",["$","p","p-4",{"children":"架构师的职责："}],"\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":"分析业务逻辑，以提取和定义架构特征"}],"\n",["$","li","li-1",{"children":"选择适合问题领域的架构模式和风格"}],"\n",["$","li","li-2",{"children":"创建系统的构建块 —— 组件"}],"\n"]}],"\n",["$","p","p-5",{"children":"开发者的职责："}],"\n",["$","ul","ul-1",{"children":["\n",["$","li","li-0",{"children":"根据架构师交付的产出，创建类图"}],"\n",["$","li","li-1",{"children":"构建用户界面"}],"\n",["$","li","li-2",{"children":"开发和测试源代码"}],"\n"]}],"\n","$L9","\n","$La","\n","$Lb","\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c"]}]}],"$L1d","$L1e","$L1f"]}],"$L20"]}]]}]}]
