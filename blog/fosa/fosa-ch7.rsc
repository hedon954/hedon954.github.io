0:{"__route":"route:/blog/fosa/fosa-ch7/","__interceptionContext":null,"__layoutIds":["layout:/"],"__rootLayout":"/","page:/blog/fosa/fosa-ch7/":"$L1","layout:/":[[[["$","link","css:/assets/index-BlvdgL5Z.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-BlvdgL5Z.css","data-rsc-css-href":"/assets/index-BlvdgL5Z.css"}],"$undefined"],["$","html",null,{"lang":"zh-CN","suppressHydrationWarning":true,"children":[["$","head",null,{"children":["$undefined","$undefined"]}],["$","body",null,{"className":"__variable_geist_mono_1diim1n","children":[["$","a",null,{"className":"skip-link","href":"#main-content","children":"跳到正文"}],["$","$L2",null,{"children":["$","$L3",null,{}]}]]}]]}]],null],"route:/blog/fosa/fosa-ch7/":[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"FOSA丨07丨架构特性范围 · Hedon Garden"}],["$","meta","1",{"name":"description","content":"本篇通过回答《Fundamentals of Software Architecture》第七章的课后思考题，深入探讨架构量子的概念与定义、架构特性的作用范围以及量子边界的识别方法，分析系统组件间的同步依赖关系对架构分解的影响，帮助理解如何基于功能内聚性和部署依赖性来合理划分架构边界，优化系统的可部署性、可测试性和可维护性。"}],["$","meta","2",{"name":"author","content":"Hedon"}],["$","link","3",{"rel":"author","href":"https://github.com/hedon954"}],["$","meta","4",{"name":"robots","content":"index, follow"}],["$","meta","5",{"name":"googlebot","content":"index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}],["$","meta","6",{"property":"og:title","content":"FOSA丨07丨架构特性范围"}],["$","meta","7",{"property":"og:description","content":"本篇通过回答《Fundamentals of Software Architecture》第七章的课后思考题，深入探讨架构量子的概念与定义、架构特性的作用范围以及量子边界的识别方法，分析系统组件间的同步依赖关系对架构分解的影响，帮助理解如何基于功能内聚性和部署依赖性来合理划分架构边界，优化系统的可部署性、可测试性和可维护性。"}],["$","meta","8",{"property":"og:url","content":"https://hedon.top/blog/fosa/fosa-ch7"}],["$","meta","9",{"property":"og:type","content":"article"}],["$","meta","10",{"property":"article:published_time","content":"2025-07-08T11:00:00.000Z"}],["$","meta","11",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","12",{"name":"twitter:title","content":"FOSA丨07丨架构特性范围"}],["$","meta","13",{"name":"twitter:description","content":"本篇通过回答《Fundamentals of Software Architecture》第七章的课后思考题，深入探讨架构量子的概念与定义、架构特性的作用范围以及量子边界的识别方法，分析系统组件间的同步依赖关系对架构分解的影响，帮助理解如何基于功能内聚性和部署依赖性来合理划分架构边界，优化系统的可部署性、可测试性和可维护性。"}],["$","meta","14",{"name":"twitter:image","content":"https://hedon.top/og.png"}],["$","link","15",{"rel":"icon","href":"https://hedon.top/favicon.svg"}],["$","link","16",{"rel":"canonical","href":"https://hedon.top/blog/fosa/fosa-ch7"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L4",null,{"segmentMap":{"children":["blog","fosa/fosa-ch7"]},"children":["$","$L5",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$L6",null,{"children":["$","$L4",null,{"segmentMap":{"children":[]},"children":["$","$L5",null,{"id":"page:/blog/fosa/fosa-ch7/"}]}]}]}]}]],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:1url7xrgffgzg","deploymentVersion":"42ea885b-ba92-4c44-8068-a1dcfe71a16b","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}
