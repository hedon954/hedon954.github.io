2a:["$","section",null,{"className":"comments","aria-labelledby":"comments-heading-fosa/fosa-ch7","children":[["$","div",null,{"className":"comments-heading","children":[["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":23,"height":23,"fill":"currentColor","viewBox":"0 0 256 256","transform":"$undefined","children":[false,"$undefined",["$","path",null,{"d":"M128,24A104,104,0,0,0,36.18,176.88L24.83,210.93a16,16,0,0,0,20.24,20.24l34.05-11.35A104,104,0,1,0,128,24Zm0,192a87.87,87.87,0,0,1-44.06-11.81,8,8,0,0,0-6.54-.67L40,216,52.47,178.6a8,8,0,0,0-.66-6.54A88,88,0,1,1,128,216Z"}]]}],["$","div",null,{"children":[["$","h2",null,{"id":"comments-heading-fosa/fosa-ch7","children":"评论"}],["$","p",null,{"children":"评论由 GitHub Discussions 保存和管理。"}]]}]]}],["$","$L2d",null,{"slug":"fosa/fosa-ch7","config":{"repo":"hedon954/blog-comments","repoId":"R_kgDOTjDfbQ","category":"General","categoryId":"DIC_kwDOTjDfbc4DB7pG"}}]]}]
2b:["$","$L2e",null,{"headings":[{"depth":2,"text":"什么是架构量子？","id":"什么是架构量子"},{"depth":2,"text":"为什么架构量子很重要？","id":"为什么架构量子很重要"},{"depth":2,"text":"场景分析一：单一 UI + 四个独立服务","id":"场景分析一单一-ui--四个独立服务"},{"depth":2,"text":"场景分析二：管理后台 + 用户端","id":"场景分析二管理后台--用户端"},{"depth":3,"text":"这个系统应该被划分为多少个量子？为什么？","id":"这个系统应该被划分为多少个量子为什么"},{"depth":3,"text":"二者可以共享同一个数据库吗？","id":"二者可以共享同一个数据库吗"},{"depth":3,"text":"如果一定要共享，数据库需要驻留在哪个量子中？","id":"如果一定要共享数据库需要驻留在哪个量子中"}]}]
