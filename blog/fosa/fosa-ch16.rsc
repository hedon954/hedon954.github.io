0:{"__route":"route:/blog/fosa/fosa-ch16/","__interceptionContext":null,"__layoutIds":["layout:/"],"__rootLayout":"/","page:/blog/fosa/fosa-ch16/":"$L1","layout:/":[[[["$","link","css:/assets/index-BlvdgL5Z.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-BlvdgL5Z.css","data-rsc-css-href":"/assets/index-BlvdgL5Z.css"}],"$undefined"],["$","html",null,{"lang":"zh-CN","suppressHydrationWarning":true,"children":[["$","head",null,{"children":["$undefined","$undefined"]}],["$","body",null,{"className":"__variable_geist_mono_1diim1n","children":[["$","a",null,{"className":"skip-link","href":"#main-content","children":"跳到正文"}],["$","$L2",null,{"children":["$","$L3",null,{}]}]]}]]}]],null],"route:/blog/fosa/fosa-ch16/":[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"FOSA丨16丨面向服务架构 · Hedon Garden"}],["$","meta","1",{"name":"description","content":"本篇通过回答《Fundamentals of Software Architecture》第十六章的课后思考题，深入探讨面向服务架构的历史驱动力与核心理念、四种主要服务类型的特征与职责、SOA衰落的关键因素分析，以及技术分层与领域分层的架构特性、领域复用与操作复用的实现机制，帮助理解面向服务架构的企业级设计原理和服务编排思想，提升架构师在构建大型企业系统时的服务化架构选择能力和SOA设计水平。"}],["$","meta","2",{"name":"author","content":"Hedon"}],["$","link","3",{"rel":"author","href":"https://github.com/hedon954"}],["$","meta","4",{"name":"robots","content":"index, follow"}],["$","meta","5",{"name":"googlebot","content":"index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}],["$","meta","6",{"property":"og:title","content":"FOSA丨16丨面向服务架构"}],["$","meta","7",{"property":"og:description","content":"本篇通过回答《Fundamentals of Software Architecture》第十六章的课后思考题，深入探讨面向服务架构的历史驱动力与核心理念、四种主要服务类型的特征与职责、SOA衰落的关键因素分析，以及技术分层与领域分层的架构特性、领域复用与操作复用的实现机制，帮助理解面向服务架构的企业级设计原理和服务编排思想，提升架构师在构建大型企业系统时的服务化架构选择能力和SOA设计水平。"}],["$","meta","8",{"property":"og:url","content":"https://hedon.top/blog/fosa/fosa-ch16"}],["$","meta","9",{"property":"og:type","content":"article"}],["$","meta","10",{"property":"article:published_time","content":"2025-07-22T11:02:00.000Z"}],["$","meta","11",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","12",{"name":"twitter:title","content":"FOSA丨16丨面向服务架构"}],["$","meta","13",{"name":"twitter:description","content":"本篇通过回答《Fundamentals of Software Architecture》第十六章的课后思考题，深入探讨面向服务架构的历史驱动力与核心理念、四种主要服务类型的特征与职责、SOA衰落的关键因素分析，以及技术分层与领域分层的架构特性、领域复用与操作复用的实现机制，帮助理解面向服务架构的企业级设计原理和服务编排思想，提升架构师在构建大型企业系统时的服务化架构选择能力和SOA设计水平。"}],["$","meta","14",{"name":"twitter:image","content":"https://hedon.top/og.png"}],["$","link","15",{"rel":"icon","href":"https://hedon.top/favicon.svg"}],["$","link","16",{"rel":"canonical","href":"https://hedon.top/blog/fosa/fosa-ch16"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L4",null,{"segmentMap":{"children":["blog","fosa/fosa-ch16"]},"children":["$","$L5",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$L6",null,{"children":["$","$L4",null,{"segmentMap":{"children":[]},"children":["$","$L5",null,{"id":"page:/blog/fosa/fosa-ch16/"}]}]}]}]}]],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:1url7xrgffgzg","deploymentVersion":"42ea885b-ba92-4c44-8068-a1dcfe71a16b","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}
