1:["$","main",null,{"className":"reading-page post-reading-page","children":["$","article",null,{"className":"post-article h-entry","children":[["$","$L7",null,{"className":"u-url sr-only","href":"/blog/fosa/fosa-ch15","children":["FOSA丨15丨空间架构"," 永久链接"]}],["$","a",null,{"className":"p-author h-card sr-only","href":"https://github.com/hedon954","rel":"author","children":"Hedon"}],"$undefined",["$","header",null,{"className":"article-header article-summary-row","children":[["$","p",null,{"className":"eyebrow","children":"架构设计"}],["$","h1",null,{"className":"p-name","children":"FOSA丨15丨空间架构"}],["$","p",null,{"className":"article-deck p-summary","children":"本篇通过回答《Fundamentals of Software Architecture》第十五章的课后思考题，深入探讨空间架构的命名来源与核心特征、虚拟化中间层的组件构成、消息网格与数据读写器的协作机制，以及缓存策略选择、数据冲突管理和架构特性评估分析，帮助理解空间架构的分布式计算原理和高可扩展性设计思路，提升架构师在构建高性能分布式系统时的架构选择能力和空间化设计水平。"}],["$","div",null,{"className":"article-meta","children":[["$","time",null,{"className":"dt-published","dateTime":"2025-07-21T11:02:00.000Z","children":["发布于 ","2025/07/21"]}],"$undefined",["$","span",null,{"children":"$undefined"}],["$","span",null,{"children":["约 ","1,795"," 字"]}]]}]]}],["$","div",null,{"className":"article-reading-layout","children":[["$","div",null,{"className":"article-reading-column","children":[["$","div",null,{"className":"e-content","children":["$","div",null,{"className":"markdown-body","children":[["$","p","p-0",{"children":["本系列文章通过逐章回答",["$","a","a-0",{"href":"https://fundamentalsofsoftwarearchitecture.com/","node":{"type":"element","tagName":"a","properties":{"href":"https://fundamentalsofsoftwarearchitecture.com/"},"children":[{"type":"text","value":"《Fundamentals of Software Architecture》","position":{"start":{"line":1,"column":13,"offset":12},"end":{"line":1,"column":52,"offset":51}}}],"position":{"start":{"line":1,"column":12,"offset":11},"end":{"line":1,"column":102,"offset":101}}},"target":"_blank","rel":"noopener noreferrer","children":"《Fundamentals of Software Architecture》"}],"（下文简称 FOSA）一书中的课后思考题，来深入理解书中的核心概念和理论，从而提升我们的软件架构设计能力。本篇为",["$","u","u-0",{"children":"第十五章"}],"内容。"]}],"\n",["$","p","p-1",{"children":"本章的课后题是："}],"\n",["$","ol","ol-0",{"children":["\n",["$","li","li-0",{"children":["\n",["$","p","p-0",{"children":"Where does space-based architecture get its name from?"}],"\n",["$","p","p-1",{"children":"空间架构的名字从何而来？"}],"\n"]}],"\n",["$","li","li-1",{"children":["\n",["$","p","p-0",{"children":"What is a primary aspect of space-based architecture that differentiates it from other architecture styles?"}],"\n",["$","p","p-1",{"children":"空间架构区别与其他架构的主要方面是什么？"}],"\n"]}],"\n",["$","li","li-2",{"children":["\n",["$","p","p-0",{"children":"Name the four components that make up the virtualized middleware within a space-based architecture."}],"\n",["$","p","p-1",{"children":"说出空间架构的虚拟化中间层的 4 个组成结构。"}],"\n"]}],"\n",["$","li","li-3",{"children":["\n",["$","p","p-0",{"children":"What is the role of the messaging grid?"}],"\n",["$","p","p-1",{"children":"消息网格的作用是什么？"}],"\n"]}],"\n",["$","li","li-4",{"children":["\n",["$","p","p-0",{"children":"What is the role of a data writer in space-based architecture?"}],"\n",["$","p","p-1",{"children":"数据写入器在空间架构中的作用是什么？"}],"\n"]}],"\n",["$","li","li-5",{"children":["\n",["$","p","p-0",{"children":"Under what conditions would a service need to access data through the data reader?"}],"\n",["$","p","p-1",{"children":"一个服务在什么情况下需要通过数据读取器去获取数据？"}],"\n"]}],"\n",["$","li","li-6",{"children":["\n",["$","p","p-0",{"children":"Does a small cache size increase or decrease the chances for a data collision?"}],"\n",["$","p","p-1",{"children":"缓存越小，数据冲突概率是增大还是减小？"}],"\n"]}],"\n",["$","li","li-7",{"children":["\n",["$","p","p-0",{"children":"What is the difference between a replicated cache and a distributed cache? Which one is typically used in space-based architecture?"}],"\n",["$","p","p-1",{"children":"复制缓存和分布式缓存的区别是什么？空间架构更倾向于使用哪个？"}],"\n"]}],"\n",["$","li","li-8",{"children":["\n",["$","p","p-0",{"children":"List three of the most strongly supported architecture characteristics in space- based architecture."}],"\n",["$","p","p-1",{"children":"列出 3 个空间架构中非常优秀的架构特性。"}],"\n"]}],"\n",["$","li","li-9",{"children":["\n",["$","p","p-0",{"children":"Why does testability rate so low for space-based architecture?"}],"\n",["$","p","p-1",{"children":"为什么空间架构的可测性较差？"}],"\n"]}],"\n"]}],"\n",["$","hr","hr-0",{}],"\n",["$","h2","h2-0",{"id":"背景","children":["$","a","a-0",{"href":"#背景","node":{"type":"element","tagName":"a","properties":{"href":"#背景"},"children":[{"type":"text","value":"背景","position":{"start":{"line":40,"column":4,"offset":1293},"end":{"line":40,"column":6,"offset":1295}}}]},"children":"背景"}]}],"\n","$L8","\n","$L9","\n","$La","\n","$Lb","\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c","\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25"]}]}],"$L26","$L27","$L28"]}],"$L29"]}]]}]}]
