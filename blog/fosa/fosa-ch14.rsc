0:{"__route":"route:/blog/fosa/fosa-ch14/","__interceptionContext":null,"__layoutIds":["layout:/"],"__rootLayout":"/","page:/blog/fosa/fosa-ch14/":"$L1","layout:/":[[[["$","link","css:/assets/index-BlvdgL5Z.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-BlvdgL5Z.css","data-rsc-css-href":"/assets/index-BlvdgL5Z.css"}],"$undefined"],["$","html",null,{"lang":"zh-CN","suppressHydrationWarning":true,"children":[["$","head",null,{"children":["$undefined","$undefined"]}],["$","body",null,{"className":"__variable_geist_mono_1diim1n","children":[["$","a",null,{"className":"skip-link","href":"#main-content","children":"跳到正文"}],["$","$L2",null,{"children":["$","$L3",null,{}]}]]}]]}]],null],"route:/blog/fosa/fosa-ch14/":[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"FOSA丨14丨事件驱动架构 · Hedon Garden"}],["$","meta","1",{"name":"description","content":"本篇通过回答《Fundamentals of Software Architecture》第十四章的课后思考题，深入探讨事件驱动架构中代理拓扑与中介者拓扑的设计差异、异步通信的优势机制、请求模式与事件模式的应用场景，以及事件类型分类、消息可靠性保障技术和架构特性支持分析，帮助理解事件驱动架构的核心设计原理和实施策略，提升架构师在构建响应式系统时的架构选择能力和事件化设计水平。"}],["$","meta","2",{"name":"author","content":"Hedon"}],["$","link","3",{"rel":"author","href":"https://github.com/hedon954"}],["$","meta","4",{"name":"robots","content":"index, follow"}],["$","meta","5",{"name":"googlebot","content":"index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}],["$","meta","6",{"property":"og:title","content":"FOSA丨14丨事件驱动架构"}],["$","meta","7",{"property":"og:description","content":"本篇通过回答《Fundamentals of Software Architecture》第十四章的课后思考题，深入探讨事件驱动架构中代理拓扑与中介者拓扑的设计差异、异步通信的优势机制、请求模式与事件模式的应用场景，以及事件类型分类、消息可靠性保障技术和架构特性支持分析，帮助理解事件驱动架构的核心设计原理和实施策略，提升架构师在构建响应式系统时的架构选择能力和事件化设计水平。"}],["$","meta","8",{"property":"og:url","content":"https://hedon.top/blog/fosa/fosa-ch14"}],["$","meta","9",{"property":"og:type","content":"article"}],["$","meta","10",{"property":"article:published_time","content":"2025-07-18T10:30:00.000Z"}],["$","meta","11",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","12",{"name":"twitter:title","content":"FOSA丨14丨事件驱动架构"}],["$","meta","13",{"name":"twitter:description","content":"本篇通过回答《Fundamentals of Software Architecture》第十四章的课后思考题，深入探讨事件驱动架构中代理拓扑与中介者拓扑的设计差异、异步通信的优势机制、请求模式与事件模式的应用场景，以及事件类型分类、消息可靠性保障技术和架构特性支持分析，帮助理解事件驱动架构的核心设计原理和实施策略，提升架构师在构建响应式系统时的架构选择能力和事件化设计水平。"}],["$","meta","14",{"name":"twitter:image","content":"https://hedon.top/og.png"}],["$","link","15",{"rel":"icon","href":"https://hedon.top/favicon.svg"}],["$","link","16",{"rel":"canonical","href":"https://hedon.top/blog/fosa/fosa-ch14"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L4",null,{"segmentMap":{"children":["blog","fosa/fosa-ch14"]},"children":["$","$L5",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$L6",null,{"children":["$","$L4",null,{"segmentMap":{"children":[]},"children":["$","$L5",null,{"id":"page:/blog/fosa/fosa-ch14/"}]}]}]}]}]],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:1url7xrgffgzg","deploymentVersion":"42ea885b-ba92-4c44-8068-a1dcfe71a16b","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}
