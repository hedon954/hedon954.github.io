27:["$","$L2b",null,{"headings":[{"depth":2,"text":"1. 软件架构定义的四个维度","id":"1-软件架构定义的四个维度"},{"depth":3,"text":"1.1 系统结构","id":"11-系统结构"},{"depth":3,"text":"1.2 架构特性","id":"12-架构特性"},{"depth":3,"text":"1.3 架构决策","id":"13-架构决策"},{"depth":3,"text":"1.4 设计原则","id":"14-设计原则"},{"depth":2,"text":"2. 架构决策和设计原则的区别","id":"2-架构决策和设计原则的区别"},{"depth":2,"text":"3. 软件架构师的核心期望","id":"3-软件架构师的核心期望"},{"depth":3,"text":"3.1 八大期望","id":"31-八大期望"},{"depth":3,"text":"3.2 成长指南","id":"32-成长指南"},{"depth":2,"text":"4. 软件架构的第一定律","id":"4-软件架构的第一定律"}]}]
