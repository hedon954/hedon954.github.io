trong","strong-0",{"children":"内存拷贝"}]}],["$","td","td-1",{"children":"用户态 -> 内核态 (Context Switch)"}],["$","td","td-2",{"children":"用户态 -> 内核态"}],["$","td","td-3",{"children":"用户态处理 -> 此时还在用户态 -> 只有最后发 UDP 时进内核"}],["$","td","td-4",{"children":"完全在用户态处理 -> 只有最后发 UDP 时进内核"}]]}]]}]]}]
