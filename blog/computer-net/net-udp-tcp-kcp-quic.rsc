68:["$","p","p-49",{"children":["TCP 需要 3 个重复 ACK 触发快重传。KCP 引入了 ",["$","code","code-0",{"className":"$undefined","children":"fastack"}]," 计数器："]}]
69:["$","ul","ul-16",{"children":["\n",["$","li","li-0",{"children":["当发送端收到一个 ACK，确认了 ",["$","code","code-0",{"className":"$undefined","children":"sn=100"}]," 和 ",["$","code","code-1",{"className":"$undefined","children":"sn=102"}],"，但没有确认 ",["$","code","code-2",{"className":"$undefined","children":"sn=101"}]," 时，",["$","code","code-3",{"className":"$undefined","children":"sn=101"}]," 的 ",["$","code","code-4",{"className":"$undefined","children":"fastack"}]," 计数器加 1。"]}],"\n",["$","li","li-1",{"children":["一旦 ",["$","code","code-0",{"className":"$undefined","children":"fastack"}]," 达到设定阈值（",["$","code","code-1",{"className":"$undefined","children":"resend"}]," 参数，通常设为 2 甚至 1），KCP 不等待 ",["$","code","code-2",{"className":"$undefined","children":"rto"}]," 超时，立即重传 ",["$","code","code-3",{"className":"$undefined","children":"sn=101"}],"。"]}],"\n",["$","li","li-2",{"children":"这使得 KCP 在跨越长肥管道（Long Fat Network）时，能比 TCP 快数倍地感知并恢复丢包。"}],"\n"]}]
