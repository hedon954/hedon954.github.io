b:["$","p","p-5",{"children":["SSE 是 Streamable HTTP 的一种标准化封装，专门用于浏览器端的服务器推送。它规定了特定的 ",["$","code","code-0",{"className":"$undefined","children":"Content-Type: text/event-stream"}]," 和数据格式（",["$","code","code-1",{"className":"$undefined","children":"data: ..."}],"）。"]}]
c:["$","ul","ul-2",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"底层原理："}],"\n",["$","ol","ol-0",{"children":["\n",["$","li","li-0",{"children":"客户端发起 HTTP 请求。"}],"\n",["$","li","li-1",{"children":"服务器挂起连接，不关闭。"}],"\n",["$","li","li-2",{"children":"服务器有数据时，通过该连接直接写入遵循特定格式的文本流。"}],"\n",["$","li","li-3",{"children":["浏览器原生支持 ",["$","code","code-0",{"className":"$undefined","children":"EventSource"}]," API，能自动处理断线重连。"]}],"\n"]}],"\n"]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"与 WebSocket 的本质区别："}]," SSE 依然是 HTTP 协议。它不需要协议升级，防火墙友好，但只能",["$","strong","strong-1",{"children":"服务器 -> 客户端"}]," 单向传输。"]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"适用场景："}]," 股票行情更新、新闻推送、CI/CD 日志流、系统状态监控。"]}],"\n"]}]
