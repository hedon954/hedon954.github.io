",{"children":"管道式 (Pipeline)"}],["$","td","td-3",{"children":"NDJSON / Bytes"}],["$","td","td-4",{"children":[["$","strong","strong-0",{"children":"AI 生成"}],"（ChatGPT）、大文件下载、复杂 RPC。"]}]]}],["$","tr","tr-4",{"children":[["$","td","td-0",{"children":["$","strong","strong-0",{"children":"gRPC"}]}],["$","td","td-1",{"children":[["$","strong","strong-0",{"children":"RPC 框架"}]," (HTTP/2)"]}],["$","td","td-2",{"children":"远程调用 (Function Call)"}],["$","td","td-3",{"children":"Protobuf (二进制)"}],["$","td","td-4",{"children":[["$","strong","strong-0",{"children":"微服务内部通信"}],"（高效、强类型、多语言）。"]}]]}]]}]]}]
