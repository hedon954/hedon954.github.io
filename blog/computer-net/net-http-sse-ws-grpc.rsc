9:["$","ul","ul-1",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"底层原理："}],"\n",["$","ol","ol-0",{"children":["\n",["$","li","li-0",{"children":"客户端发送标准 HTTP 请求。"}],"\n",["$","li","li-1",{"children":["服务器在响应头中声明 ",["$","code","code-0",{"className":"$undefined","children":"Transfer-Encoding: chunked"}],"，并不返回 ",["$","code","code-1",{"className":"$undefined","children":"Content-Length"}],"（因为长度未知）。"]}],"\n",["$","li","li-2",{"children":"服务器通过同一个 TCP 连接，分批次（Chunk）发送数据块。"}],"\n",["$","li","li-3",{"children":"发送一个长度为 0 的块表示传输结束。"}],"\n"]}],"\n"]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"通信模式："}]," 单向流（Server -> Client）。连接保持打开，直到传输完成。"]}],"\n",["$","li","li-2",{"children":[["$","strong","strong-0",{"children":"适用场景："}]," 生成式 AI（LLM）的打字机效果、大文件下载、动态生成的报表。"]}],"\n"]}]
