24:["$","p","p-13",{"children":["博客中澄清了：",["$","strong","strong-0",{"children":["Streamable HTTP 依然可以使用 ",["$","code","code-0",{"className":"$undefined","children":"text/event-stream"}]," 作为数据传输的格式（Framing），但它改变的是传输的载体（Transport）。"]}]]}]
25:["$","ul","ul-8",{"children":["\n",["$","li","li-0",{"children":[["$","strong","strong-0",{"children":"旧 MCP："}]," SSE 是一个",["$","strong","strong-1",{"children":"订阅频道"}],"（Pub/Sub）。"]}],"\n",["$","li","li-1",{"children":[["$","strong","strong-0",{"children":"新 MCP："}]," SSE 只是 POST 响应体里的一种",["$","strong","strong-1",{"children":"编码方式"}],"。"]}],"\n"]}]
26:["$","p","p-14",{"children":["OpenAI 和 Anthropic 现在的做法也是如此：他们不再使用浏览器原生的 ",["$","code","code-0",{"className":"$undefined","children":"EventSource"}],"（那个只能 GET 的订阅 API），而是使用 ",["$","code","code-1",{"className":"$undefined","children":"fetch"}]," POST 请求，然后把响应体当成流来处理。"]}]
