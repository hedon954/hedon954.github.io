17:["$","p","p-8",{"children":["$","a","a-0",{"href":"https://blog.fka.dev/blog/2025-06-06-why-mcp-deprecated-sse-and-go-with-streamable-http/","node":{"type":"element","tagName":"a","properties":{"href":"https://blog.fka.dev/blog/2025-06-06-why-mcp-deprecated-sse-and-go-with-streamable-http/"},"children":[{"type":"text","value":"https://blog.fka.dev/blog/2025-06-06-why-mcp-deprecated-sse-and-go-with-streamable-http/","position":{"start":{"line":103,"column":2,"offset":3661},"end":{"line":103,"column":90,"offset":3749}}}],"position":{"start":{"line":103,"column":1,"offset":3660},"end":{"line":103,"column":181,"offset":3840}}},"target":"_blank","rel":"noopener noreferrer","children":"https://blog.fka.dev/blog/2025-06-06-why-mcp-deprecated-sse-and-go-with-streamable-http/"}]}]
18:["$","blockquote","blockquote-2",{"children":["\n",["$","p","p-0",{"children":["$","span","span-0",{"className":"garden-callout-marker garden-callout-marker--info","aria-hidden":"true"}]}],"\n",["$","p","p-1",{"children":["$","strong","strong-0",{"children":"color=\"orange\" 总结"}]}],"\n",["$","p","p-2",{"children":["$","strong","strong-0",{"children":"废弃 SSE 不是因为它传输文本格式不好，而是因为\"长连接订阅模式\"在复杂的 RPC（远程过程调用）场景下是一种架构错误。"}]}],"\n",["$","p","p-3",{"children":["MCP 从 SSE 转向 Streamable HTTP，本质上是从 ",["$","strong","strong-0",{"children":"异步的消息总线模式"}]," 回归到了",["$","strong","strong-1",{"children":"同步流式的 RPC 模式"}],"。后者更简单、更健壮，也更符合 AI Agent 这种\"一来一回\"的思考特性。"]}],"\n"]}]
