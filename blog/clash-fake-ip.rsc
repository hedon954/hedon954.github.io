e:["$","blockquote","blockquote-0",{"children":["\n",["$","p","p-0",{"children":["$","span","span-0",{"className":"garden-callout-marker garden-callout-marker--warning","aria-hidden":"true"}]}],"\n",["$","p","p-1",{"children":["很多代理软件开启 ",["$","strong","strong-0",{"children":"增强模式 (Fake IP)"}]," 时，会拦截所有 DNS 请求。为了加快速度，它不进行真正的 DNS 查询，而是直接扔给你一个“假的内部 IP”（通常是 ",["$","code","code-0",{"className":"$undefined","children":"198.18.x.x"}],"，但也可以配置成 ",["$","code","code-1",{"className":"$undefined","children":"172.x.x.x"}],"），然后由代理软件接管流量。"]}],"\n",["$","p","p-2",{"children":["又因为大多数 VPN 软件的 Fake IP 逻辑只处理 ",["$","strong","strong-0",{"children":"TCP/UDP 数据流"}],"（用来浏览网页），它并不支持通过 Fake IP 来做 ICMP 路由探测。所以就导致了探测包发出去如泥牛入海，VPN 不回信，真实服务器更收不到（因为根本没发给真实 IP），所以看到的全是 ",["$","code","code-0",{"className":"$undefined","children":"* * *"}],"。"]}],"\n"]}]
