1:["$","main",null,{"className":"reading-page post-reading-page","children":["$","article",null,{"className":"post-article h-entry","children":[["$","$L7",null,{"className":"u-url sr-only","href":"/blog/book-quic-http3","children":["读书笔记丨解密 QUIC/HTTP3：未来互联网的基石"," 永久链接"]}],["$","a",null,{"className":"p-author h-card sr-only","href":"https://github.com/hedon954","rel":"author","children":"Hedon"}],"$undefined",["$","header",null,{"className":"article-header article-summary-row","children":[["$","p",null,{"className":"eyebrow","children":"计算机基础"}],["$","h1",null,{"className":"p-name","children":"读书笔记丨解密 QUIC/HTTP3：未来互联网的基石"}],["$","p",null,{"className":"article-deck p-summary","children":"整理阅读《解密 QUIC/HTTP3：未来互联网的基石》笔记。"}],["$","div",null,{"className":"article-meta","children":[["$","time",null,{"className":"dt-published","dateTime":"2025-01-15T19:17:20.000Z","children":["发布于 ","2025/01/15"]}],"$undefined",["$","span",null,{"children":"$undefined"}],["$","span",null,{"children":["约 ","2,104"," 字"]}]]}]]}],["$","div",null,{"className":"article-reading-layout","children":[["$","div",null,{"className":"article-reading-column","children":[["$","div",null,{"className":"e-content","children":["$","div",null,{"className":"markdown-body","children":[["$","h2","h2-0",{"id":"1-quic-产生背景","children":["$","a","a-0",{"href":"#1-quic-产生背景","node":{"type":"element","tagName":"a","properties":{"href":"#1-quic-产生背景"},"children":[{"type":"text","value":"1. QUIC 产生背景","position":{"start":{"line":1,"column":4,"offset":3},"end":{"line":1,"column":16,"offset":15}}}]},"children":"1. QUIC 产生背景"}]}],"\n",["$","h3","h3-0",{"id":"常见网络协议","children":["$","a","a-0",{"href":"#常见网络协议","node":{"type":"element","tagName":"a","properties":{"href":"#常见网络协议"},"children":[{"type":"text","value":"常见网络协议","position":{"start":{"line":3,"column":5,"offset":21},"end":{"line":3,"column":11,"offset":27}}}]},"children":"常见网络协议"}]}],"\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":["$","code","code-0",{"className":"$undefined","children":"UDP"}]}],"\n",["$","li","li-1",{"children":["$","code","code-0",{"className":"$undefined","children":"TCP"}]}],"\n",["$","li","li-2",{"children":[["$","code","code-0",{"className":"$undefined","children":"SCTP"}],"（Stream Control Transmission Protocol）：用于电话网络。"]}],"\n",["$","li","li-3",{"children":[["$","code","code-0",{"className":"$undefined","children":"KCP"}],"：基于 UDP 在应用层实现可靠性传输，牺牲带宽换取效率。"]}],"\n",["$","li","li-4",{"children":[["$","code","code-0",{"className":"$undefined","children":"RTP"}],"（Real-time Transport Protocol）：与 RTCP 配合传输实时数据，如交互式音频和视频数据。\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":"RTCP：传输控制信息"}],"\n",["$","li","li-1",{"children":"RTP：传输实时数据"}],"\n"]}],"\n"]}],"\n"]}],"\n",["$","h3","h3-1",{"id":"tsl-版本演化","children":["$","a","a-0",{"href":"#tsl-版本演化","node":{"type":"element","tagName":"a","properties":{"href":"#tsl-版本演化"},"children":[{"type":"text","value":"TSL 版本演化","position":{"start":{"line":13,"column":5,"offset":240},"end":{"line":13,"column":13,"offset":248}}}]},"children":"TSL 版本演化"}]}],"\n",["$","ul","ul-1",{"children":["\n",["$","li","li-0",{"children":["\n",["$","p","p-0",{"children":[["$","code","code-0",{"className":"$undefined","children":"SSLv2"}],"：安全性低"]}],"\n"]}],"\n",["$","li","li-1",{"children":["\n",["$","p","p-0",{"children":[["$","code","code-0",{"className":"$undefined","children":"SSLv3"}],"：分为握手阶段和数据传输阶段。"]}],"\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":"握手阶段完成对端点的认证和确定保护数据传输的密钥。"}],"\n",["$","li","li-1",{"children":"一旦确定了密钥，后面的数据传输和 SSL 协议过程都受到加密和完整性保护。"}],"\n"]}],"\n"]}],"\n",["$","li","li-2",{"children":["\n",["$","p","p-0",{"children":[["$","code","code-0",{"className":"$undefined","children":"TSL1.0"}],"：基于 SSLv3，存在 CBC（Cipher Block Chaining，密文分组链接）加密和解密模式漏洞，使得主动攻击者可以观察到当前记录的 IV（Intiallization Vector，初始化向量），猜测一个数据库，进行数据注入。"]}],"\n"]}],"\n",["$","li","li-3",{"children":["\n",["$","p","p-0",{"children":[["$","code","code-0",{"className":"$undefined","children":"TSL1.1"}],"：修复了 TSL1.0 的一些关键安全问题："]}],"\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":"BC 加密使用每条记录一个的显式 IV；"}],"\n",["$","li","li-1",{"children":"为了防止 CBC 填充攻击，使用 bad_record_mac 错误码代替 decryption_failed 回复填充错误；"}],"\n",["$","li","li-2",{"children":"支持传输参数的 IANA（Internet Assigned Numbers Authority，互联网数字分配机构）注册，增加了传输参数的灵活性；"}],"\n",["$","li","li-3",{"children":"改进了连接关闭过早情况下的连接恢复问题。"}],"\n"]}],"\n",["$","p","p-1",{"children":"有些加密算法还是存在安全漏洞，使用的 MD5 也不安全。"}],"\n"]}],"\n",["$","li","li-4",{"children":["\n",["$","p","p-0",{"children":[["$","code","code-0",{"className":"$undefined","children":"TSL1.2"}],"：主要关注了架构灵活性和安全问题。"]}],"\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":["架构：\n",["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":"客户端可以指定自己支持的签名和 hash 算法列表；"}],"\n",["$","li","li-1",{"children":"支持非协议固定的算法；"}],"\n"]}],"\n"]}],"\n",["$","li","li-1",{"children":["安全：\n",["$","ul","ul-0",{"children":["\n","$L8","\n","$L9","\n","$La","\n","$Lb","\n","$Lc","\n"]}],"\n"]}],"\n"]}],"\n"]}],"\n","$Ld","\n"]}],"\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19"]}]}],"$L1a","$L1b","$L1c"]}],"$L1d"]}]]}]}]
