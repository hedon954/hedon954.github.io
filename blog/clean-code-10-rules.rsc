59:["$","$L5c",null,{"headings":[{"depth":2,"text":"规则","id":"规则"},{"depth":3,"text":"1. 使用有意义的变量和函数名称","id":"1-使用有意义的变量和函数名称"},{"depth":3,"text":"2. 保持函数简短且专注","id":"2-保持函数简短且专注"},{"depth":3,"text":"3. 避免深层嵌套","id":"3-避免深层嵌套"},{"depth":3,"text":"4. 明智地使用注释","id":"4-明智地使用注释"},{"depth":3,"text":"5. 保持一致的格式","id":"5-保持一致的格式"},{"depth":3,"text":"6. 不要重复自己（DRY 原则）","id":"6-不要重复自己dry-原则"},{"depth":3,"text":"7. 单一责任原则（SRP）","id":"7-单一责任原则srp"},{"depth":3,"text":"8. 避免魔法数字和字符串","id":"8-避免魔法数字和字符串"},{"depth":3,"text":"9. 编写测试","id":"9-编写测试"},{"depth":3,"text":"10. 保持简单（KISS 原则）","id":"10-保持简单kiss-原则"},{"depth":2,"text":"总结","id":"总结"},{"depth":2,"text":"代码审查清单","id":"代码审查清单"},{"depth":2,"text":"参考","id":"参考"}]}]
