1:["$","main",null,{"className":"reading-page post-reading-page","children":["$","article",null,{"className":"post-article h-entry","children":[["$","$L7",null,{"className":"u-url sr-only","href":"/blog/solution-push-ack","children":["解决方案丨游戏后端中的 Push-ACK 机制设计与内存优化"," 永久链接"]}],["$","a",null,{"className":"p-author h-card sr-only","href":"https://github.com/hedon954","rel":"author","children":"Hedon"}],"$undefined",["$","header",null,{"className":"article-header article-summary-row","children":[["$","p",null,{"className":"eyebrow","children":"解决方案"}],["$","h1",null,{"className":"p-name","children":"解决方案丨游戏后端中的 Push-ACK 机制设计与内存优化"}],["$","p",null,{"className":"article-deck p-summary","children":"本文介绍了游戏后端中的 Push-ACK 机制的设计与实现，特别关注如何避免内存暴涨问题，分享了在多个大型游戏项目中积累的经验与教训。"}],["$","div",null,{"className":"article-meta","children":[["$","time",null,{"className":"dt-published","dateTime":"2025-02-27T20:31:45.000Z","children":["发布于 ","2025/02/27"]}],"$undefined",["$","span",null,{"children":"$undefined"}],["$","span",null,{"children":["约 ","3,021"," 字"]}]]}]]}],["$","div",null,{"className":"article-reading-layout","children":[["$","div",null,{"className":"article-reading-column","children":[["$","div",null,{"className":"e-content","children":["$","div",null,{"className":"markdown-body","children":[["$","h2","h2-0",{"id":"引言","children":["$","a","a-0",{"href":"#引言","node":{"type":"element","tagName":"a","properties":{"href":"#引言"},"children":[{"type":"text","value":"引言","position":{"start":{"line":1,"column":4,"offset":3},"end":{"line":1,"column":6,"offset":5}}}]},"children":"引言"}]}],"\n",["$","p","p-0",{"children":"在现代在线游戏开发中，服务器与客户端之间实时、可靠的通信机制是游戏体验的基石。作为一名游戏后端开发者，我曾经遇到过这样的场景：更新了一个公会系统的新功能，服务器需要向成千上万个在线玩家推送公会状态变更。短短几小时后，服务器内存使用率飙升至 90%，系统告警不断。问题出在哪里？Push 消息的可靠性机制实现不当导致了内存泄漏。"}],"\n",["$","p","p-1",{"children":"本文将深入探讨游戏后端中 Push-ACK 机制的设计与实现，特别关注如何避免内存暴涨问题，分享我在多个大型游戏项目中积累的经验与教训。"}],"\n",["$","h2","h2-1",{"id":"背景为什么需要应用层的-ack-机制","children":["$","a","a-0",{"href":"#背景为什么需要应用层的-ack-机制","node":{"type":"element","tagName":"a","properties":{"href":"#背景为什么需要应用层的-ack-机制"},"children":[{"type":"text","value":"背景：为什么需要应用层的 ACK 机制？","position":{"start":{"line":7,"column":4,"offset":245},"end":{"line":7,"column":24,"offset":265}}}]},"children":"背景：为什么需要应用层的 ACK 机制？"}]}],"\n",["$","p","p-2",{"children":"TCP 协议确实提供了可靠的数据传输保证，包括数据包的序列号、校验和、超时重传等机制。那么，为什么我们还需要在应用层实现额外的 ACK 机制呢？"}],"\n",["$","h3","h3-0",{"id":"tcp-可靠性的边界","children":["$","a","a-0",{"href":"#tcp-可靠性的边界","node":{"type":"element","tagName":"a","properties":{"href":"#tcp-可靠性的边界"},"children":[{"type":"text","value":"TCP 可靠性的边界","position":{"start":{"line":11,"column":5,"offset":345},"end":{"line":11,"column":15,"offset":355}}}]},"children":"TCP 可靠性的边界"}]}],"\n",["$","p","p-3",{"children":["TCP 只能保证",["$","strong","strong-0",{"children":"数据被送达到客户端的网络栈"}],"，但无法保证："]}],"\n",["$","ol","ol-0",{"children":["\n",["$","li","li-0",{"children":"数据被客户端应用程序正确处理"}],"\n",["$","li","li-1",{"children":"处理过程中没有出现异常"}],"\n",["$","li","li-2",{"children":"客户端的业务逻辑正确执行"}],"\n"]}],"\n",["$","p","p-4",{"children":["想象这样一个场景：服务器向玩家推送了一条\"获得稀有装备\"的消息，TCP 确保了数据送达客户端，但如果客户端在处理这个消息时崩溃了呢？对于游戏这类状态敏感的应用，我们需要知道消息是否被",["$","strong","strong-0",{"children":"成功处理"}],"，而不仅仅是",["$","strong","strong-1",{"children":"成功传输"}],"。"]}],"\n",["$","h3","h3-1",{"id":"业务可靠性需求","children":["$","a","a-0",{"href":"#业务可靠性需求","node":{"type":"element","tagName":"a","properties":{"href":"#业务可靠性需求"},"children":[{"type":"text","value":"业务可靠性需求","position":{"start":{"line":21,"column":5,"offset":561},"end":{"line":21,"column":12,"offset":568}}}]},"children":"业务可靠性需求"}]}],"\n",["$","p","p-5",{"children":"实际游戏开发中，不同类型的消息有不同的可靠性需求："}],"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",["$","table","table-0",{"children":[["$","thead","thead-0",{"children":["$","tr","tr-0",{"children":[["$","th","th-0",{"children":"消息类型"}],["$","th","th-1",{"children":"示例"}],["$","th","th-2",{"children":"可靠性需求"}]]}]}],["$","tbody","tbody-0",{"children":[["$","tr","tr-0",{"children":[["$","td","td-0",{"children":"关键状态变更"}],["$","td","td-1",{"children":"道具获取、货币变化"}],["$","td","td-2",{"children":"极高（必须确认处理）"}]]}],["$","tr","tr-1",{"children":[["$","td","td-0",{"children":"游戏进程通知"}],["$","td","td-1",{"children":"任务更新、成就解锁"}],["$","td","td-2",{"children":"高（需要确认）"}]]}],["$","tr","tr-2",{"children":[["$","td","td-0",{"children":"实时位置同步"}],["$","td","td-1",{"children":"玩家位置、NPC 移动"}],["$","td","td-2",{"children":"中（新数据可覆盖旧数据）"}]]}],["$","tr","tr-3",{"children":[["$","td","td-0",{"children":"环境信息"}],["$","td","td-1",{"children":"天气变化、背景音乐"}],["$","td","td-2",{"children":"低（可接受偶尔丢失）"}]]}]]}]]}],"\n",["$","h2","h2-2",{"id":"设计通用的-push-ack-机制","children":["$","a","a-0",{"href":"#设计通用的-push-ack-机制","node":{"type":"element","tagName":"a","properties":{"href":"#设计通用的-push-ack-机制"},"children":[{"type":"text","value":"设计通用的 Push-ACK 机制","position":{"start":{"line":32,"column":4,"offset":885},"end":{"line":32,"column":21,"offset":902}}}]},"children":"设计通用的 Push-ACK 机制"}]}],"\n","$L8","\n","$L9","\n","$La","\n","$Lb","\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c","\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27","\n","$L28","\n","$L29","\n","$L2a","\n","$L2b","\n","$L2c","\n","$L2d","\n","$L2e","\n","$L2f","\n","$L30"]}]}],"$L31","$L32","$L33"]}],"$L34"]}]]}]}]
