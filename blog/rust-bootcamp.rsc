9:["$","$L8","img-1",{"src":"https://hedonspace.oss-cn-beijing.aliyuncs.com/img/image-20241127172804063.png","alt":"Rust 程序设计（第二版）阅读计划","style":{"zoom":"25%"},"node":{"type":"element","tagName":"img","properties":{"src":"https://hedonspace.oss-cn-beijing.aliyuncs.com/img/image-20241127172804063.png","alt":"Rust 程序设计（第二版）阅读计划","style":"zoom: 25%;"},"children":[],"position":{"start":{"line":23,"column":1,"offset":1090},"end":{"line":23,"column":137,"offset":1226}}}}]
