erty":"og:image:alt","content":"ReAct 是更好的故事，Workflow 是更好的系统 的文章封面"}],["$","meta","13",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","14",{"name":"twitter:title","content":"ReAct 是更好的故事，Workflow 是更好的系统"}],["$","meta","15",{"name":"twitter:description","content":"从一次电商 AI Agent 实践出发，聊聊 ReAct Agent、Workflow Agent，以及为什么业务生产系统最终还是要回到确定性。"}],["$","meta","16",{"name":"twitter:image","content":"https://hedon.top/hedonspace/banner/ai-agent-react-vs-workflow.jpg"}],["$","link","17",{"rel":"icon","href":"https://hedon.top/favicon.svg"}],["$","link","18",{"rel":"canonical","href":"https://hedon.top/blog/ai-agent/ai-agent-react-vs-workflow"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L4",null,{"segmentMap":{"children":["blog","ai-agent/ai-agent-react-vs-workflow"]},"children":["$","$L5",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$L6",null,{"children":["$","$L4",null,{"segmentMap":{"children":[]},"children":["$","$L5",null,{"id":"page:/blog/ai-agent/ai-agent-react-vs-workflow/"}]}]}]}]}]],"__layoutFlags":{"layout:/":"s"},"__artifactCompatibility":{"schemaVersion":1,"graphVersion":"app-route-graph:1url7xrgffgzg","deploymentVersion":"42ea885b-ba92-4c44-8068-a1dcfe71a16b","appElementsSchemaVersion":1,"rscPayloadSchemaVersion":1,"rootBoundaryId":"/","renderEpoch":null}}
