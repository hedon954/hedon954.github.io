assName":"xml","children":["$","span","span-0",{"className":"hljs-tag","children":["</",["$","span","span-0",{"className":"hljs-name","children":"relevant_context"}],">"]}]}],"\n\n请遵循",["$","span","span-1",{"className":"hljs-strong","children":"**生成原则**"}],"，根据",["$","span","span-2",{"className":"xml","children":["$","span","span-0",{"className":"hljs-tag","children":["<",["$","span","span-0",{"className":"hljs-name","children":"current_user_input"}],">"]}]}],"和",["$","span","span-3",{"className":"xml","children":["$","span","span-0",{"className":"hljs-tag","children":["<",["$","span","span-0",{"className":"hljs-name","children":"relevant_context"}],">"]}]}],"，从",["$","span","span-4",{"className":"xml","children":["$","span","span-0",{"className":"hljs-tag","children":["<",["$","span","span-0",{"className":"hljs-name","children":"available_action_specs"}],">"]}]}],"中选择 3 个能承接",["$","span","span-5",{"className":"xml","children":["$","span","span-0",{"className":"hljs-tag","children":["<",["$","span","span-0",{"className":"hljs-name","children":"assistant_last_response"}],">"]}]}],"的不同方向，并输出合法的 JSON 结果。\n\n你选择的方向是：\n"]}]]}]}]
50:["$","p","p-46",{"children":["这里建议动态注入的部分，一定要把 ",["$","code","code-0",{"className":"$undefined","children":"AVAILABLE_ACTION_SPECS"}]," 放在最靠近 ",["$","code","code-1",{"className":"$undefined","children":"system prompt"}]," 的地方，因为它的变动频率是比较低的，这样我们可以按照提示词的稳定程度 ",["$","strong","strong-0",{"children":"不变 > 低变化 > 高变化"}],"来组织上下文，从而最大限度利用 KV Cache。"]}]
