173:["$","ol","ol-26",{"children":["\n",["$","li","li-0",{"children":"展示思维链：清晰地展示从问题到第一个思考，再到行动的逻辑。"}],"\n",["$","li","li-1",{"children":"覆盖典型场景：展示如何使用不同的工具，甚至是如何组合使用工具。"}],"\n",["$","li","li-2",{"children":"处理异常情况：最好能包含一个处理错误的示例 (比如搜索不到结果时该怎么办)，这能极大地提升模型的鲁棒性。"}],"\n"]}]
