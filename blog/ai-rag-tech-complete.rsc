21:["$","ol","ol-0",{"children":["\n",["$","li","li-0",{"children":"格式支持广泛：解析 PDF、DOCX、PPTX、HTML、XML、CSV 等格式，甚至支持扫描件中的 OCR 文本提取。"}],"\n",["$","li","li-1",{"children":"元素分区（Partitioning）：将文档拆分为结构化元素（标题、段落、表格、列表），保留原始布局和元数据。"}],"\n",["$","li","li-2",{"children":"数据清洗：自动清理文档中的无关符号、页眉页脚，生成纯净文本。"}],"\n"]}]
