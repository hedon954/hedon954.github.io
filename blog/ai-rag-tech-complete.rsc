ring","children":"\"human\""}],", ",["$","span","span-19",{"className":"hljs-string","children":"\"{input}\""}],"),\n            (",["$","span","span-20",{"className":"hljs-string","children":"\"ai\""}],", ",["$","span","span-21",{"className":"hljs-string","children":"\"{output}\""}],"),\n        ]\n    )\n\n    few_shot_prompt = FewShotChatMessagePromptTemplate(\n        example_prompt=example_prompt,\n        examples=examples,\n    )\n\n    prompt = ChatPromptTemplate.from_messages(\n        [\n            (\n                ",["$","span","span-22",{"className":"hljs-string","children":"\"system\""}],",\n                ",["$","span","span-23",{"className":"hljs-string","children":"\"\"\"你是一名公司员工制度的问答助手，熟悉公司规章制度。\n                你的任务是将输入的问题通过归纳、提炼，转换为关于公司规章制度制定相关的一般性问题，使得问题更容易捕捉问题的意图。\n                请参考下面的例子，按照同样的风格直接返回一个转述后的问题：\"\"\""}],"\n            ),\n            ",["$","span","span-24",{"className":"hljs-comment","children":"# few shot exmaples,"}],"\n            few_shot_prompt,\n            ",["$","span","span-25",{"className":"hljs-comment","children":"# new question"}],"\n            (",["$","span","span-26",{"className":"hljs-string","children":"\"user\""}],", ",["$","span","span-27",{"className":"hljs-string","children":"\"{question}\""}],")\n        ]\n    )\n\n    question_gen = prompt | llm | StrOutputParser()\n    res = question_gen.invoke({",["$","span","span-28",{"className":"hljs-string","children":"\"question\""}],": query}).removeprefix(",["$","span","span-29",{"className":"hljs-string","children":"\"AI: \""}],")\n    ",["$","span","span-30",{"className":"hljs-keyword","children":"return"}]," res\n"]}]}]
