e:["$","ul","ul-0",{"children":["\n",["$","li","li-0",{"children":["Go 将堆内存抽象为 ",["$","strong","strong-0",{"children":"mheap"}]," 结构体；"]}],"\n",["$","li","li-1",{"children":["Go 进程会从虚拟内存中申请 n 个 ",["$","strong","strong-0",{"children":"heapArena"}],"（64 位系统每个 64MB）；"]}],"\n",["$","li","li-2",{"children":["每个 heapArena 被按需划分成不同 class 的 ",["$","strong","strong-0",{"children":"mspan"}],"，共有",["$","strong","strong-1",{"children":"68"}]," 个 size class；"]}],"\n",["$","li","li-3",{"children":"每个 mspan 由 n 个相同大小的 span 组成；"}],"\n",["$","li","li-4",{"children":["为了快速定位合适的 span，为 mheap 建立了 ",["$","strong","strong-0",{"children":"136"}]," 个中央索引",["$","strong","strong-1",{"children":"mcentral"}],"；"]}],"\n",["$","li","li-5",{"children":"每个 mcentral 存储对应 class 的 mspan，每种 mspan 又划分为 gc scan 和 no scan 两种，故共有 68 × 2 = 136 个 mcentral；"}],"\n",["$","li","li-6",{"children":["为了解决中央索引的并发锁竞争问题，为每一个 P（线程）建立一个本地缓存 ",["$","strong","strong-0",{"children":"mcache"}],"；"]}],"\n",["$","li","li-7",{"children":["每个 mcache 存储 ",["$","strong","strong-0",{"children":"136"}]," 个 span，分别是每种 class 的 mspan 的一个 scan 和 noscan 的 span。"]}],"\n"]}]
