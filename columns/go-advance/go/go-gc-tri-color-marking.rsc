1d:["$","blockquote","blockquote-1",{"children":["\n",["$","p","p-0",{"children":"Go 使用的就是标记清除法"}],"\n",["$","p","p-1",{"children":["虽然普通的标记清除法会造成内存碎片的问题，但是由于 Go 的内存模型中，将内存天然划分成多个 span，所以不存在内存碎片问题。故 Go 用了这种实现简单的标记清除法。对于 Go 内存模型不熟悉的读者，可参阅：",["$","a","a-0",{"href":"https://hedon.top/2025/11/17/go/go-memory-model/","node":{"type":"element","tagName":"a","properties":{"href":"https://hedon.top/2025/11/17/go/go-memory-model/"},"children":[{"type":"text","value":"Go 底层原理丨内存模型","position":{"start":{"line":58,"column":109,"offset":1806},"end":{"line":58,"column":121,"offset":1818}}}],"position":{"start":{"line":58,"column":108,"offset":1805},"end":{"line":58,"column":172,"offset":1869}}},"target":"_blank","rel":"noopener noreferrer","children":"Go 底层原理丨内存模型"}],"。"]}],"\n"]}]
