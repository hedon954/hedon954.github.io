38:["$","pre","pre-1",{"data-language":"SHELL","children":["$","code","code-0",{"className":"hljs language-shell","children":[["$","span","span-0",{"className":"hljs-meta prompt_","children":"#"}],["$","span","span-1",{"className":"bash","children":"!/bin/bash"}],"\nexport GOTOOLCHAIN=auto\n",["$","span","span-2",{"className":"hljs-meta prompt_","children":"\n# "}],["$","span","span-3",{"className":"bash","children":"获取当前改动的 Go 文件"}],"\nchanged_files=$(git diff --name-only --cached --diff-filter=d | grep '\\.go$')\n",["$","span","span-4",{"className":"hljs-meta prompt_","children":"\n# "}],["$","span","span-5",{"className":"bash","children":"如果没有改动的 Go 文件，退出"}],"\nif [ -z \"$changed_files\" ]; then\n    echo \"No Go files changed.\"\n    exit 0\nfi\n",["$","span","span-6",{"className":"hljs-meta prompt_","children":"\n# "}],["$","span","span-7",{"className":"bash","children":"提取改动文件所在的包路径（使用相对路径），并排除 vendor 目录"}],"\ntest_dirs=$(echo \"$changed_files\" | xargs -n1 dirname | grep -v '^vendor' | sort -u)\n",["$","span","span-8",{"className":"hljs-meta prompt_","children":"\n# "}],["$","span","span-9",{"className":"bash","children":["对每个改动的包路径运行 go ",["$","span","span-0",{"className":"hljs-built_in","children":"test"}]]}],"\nfor dir in $test_dirs; do\n    # 检查目录是否存在\n    if [ ! -d \"$dir\" ]; then\n        echo \"Directory $dir does not exist. Skipping...\"\n        continue\n    fi\n\n    # 检查是否存在 go.mod 文件，确保在 Go 模块路径中\n    if [ -f \"$dir/go.mod\" ] || [ -f \"./go.mod\" ]; then\n        echo \"Running tests in $dir...\"\n        (cd \"$dir\" && go test -mod=vendor -gcflags=all=-l -short ./...)\n        if [ $? -ne 0 ]; then\n            echo \"Tests failed in $dir\"\n            exit 1\n        fi\n    else\n        echo \"Skipping $dir (no go.mod found)\"\n    fi\ndone\n\necho \"All tests passed.\"\n"]}]}]
