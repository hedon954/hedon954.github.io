en":2}],["$","strong",null,{"children":"做一件事"}],["$","p",null,{"children":"写随想、上传、置顶，或发到别处。"}]]}],["$","li","写回仓库",{"children":[["$","span",null,{"children":3}],["$","strong",null,{"children":"写回仓库"}],["$","p",null,{"children":"后台把改动提交到你的内容仓库。"}]]}],["$","li","网站更新",{"children":[["$","span",null,{"children":4}],["$","strong",null,{"children":"网站更新"}],["$","p",null,{"children":"main 变了之后，页面会重新发布。"}]]}]]}],["$","div",null,{"className":"garden-admin-enable","children":[["$","div",null,{"children":[["$","h3",null,{"children":"想用后台，再单独部署一份"}],["$","ol",null,{"children":[["$","li",null,{"children":"把同一份 Garden 部署到 Node、Docker 或 Cloudflare Workers。"}],["$","li",null,{"children":"配好 GitHub 登录、允许的账号，以及只能改内容仓库的令牌。"}],["$","li",null,{"children":"要上传附件或转发到其他网站时，再配存储和各平台接口。"}]]}]]}],["$","pre",null,{"aria-label":"后台需要的环境变量","children":["$","code",null,{"children":"ADMIN_URL=https://admin.example.com\nCONTENT_REPOSITORY=owner/repository\nCONTENT_BRANCH=main\nADMIN_GITHUB_LOGINS=your-github-login\n\n# 令牌只放在后台服务里\nCONTENT_GITHUB_TOKEN=github_pat_xxx\nGITHUB_OAUTH_CLIENT_ID=Ov23li_xxx"}]}]]}]]}]
